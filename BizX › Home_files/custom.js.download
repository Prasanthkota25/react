function bindThemeOnLoad(siteURL) {
    var linkHref = siteURL + "/dist/assets/css/";
    if (localStorage.getItem("currentTheme")) {
        linkHref = linkHref + localStorage.getItem("currentTheme") + ".css";
    } else {
        linkHref = linkHref + "StyleSheet.css";
    }
    document.getElementById("linkstylesheet").setAttribute("href", linkHref);
    //hideDevTool(siteURL);
}
function bindSiteURLToRedirectFromChildSite() {
    var pathname = location.pathname.split('/');
    if (pathname.length > 0) {
        pathname = pathname[1];
    }
    localStorage.setItem("siteURL", location.origin + '/' + pathname);
    localStorage.setItem("redirectSiteURL", location.origin);
}

function hideInFirefox() {
    let userAgentString = navigator.userAgent;
    // Detect Firefox
    let firefoxAgent = userAgentString.indexOf("Firefox") > -1;
    if (firefoxAgent) {
        confirm("Please Use Edge or Chrome for best view of BizX. Access using Firefox is temporarily disabled.")
        location.reload();
    }
}

