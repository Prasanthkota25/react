r: #fff;\r\n    text-transform: uppercase;\r\n    padding: 2px 0px 2px 11px;\r\n    font-size: 14px;\r\n}\r\n.ts-container td.colwidth p.viewTsDetails-p {\r\n    margin: 0;\r\n}\r\n::ng-deep my-date-picker .mydp .selectorarrow {\r\n    right: 2%;\r\n}\r\n::ng-deep my-date-picker .mydp .selectorarrowleft:after, ::ng-deep  my-date-picker .mydp .selectorarrowleft:before {\r\n    left: 91%;\r\n}\r\n.acknlg {\r\n    font-size: 11px;\r\n    color: #756e6e;\r\n}\r\n.remark_area {\r\n    text-align: justify;\r\n    padding: 6px 18px;\r\n    color: #827c7c;\r\n    font-size: 11px;\r\n    display: inline-block;\r\n    width: 68%;\r\n}\r\n.fileUpload {\r\n    display: inline-block;\r\n    width: 30%;\r\n}\r\n.sub-head-inner-3 {\r\n    display: inline-block;\r\n    float: right;\r\n}\r\n.ts-container{\r\n    font-size:11px;\r\n}\r\n.col-md-12.imgModule img {\r\n    width: 30%;\r\n}\r\n.labelModule label {\r\n    font-weight: normal;\r\n    font-size: 11px;\r\n}\r\n.remrkField textarea.mat-input-element {\r\n    overflow-x: hidden;\r\n}",""])},function(e,t){e.exports='<div>\r\n    <h2 mat-dialog-title class="Mdle-dialog-title">Select Modules <button mat-icon-button class="closeIcon" mat-button (click)="onNoClick()"><i class="fa fa-times" aria-hidden="true"></i></button></h2>\r\n</div>\r\n<hr class="hrPopUp" />\r\n\r\n<div class="row SelectModules">\r\n    <div class="col-md-12">\r\n        <div *ngFor="let am of activeModules; let i = index">\r\n            <div *ngIf="am.moduleName != \'Raise Hand\'" class="col-md-4 gridModule grad grid-{{i+1}}">\r\n                <div class="border-top icn-div">\r\n                    <div class="col-md-12 imgModule">\r\n                        <ng-container *ngIf="currentTheme == \'StyleSheet\'">\r\n                            <img src="{{this._bizxrooturi.bindBaseURL() + \'/dist/assets/images/module_images/purplewhite/\' + am.moduleName}}.png" />\r\n                        </ng-container>\r\n                        <ng-container *ngIf="currentTheme == \'StyleSheet-blue\'">\r\n                            <img src="{{this._bizxrooturi.bindBaseURL() + \'/dist/assets/images/module_images/purplewhite/\' + am.moduleName}}.png" />\r\n                        </ng-container>\r\n                        <ng-container *ngIf="currentTheme == \'StyleSheet-darkBlue\'">\r\n                            <img src="{{this._bizxrooturi.bindBaseURL() + \'/dist/assets/images/module_images/purple/\' + am.moduleName}}.png" />\r\n                        </ng-container>\r\n                    </div>\r\n                    <div class="col-md-12 contentModule">\r\n                        <div class="checkboxModule">\r\n                            <mat-checkbox class="example-margin" [disabled]="am.moduleName == \'TimeSheet\'"\r\n                                          [matTooltipDisabled]="am.moduleName != \'TimeSheet\'"\r\n                                          matTooltip="You cannot uncheck/hide timesheet"\r\n                                          (change)="updateDashboardModule(am.id, $event.checked)"\r\n                                          [(ngModel)]="am.isActive"></mat-checkbox>\r\n                        </div>\r\n                        <div class="labelModule">\r\n                            <label>{{am.moduleName}}</label>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    \x3c!--<h4 *ngIf="isLoading" style="text-align: center;">You cannot uncheck/hide timesheet.</h4>--\x3e\r\n</div>\r\n\r\n'},function(e,t){e.exports='\r\n<div class="ts-head">\r\n    <h4 mat-dialog-title>TimeSheet Details<button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn"><i class="fa fa-times" aria-hidden="true"></i>&nbsp;</button></h4>\r\n\r\n    <div class="ts-container">\r\n        <div class="sub-head-inner">\r\n            <div class="sub-head-inner-1"><span class="lebelempName">Employee No </span>   <span class="empName">{{EmployeeDetails.employeeNo}}</span></div>\r\n            <div class="sub-head-inner-2">  <span class="lebelempName">Employee Name </span><span class="empName">{{EmployeeDetails.employeeName}}</span></div>\r\n        </div>\r\n            <table class="table" *ngIf="TimesheetdetailObj?.length > 0">\r\n                <thead class="tbleHeadBg">\r\n                    <tr>\r\n                        <th>Project </th>\r\n                        <th>Task </th>\r\n                        <th>Activity</th>\r\n                        <th class="dateAndDay"><span class="weekdays">Mon</span><span class="timesheet-list-header-day">{{this._timesheetService.getFormattedDate(TimesheetdetailObj["0"].workDay["0"])}}</span></th>\r\n                        <th class="dateAndDay"><span class="weekdays">Tue</span><span class="timesheet-list-header-day">{{this._timesheetService.getFormattedDate(TimesheetdetailObj["0"].workDay["1"])}}</span></th>\r\n                        <th class="dateAndDay"><span class="weekdays">Wed</span><span class="timesheet-list-header-day">{{this._timesheetService.getFormattedDate(TimesheetdetailObj["0"].workDay["2"])}}</span></th>\r\n                        <th class="dateAndDay"><span class="weekdays">Thu</span><span class="timesheet-list-header-day">{{this._timesheetService.getFormattedDate(TimesheetdetailObj["0"].workDay["3"])}}</span></th>\r\n                        <th class="dateAndDay"><span class="weekdays">Fri</span><span class="timesheet-list-header-day">{{this._timesheetService.getFormattedDate(TimesheetdetailObj["0"].workDay["4"])}}</span></th>\r\n                        <th class="dateAndDay"><span class="weekdays">Sat</span><span class="timesheet-list-header-day">{{this._timesheetService.getFormattedDate(TimesheetdetailObj["0"].workDay["5"])}}</span></th>\r\n                        <th class="dateAndDay"><span class="weekdays">Sun</span><span class="timesheet-list-header-day">{{this._timesheetService.getFormattedDate(TimesheetdetailObj["0"].workDay["6"])}}</span></th>\r\n                        <th class="dateAndDay">Total Hours</th>\r\n                    </tr>\r\n                    <tr>\r\n                        <th class="dateAndDay"><span class="weekdays"></span><span class="timesheet-list-header-day"></span></th>\r\n                        <th class="dateAndDay"><span class="weekdays"></span><span class="timesheet-list-header-day"></span></th>\r\n                        <th class="dateAndDay"><span class="weekdays"></span><span class="timesheet-list-header-day"></span></th>\r\n                        <th class="dateAndDay"><span class="timesheet-list-header-day">{{TimesheetdetailObj["0"].timesheetCategoryName["0"]}}</span></th>\r\n                        <th class="dateAndDay"><span class="timesheet-list-header-day">{{TimesheetdetailObj["0"].timesheetCategoryName["1"]}}</span></th>\r\n                        <th class="dateAndDay"><span class="timesheet-list-header-day">{{TimesheetdetailObj["0"].timesheetCategoryName["2"]}}</span></th>\r\n                        <th class="dateAndDay"><span class="timesheet-list-header-day">{{TimesheetdetailObj["0"].timesheetCategoryName["3"]}}</span></th>\r\n                        <th class="dateAndDay"><span class="timesheet-list-header-day">{{TimesheetdetailObj["0"].timesheetCategoryName["4"]}}</span></th>\r\n                        <th class="dateAndDay"><span class="timesheet-list-header-day">{{TimesheetdetailObj["0"].timesheetCategoryName["5"]}}</span></th>\r\n                        <th class="dateAndDay"><span class="timesheet-list-header-day">{{TimesheetdetailObj["0"].timesheetCategoryName["6"]}}</span></th>\r\n                        <th class="dateAndDay"><span class="weekdays"></span><span class="timesheet-list-header-day"></span></th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    <tr *ngFor="let tm of TimesheetdetailObj">\r\n                        <td>{{getProjectName(tm.projectMasterId)}}</td>\r\n                        <td>{{tm.taskName}}</td>\r\n                        <td>{{tm.subTaskName}}</td>\r\n                        <td class="colwidth" *ngFor="let wh of tm.workHours;let i = index">\r\n                            {{wh}}\r\n                            <br />\r\n                            {{tm.remarks[i]}}\r\n                        </td>\r\n                        <td class="colwidth">\r\n                            <p class="viewTsDetails-p">\r\n                                {{this._timesheetService.calcTotalHoursByTimesheetProject(tm)| number:\'2.2-2\'}}\r\n                            </p>\r\n                        </td>\r\n                    </tr>\r\n                    <tr class="totaltd">\r\n                        <td>\r\n                            <strong>Total</strong>\r\n                        </td>\r\n                        <td></td>\r\n                        <td></td>\r\n                        <td class="hours" *ngFor="let day of [0,1,2,3,4,5,6]" style="text-align:center">\r\n                            <p>\r\n                                {{this._timesheetService.calcTotalHoursByDay(day,TimesheetdetailObj)| number:\'2.2-2\'}}\r\n                            </p>\r\n                        </td>\r\n                        <td class="hours" style="text-align:center">\r\n                            <p>\r\n                                {{this._timesheetService.calcTotalHours(TimesheetdetailObj)| number:\'2.2-2\'}}\r\n                            </p>\r\n                        </td>\r\n                    </tr>\r\n                </tbody>\r\n            </table>\r\n\r\n        </div>\r\n</div>\r\n<div class="loading-shade" *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults">\r\n\r\n    </mat-spinner>\r\n</div>\r\n'},function(e,t){e.exports='<style>\r\n    .row.srDetailsArea .col-sm-12.col-md-3, .row.srDetailsArea .col-sm-12.col-md-1 {\r\n        /*width: 20%;*/\r\n        font-size: 11px;\r\n        padding: 0;\r\n    }\r\n\r\n    .srDetailsBlocks p {\r\n        font-size: 11px;\r\n    }\r\n\r\n    .close-btn {\r\n        padding: 4px;\r\n        height: 32px;\r\n        line-height: 1;\r\n        font-size: 11px;\r\n    }\r\n\r\n    .col-md-10 p {\r\n        text-align: justify;\r\n    }\r\n\r\n    .col-md-11 p {\r\n        padding-left: 12px;\r\n    }\r\n</style>\r\n\r\n<h4 mat-dialog-title>\r\n    Payout Information\r\n\r\n    <button mat-button [mat-dialog-close]="true" class="btnIcon CloseBtn" matTooltip="Close"  style="min-width: 12px;height: 23px;float: right;line-height: 12px;background: #ffce75;padding: 5px;"><i class="fa fa-times" aria-hidden="true"></i></button>\r\n</h4>\r\n    <mat-dialog-content class="mat-typography">\r\n        <div class="srDetailsBlocks">\r\n\r\n            <div class="Approval-information">\r\n                <h4>Employee Payout Details</h4>\r\n                <table class="itemRows-tble">\r\n                    <tr>\r\n                        <th>Employee Name</th>\r\n                        <th>Employee No</th>\r\n                        <th>Type</th>\r\n                        <th>Sub Type</th>\r\n                        <th>Amount</th>\r\n                        <th>Action</th>\r\n                    </tr>\r\n                    <tr *ngFor="let element of PayoutPopupData;let i=index">\r\n                        <td>\r\n                            <span class="row-item-val">{{element.FullName}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <span class="row-item-val">{{element.EmployeeNo}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <span class="row-item-val">{{element.Type}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <span class="row-item-val">{{element.SubType}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <span class="row-item-val">{{element.Amount}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <button class="btnIcon" mat-icon-button type="button" *ngIf="PayoutPopupData.length>1 && popupTableStatus==1" (click)="deletetLineItemDetail(element,\'Delete\')" matTooltip="Delete">\r\n                                <i class="fa fa-trash-o" aria-hidden="true"></i>\r\n                            </button>\r\n                        </td>\r\n                    </tr>\r\n\r\n                </table>\r\n            </div>\r\n            <br />\r\n            <div class="Approval-information">\r\n                <h4>Attachment information</h4>\r\n                <table class="itemRows-tble">\r\n                    <tr>\r\n                        <th>S no.</th>\r\n                        <th>Attachment Name</th>\r\n                        <th>Action</th>\r\n\r\n                    </tr>\r\n                    <tr *ngFor="let element of popupPayoutAttachmentData;let i=index">\r\n\r\n                        <td>\r\n                            <span class="row-item-val">{{i+1}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <span class="row-item-val">{{element.Filename}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <button mat-icon-button class="smlBtn" (click)="payoutattachmentdownload(element.TimesheetPayoutMasterAttachmentMasterId,element.Filename)">\r\n                                <i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;\r\n                            </button>\r\n                        </td>\r\n\r\n                    </tr>\r\n\r\n                    <tr *ngIf="!popupPayoutAttachmentData?.length">\r\n                        <td></td>\r\n                        <td>\r\n                            <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                        </td>\r\n                        <td></td>\r\n                    </tr>\r\n\r\n                </table>\r\n            </div>\r\n\r\n\r\n\r\n        </div>\r\n\r\n    </mat-dialog-content>\r\n\r\n    <mat-dialog-actions align="end">\r\n        <button mat-button mat-dialog-close class="close-btn org-btn" [mat-dialog-close]="IsDataChange">Submit</button>\r\n    </mat-dialog-actions>\r\n    <div class="loading-shade"\r\n         *ngIf="isLoadingResults">\r\n        <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n    </div>\r\n'},function(e,t){e.exports='<style>\r\n\r\n    .list-table-header {\r\n        background-color: rgb(225 225 225);\r\n        border-bottom: 1px solid black;\r\n        \r\n    }\r\n\r\n    table.th.td {\r\n        border: 1px solid black;\r\n        border-color: inherit;\r\n        border-style: solid;\r\n        border-width: 0;\r\n    }\r\n    \r\n\r\n    .week-date {\r\n        color: #0086CB;\r\n    }\r\n\r\n    .timesheet-container {\r\n        background-color: #fff;\r\n        border-radius: 5px;\r\n        font-size: 11px;\r\n    }\r\n\r\n    .timesheet-header {\r\n        display: flex;\r\n        justify-content: space-between;\r\n        align-items: center;\r\n    }\r\n\r\n    .timesheet-headers1 button.clse_btn {\r\n        background: none !important;\r\n        min-width: 8px;\r\n        padding: 0;\r\n        line-height: 10px;\r\n        margin: 0;\r\n        height: 10px;\r\n        /* font-size: 2em; */\r\n        margin: 7px;\r\n        float: right;\r\n        border: none;\r\n    }\r\n\r\n    h3.heading.viewTS {\r\n        padding: 10px 11px;\r\n        text-transform: uppercase;\r\n        background: #84c4f1;\r\n        margin: 0;\r\n    }\r\n\r\n    .timesheet-headers1 button.clse_btn mat-icon {\r\n        font-size: 2em;\r\n        height: 25px;\r\n        width: 27px;\r\n        margin: 0;\r\n    }\r\n    .header-text {\r\n        display: flex;\r\n        flex-direction: column;\r\n        text-align: center;\r\n    }\r\n    table.viewTStable td {\r\n        padding: 6px 8px;\r\n        /*text-align: center;*/\r\n        border-bottom: 1px solid black;\r\n    }\r\n   .bold-text {\r\n        font-weight: bold;\r\n   }\r\n    .timesheet-container table td p {\r\n        background: rgb(225 225 225);\r\n        margin: 0;\r\n        padding: 12px 8px;\r\n    }\r\n    h4.SubHeadPopUP {\r\n        background: #0086CB;\r\n        padding: 12px;\r\n        color: #000000;\r\n        font-weight: bold;\r\n        text-transform: uppercase;\r\n    }\r\n    .timesheet-container input::-webkit-outer-spin-button,\r\n    .timesheet-container input::-webkit-inner-spin-button {\r\n        -webkit-appearance: none;\r\n        margin: 0;\r\n    }\r\n\r\n    /* Firefox */\r\n    .timesheet-container input[type=number] {\r\n        -moz-appearance: textfield;\r\n    }\r\n    button.tsViewCloseBtn {\r\n        min-width: 2px;\r\n        /* line-height: 0;*/\r\n        /*position: absolute;\r\n        right: 0;\r\n        top: 3px;*/\r\n        position: relative;\r\n        bottom: 8px;\r\n        float: right;\r\n    }\r\n   \r\n    .table-subheader {\r\n        display: flex;\r\n        flex-direction: column;\r\n    }\r\n   \r\n    h4.SubHeadPopUP {\r\n        margin: 0;\r\n    }\r\n\r\n    .workHours2 {\r\n        background-color: #BCCDF5;\r\n        text-align: center;\r\n        padding: 9px;\r\n        height: 36px;\r\n        border-radius: 5px;\r\n        margin-left: 5px;\r\n    }\r\n\r\n    .workHours3 {\r\n        background-color: #26887C;\r\n        text-align: center;\r\n        padding: 9px;\r\n        height: 36px;\r\n        border-radius: 5px;\r\n        margin-left: 5px;\r\n        color: white;\r\n    }\r\n\r\n    .workHoursEffort {\r\n        display: flex;\r\n        margin: 20px 0px 20px 0px;\r\n    }\r\n\r\n    .hours-table {\r\n        width: 100%;\r\n        text-align: center;\r\n    }\r\n\r\n        .hours-table th {\r\n            border-right: 1px solid white;\r\n            border-bottom: 1px solid #bcbcbc;\r\n        }\r\n\r\n            .hours-table th:last-child {\r\n                border-right: none;\r\n            }\r\n\r\n        .hours-table td {\r\n            border-right: 1px solid #878787;\r\n            border-bottom: 1px solid #878787;\r\n        }\r\n\r\n            .hours-table td:last-child {\r\n                border-right: none;\r\n            }\r\n\r\n        .hours-table tr {\r\n            height: 35px;\r\n        }\r\n\r\n    .works-hour {\r\n        background-color: #BCCDF5;\r\n    }\r\n\r\n    .break-hour {\r\n        background-color: #FAC3B8;\r\n    }\r\n\r\n    .total-hour {\r\n        background-color: #26887C;\r\n        color: white;\r\n    }\r\n\r\n    .hourTable {\r\n        border: 1.5px solid #102D70;\r\n        border-radius: 4px;\r\n        margin-top: 15px;\r\n    }\r\n</style>\r\n<div class="timesheet-container">\r\n    <div class="timesheet-headers1">\r\n        <h4 class="SubHeadPopUP" style="color: white;">Timesheet Details<button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn"><i class="fa fa-remove" aria-hidden="true"></i>&nbsp;</button></h4>\r\n    </div>\r\n    <table class="viewTStable" style="width: 100%;">\r\n        <thead class="list-table-header">\r\n            <tr>\r\n                <th style="width: 30%;"><span style="text-align: left; padding: 0px 10px;">Project / Category</span></th>\r\n                <th><span class="header-text">Sat</span><span class="week-date">{{weekTray.sat | date:\'MMM dd, yyy\':\'+530\'}}</span></th>\r\n                <th><span class="header-text">Sun</span><span class="week-date">{{weekTray.sun | date:\'MMM dd, yyy\':\'+530\'}}</span></th>\r\n                <th><span class="header-text">Mon</span><span class="week-date">{{weekTray.mon | date:\'MMM dd, yyy\':\'+530\'}}</span></th>\r\n                <th><span class="header-text">Tue</span><span class="week-date">{{weekTray.tue | date:\'MMM dd, yyy\':\'+530\'}}</span></th>\r\n                <th><span class="header-text">Wed</span><span class="week-date">{{weekTray.wed | date:\'MMM dd, yyy\':\'+530\'}}</span></th>\r\n                <th><span class="header-text">Thu</span><span class="week-date">{{weekTray.thu | date:\'MMM dd, yyy\':\'+530\'}}</span></th>\r\n                <th><span class="header-text">Fri</span><span class="week-date">{{weekTray.fri | date:\'MMM dd, yyy\':\'+530\'}}</span></th>\r\n                <th style="text-align:center;"><span class="header-text">Total</span><span> Worked Hours</span></th>\r\n                \x3c!--<th>Action</th>--\x3e\r\n            </tr>\r\n        </thead>\r\n\r\n        <tr *ngFor="let tm of timesheetMaster.timesheetDetailV2">\r\n\r\n            <td *ngIf="tm.workCategoryName ==\'Worked\'">\r\n                <span style="padding: 2px;">{{tm.projectname}} / {{tm.workCategoryName}}</span>\r\n            </td>\r\n            \r\n            <td *ngIf="tm.workCategoryName != \'Worked\' && tm.workCategoryName != \'Meal Break\' && tm.workCategoryName != \'Rest Break\'">\r\n                <span>{{tm.workCategoryName == \'Premium Hour\' ? \'Premium Hours\' : tm.workCategoryName}} </span>\r\n            </td>\r\n            <td *ngIf="tm.workCategoryName == \'Meal Break\' || tm.workCategoryName == \'Rest Break\'">\r\n                <span>{{tm.workCategoryName}} {{tm.indexvalue}}  </span>\r\n            </td>\r\n            <td class="timesheet-table" *ngFor="let day of [0,1,2,3,4,5,6]" style="text-align: center;">\r\n\r\n                <span style="padding: 2px;" [ngStyle]="{\'background-color\': tm.workHours[day] > 0 ? \'#a7e6ff\' : \'white\'}">{{tm.workHours[day] | number:\'1.2-2\'}} </span>\r\n\r\n            </td>\r\n\r\n            <td class="bold-text timesheet-table" style="text-align: center;">\r\n\r\n                {{calcTotalHoursByTimesheetProjectColumnwise(tm)  | number:\'1.2-2\'}}\r\n\r\n            </td>\r\n\r\n        </tr>\r\n        <tr class="totaltd">\r\n            <td class="bold-text timesheet-table" style="padding-left: 10px;">\r\n                Total  Worked Hours\r\n            </td>\r\n            <td class="bold-text timesheet-table" style="text-align: center;" *ngFor="let day of [0,1,2,3,4,5,6]">\r\n                {{calcTotalHoursByDay(day,true,false)  | number:\'1.2-2\'}}\r\n\r\n            </td>\r\n            <td class="bold-text timesheet-table" style="text-align: center;">\r\n                {{calcTotalHours()  | number:\'1.2-2\'}}\r\n\r\n            </td>\r\n            \x3c!--<td></td>--\x3e\r\n        </tr>\r\n\r\n\r\n\r\n    </table>\r\n    \r\n    <div class="hourTable" [ngStyle]="{\'width\': californiaemp  ? \'100%\': tmsentitysname == \'US\'? \'70%\' : \'40%\'}">\r\n        <table class="hours-table">\r\n            <tr>\r\n                <th class="works-hour">Total Worked Hours</th>\r\n                <th class="works-hour">Total Non-Worked Hours</th>\r\n                <th class="works-hour" *ngIf="californiaemp">Total Premium Hours</th>\r\n                <th class="works-hour" *ngIf="tmsentitysname == \'US\'">Total ST Hours</th>\r\n                <th class="works-hour" *ngIf="tmsentitysname == \'US\'">Total OT Hours</th>\r\n                <th class="works-hour" *ngIf="tmsentitysname == \'US\'">Total Double OT Hours</th>\r\n                <th class="break-hour" *ngIf="californiaemp">Total Rest Break Hours</th>\r\n                <th class="break-hour" *ngIf="californiaemp">Total Meal Break Hours</th>\r\n                <th class="total-hour">Total Hours</th>\r\n            </tr>\r\n            <tr>\r\n                <td>{{calcTotalHours()  | number:\'1.2-2\'}}</td>\r\n                <td>{{calcTotalnonworkHours()  | number:\'1.2-2\'}}</td>\r\n                <td *ngIf="californiaemp">{{calcTotalHoursPremium()  | number:\'1.2-2\'}}</td>\r\n                <td *ngIf="tmsentitysname == \'US\'">{{timesheetpayrolldata.totalST  | number:\'1.2-2\'}}</td>\r\n                <td *ngIf="tmsentitysname == \'US\'">{{timesheetpayrolldata.totalOT   | number:\'1.2-2\'}}</td>\r\n                <td *ngIf="tmsentitysname == \'US\'">{{timesheetpayrolldata.doubleOT   | number:\'1.2-2\'}}</td>\r\n                <td *ngIf="californiaemp">{{calcTotalHoursRest()  | number:\'1.2-2\'}}</td>\r\n                <td *ngIf="californiaemp">{{calcTotalHoursMeal()  | number:\'1.2-2\'}}</td>\r\n                <td>{{calcTotalworkedandnonworkHours()  | number:\'1.2-2\'}}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n</div>\r\n\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>\r\n'},function(e,t){e.exports='<style>\r\n    button.addBtn {\r\n        background: #0086CB;\r\n        color: #fff;\r\n        font-weight: bold;\r\n        min-width: 80px;\r\n    }\r\n\r\n    .addbtnDiv {\r\n        padding: 13px 18px;\r\n        float: right;\r\n        text-align: left;\r\n        margin-right: 32px;\r\n    }\r\n\r\n    button.cancelBtn {\r\n        margin-left: 12px;\r\n        min-width: 80px;\r\n        background: #4f92a9;\r\n        font-weight: bold;\r\n        color: #fff;\r\n    }\r\n\r\n    .addItem label {\r\n        font-size: 12px;\r\n    }\r\n\r\n    ::ng-deep .mdc-dialog__surface {\r\n        overflow: hidden !important;\r\n    }\r\n</style>\r\n\r\n<mat-card-title style="background-color: #0086CB">\r\n    <h4 class="SubHead" style="color: white; padding: 5px;">REMARKS</h4>\r\n</mat-card-title>\r\n\r\n<div class="addItem">\r\n\r\n    <div class="row">\r\n        <div class="col-md-12">\r\n            <div class="col-md-12">\r\n                <label>Remarks<span class="asterik-mark">*</span></label>\r\n                <br />\r\n            </div>\r\n            <div class="col-md-12">\r\n                <textarea style="height:90px;width: 100%;" [(ngModel)]="Remarks"></textarea>\r\n            </div>\r\n        </div>\r\n    </div>\r\n    <hr />\r\n    <mat-dialog-actions align="end">\r\n        <div class="form-submit">\r\n            <button mat-raised-button class="addBtn" (click)="onSubmit(Remarks)">Submit</button>\r\n        </div>\r\n    </mat-dialog-actions>\r\n\r\n</div>\r\n\r\n'},function(e,t){e.exports='<style>\r\n    .vPONC ::ng-deep mat-expansion-panel-header {\r\n        background: #c4f3e8;\r\n        height: 33px !important;\r\n    }\r\n\r\n    .vPONC label, .vPONC span {\r\n        font-size: 11px;\r\n    }\r\n</style>\r\n<mat-card-title>\r\n    <h4 class="SubHead">\r\n        {{data.EmployeeName}} - {{data?.EmployeeNo}}<span class="spgeBack">\r\n            <button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn"><i class="fa fa-times" aria-hidden="true"></i>&nbsp;</button>\r\n        </span>\r\n    </h4>\r\n</mat-card-title>\r\n\r\n\x3c!--<div class="row" *ngIf=" purchaseOrderAttachmentLineDeatils.length == 0">\r\n    <h4 style="text-align: center;margin: 12px;padding: 6px;"> No Attachment found....</h4>\r\n</div>--\x3e\r\n\r\n<mat-card-content class="vPONC">\r\n    <div class="vendor-block">\r\n\r\n        <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n            <mat-expansion-panel-header>\r\n                <mat-panel-title>\r\n                    <mat-icon><i class="material-icons">import_contacts</i></mat-icon> Skill Details\r\n                </mat-panel-title>\r\n            </mat-expansion-panel-header>\r\n\r\n            <table class="itemRows-tble">\r\n                <tr>\r\n                    <th> Role Group </th>\r\n                    <th> Type </th>\r\n                    <th> Category </th>\r\n                    <th> Sub Category </th>\r\n                    <th> Skill </th>\r\n                    <th> Level </th>\r\n                    <th> Experience </th>\r\n                    <th> Last Used Month/Year </th>\r\n                    <th> Last Updated On </th>\r\n                    <th> Action </th>\r\n                </tr>\r\n                <tr *ngFor="let element of skillslistdetails">\r\n                    <td>{{element.roleGroup}}</td>\r\n                    <td> {{element.title}}</td>\r\n                    <td>{{element.categoryName}}</td>\r\n                    <td> {{element.subCategoryName}}</td>\r\n                    <td>{{element.skillName}}</td>\r\n                    <td> {{element.skillLevel}}</td>\r\n                    <td>{{element.relevantExpirence}}</td>\r\n                    <td> {{this._utilityService.getMonthNameByNumber(element.lastUsedMonth)}}-{{element.lastUsedYear}}</td>\r\n                    <td>{{this._timesheetService.getFormattedDate(element.lastModifiedOn)}}</td>\r\n                    <td>\r\n                        <button mat-icon-button (click)="deleteSkillPackDetail(element.employeeSkillPackMasterDetailsId,1);$event.preventDefault()" *ngIf="skillslistdetails.length>1" matTooltip="Delete">\r\n                            <i class="fa fa-trash" aria-hidden="true"></i>\r\n                        </button>\r\n                    </td>\r\n                </tr>\r\n            </table>\r\n            <div class="row" *ngIf=" skillslistdetails.length == 0">\r\n                <h4 style="text-align: center;margin: 12px;padding: 6px;"> No Skills found....</h4>\r\n            </div>\r\n\r\n\r\n\r\n        </mat-expansion-panel>\r\n\r\n        <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n            <mat-expansion-panel-header>\r\n                <mat-panel-title>\r\n                    <mat-icon><i class="material-icons">import_contacts</i></mat-icon> Domain Details\r\n                </mat-panel-title>\r\n            </mat-expansion-panel-header>\r\n\r\n            <table class="itemRows-tble">\r\n                <tr>\r\n                    <th> Domain Category </th>\r\n                    <th> Skill </th>\r\n                    <th> Level </th>\r\n                    <th> Experience </th>\r\n                    <th> Last Used Month/Year </th>\r\n                    <th> Last Updated On </th>\r\n                    \r\n                </tr>\r\n                <tr *ngFor="let element of domainlistdetails">\r\n                    <td>\r\n                        {{element.subCategoryName}}\r\n                    </td>\r\n                    <td> {{element.skillName}}</td>\r\n                    <td>{{element.skillLevel}}</td>\r\n                    <td> {{element.relevantExpirence}}</td>\r\n                    <td>{{this._timesheetService.getFormattedDate(element.lastModifiedOn)}}</td>\r\n                    <td> {{this._utilityService.getMonthNameByNumber(element.lastUsedMonth)}}-{{element.lastUsedYear}}</td>\r\n                   \r\n\r\n                </tr>\r\n            </table>\r\n            <div class="row" *ngIf="domainlistdetails.length == 0">\r\n                <h4 style="text-align: center;margin: 12px;padding: 6px;"> No Domains found....</h4>\r\n            </div>\r\n\r\n\r\n\r\n        </mat-expansion-panel>\r\n\r\n\r\n        <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n            <mat-expansion-panel-header>\r\n                <mat-panel-title>\r\n                    <mat-icon><i class="material-icons">import_contacts</i></mat-icon>Certification Details\r\n                </mat-panel-title>\r\n            </mat-expansion-panel-header>\r\n\r\n            <table class="itemRows-tble">\r\n                <tr>\r\n                    <th>Certification Category </th>\r\n                    <th>Certification Name </th>\r\n                    <th>Certification Id </th>\r\n                    <th>Certification Date </th>\r\n                    <th>Certification Expiry Date</th>\r\n                    <th>Certification Document </th>\r\n                    <th>Action </th>\r\n                </tr>\r\n                <tr *ngFor="let element of certificationlistdetails">\r\n                    <td>{{element.certificationCategory}}</td>\r\n                    <td>{{element.certificationName}}</td>\r\n                    <td>{{element.certificationId}}</td>\r\n                    <td> {{this._timesheetService.getFormattedDate(element.certificationDate)}}</td>\r\n                    <td> {{this._timesheetService.getFormattedDate(element.certificationExpiryDate)}}</td>\r\n                    <td>{{ (element.fileName.length> 40)? (element.fileName | slice:0:40)+\'..\':(element.fileName) }}</td>\r\n                    <td>\r\n                        <button mat-icon-button (click)="downloadFile(element.employeeSkillPackMasterDetailsId,element.fileName);$event.preventDefault()" matTooltip="View Attachment">\r\n                            <i class="fa fa-download" aria-hidden="true"></i>\r\n                        </button>\r\n                       \r\n                    </td>\r\n\r\n                </tr>\r\n\r\n            </table>\r\n            <div class="row" *ngIf=" certificationlistdetails.length == 0">\r\n                <h4 style="text-align: center;margin: 12px;padding: 6px;"> No Certification found....</h4>\r\n            </div>\r\n\r\n\r\n\r\n        </mat-expansion-panel>\r\n\r\n\r\n\r\n    </div>\r\n</mat-card-content>\r\n<mat-dialog-actions align="end">\r\n    <button mat-button mat-dialog-close class="close-btn org-btn" *ngIf="isApprovalAllowed" (click)="approveEmployeeSkillpack(2)">Approve</button>\r\n    <button mat-button mat-dialog-close class="close-btn org-btn" *ngIf="isApprovalAllowed" (click)="approveEmployeeSkillpack(-1)">Reject</button>\r\n</mat-dialog-actions>\r\n\r\n\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>\r\n'},function(e,t){e.exports='<div class="leave-container" [@routerTransition]>\r\n    <mat-card>\r\n        <mat-card-title><h4 class="SubHead">Profile<span class="spgeBack" *ngIf="tenantMasterId == 7"><a class="pgeBack" (click)="backClick()"><mat-icon><i class="material-icons">arrow_back_ios</i></mat-icon>Back</a></span></h4></mat-card-title>\r\n        \x3c!-- Profile Form --\x3e\r\n        <div class="ProfileForm">\r\n\r\n            <div class="row" *ngIf="tenantMasterId != 7">\r\n\r\n                <div class="col-md-3" style="text-align: center;">\r\n                    <div class="col-md-12">\r\n                        <span *ngIf="_loading">Loading...</span>\r\n                        <ng-container *ngIf="!_loading">\r\n                            <img *ngIf="profileImage"\r\n                                 style="margin-left: 40px;border-radius: 50%;width: 100px;height: 100px;"\r\n                                 src="data:image/png;base64,{{profileImage}}" alt="Profile Image" />\r\n\r\n                            <i *ngIf="!profileImage" class="fa fa-user fa-4" aria-hidden="true" style="font-size: 6.3em;color: #c5c5c5;"></i>\r\n                        </ng-container>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">                      \r\n                        <p style="color: #cc7537;font-size: 1.2em;font-weight: bold;padding: 12px 0;">{{employeeMaster.fullName}}</p>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <div class="col-md-9">\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Employee No</label>\r\n                        <p>{{employeeMaster.employeeNo}}</p>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Full Name</label>\r\n                        <p>{{employeeMaster.fullName}}</p>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Office Email Id</label>\r\n                        <p>{{employeeMaster.officeEmailId}}</p>\r\n                    </div>\r\n\r\n\r\n\r\n                    <div class="col-xs-12 col-md-3" [hidden]="true">\r\n                        <label>Grade</label>\r\n                        <p>{{employeeMaster.grade}}</p>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>BU</label>\r\n                        <p>{{employeeMaster.bu}}</p>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>SBU</label>\r\n                        <p>{{employeeMaster.sbu}}</p>\r\n                    </div>\r\n\r\n\r\n\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>BU Head Name</label>\r\n                        <p>{{employeeMaster.buHeadName}}</p>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>SBU Head Name</label>\r\n                        <p>{{employeeMaster.sbuHeadName}}</p>\r\n                    </div>\r\n\r\n\r\n                    <div class="col-md-12 col-md-3">\r\n                        <label>Reporting Manager</label>\r\n                        <p>{{employeeMaster.managerName}}</p>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Phone Number</label>\r\n                        <p>{{employeeMaster.mobileNo}}</p>\r\n                    </div>\r\n\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Extension Number</label>\r\n                        <p>{{employeeMaster.extensionNumber}}</p>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Physical Location</label>\r\n                        <p>{{employeeMaster.physicalLocation}}</p>\r\n                    </div>\r\n\r\n                    <div class="col-md-12 col-md-3" [hidden]="true">\r\n                        <label>Unit Location</label>\r\n                        <p>{{employeeMaster.unit}}</p>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Designation</label>\r\n                        <p>{{employeeMaster.designation}}</p>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Employee Status</label>\r\n                        <p *ngIf="employeeMaster.employeeStatus == \'Active\'" class="aempStatus">\r\n                            Active\r\n                        </p>\r\n                        <p *ngIf="employeeMaster.employeeStatus == \'Terminated\'" class="tempStatus">\r\n                            In-Active\r\n                        </p>\r\n                    </div>\r\n                    <div class="col-md-12 col-md-3">\r\n                        <label>Cubical Number</label>\r\n                        <p>{{employeeMaster.cubicalNumber}}</p>\r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n\r\n            \x3c!-- For SG Only--\x3e\r\n            <div class="row" *ngIf="tenantMasterId == 7">\r\n                <div class="col-xs-12 col-md-3" style="text-align: center;">\r\n                    <div class="col-md-12">\r\n                        <span *ngIf="_loading">Loading...</span>\r\n                        <ng-container *ngIf="!_loading">\r\n                            <img *ngIf="profileImage"\r\n                                 style="margin-left: 40px;border-radius: 50%;width: 100px;height: 100px;"\r\n                                 src="data:image/png;base64,{{profileImage}}" alt="Profile Image" />\r\n\r\n                            <i *ngIf="!profileImage" class="fa fa-user fa-4" aria-hidden="true" style="font-size: 6.3em;color: #c5c5c5;"></i>\r\n                        </ng-container>\r\n                    </div>\r\n                </div>\r\n                <div class="col-xs-12 col-md-9">\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Employee No</label>\r\n                        <p>{{employeeMaster.employeeNo}}</p>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Full Name</label>\r\n                        <p>{{employeeMaster.fullName}}</p>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Office Email Id</label>\r\n                        \r\n                        <p *ngIf="employeeMaster.officeEmailId != null">\r\n                            {{employeeMaster.officeEmailId}}\r\n                        </p>\r\n                        <p *ngIf="employeeMaster.officeEmailId == null">\r\n                            -\r\n                        </p>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Contact Number</label> \r\n                        <p *ngIf="employeeMaster.mobileNo != null">\r\n                            {{employeeMaster.mobileNo}}\r\n                        </p>\r\n                        <p *ngIf="employeeMaster.mobileNo == null">\r\n                            -\r\n                        </p>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Designation</label>\r\n                        \r\n                        <p *ngIf="employeeMaster.designation != null">\r\n                            {{employeeMaster.designation}}\r\n                        </p>\r\n                        <p *ngIf="employeeMaster.designation == null">\r\n                            -\r\n                        </p>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Reporting Manager</label>\r\n                        \r\n                        <p *ngIf="employeeMaster.managerName != null">\r\n                            {{employeeMaster.managerName}}\r\n                        </p>\r\n                        <p *ngIf="employeeMaster.managerName == null">\r\n                            -\r\n                        </p>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <label>Status</label>\r\n                        <p *ngIf="employeeMaster.employeeStatus == \'Active\'" class="aempStatus">\r\n                            Active\r\n                        </p>\r\n                        <p *ngIf="employeeMaster.employeeStatus == \'Terminated\'" class="tempStatus">\r\n                            In-Active\r\n                        </p>\r\n                    </div>\r\n                </div>\r\n\r\n                </div>\r\n                \x3c!-- For SG Only--\x3e\r\n\r\n            </div>\r\n</mat-card>\r\n</div>\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>'},function(e,t,n){var r=n(1013);e.exports="string"==typeof r?r:r.toString()},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,"\r\n.matlistlink {\r\n    color: #ffffff;\r\n    cursor: pointer;\r\n}\r\n\r\n.mat-input-element, .mat-form-field-infix {\r\n    width: 100%;\r\n}\r\n\r\n.col-xs-12.col-md-4 {\r\n    margin-bottom: 14px;\r\n}\r\n\r\n.right-align {\r\n    /*text-align: center;*/\r\n}\r\n\r\nbutton.bluBtn.blu {\r\n    background: #1987d6;\r\n}\r\n\r\nbutton.bluBtn.org {\r\n    background: #f16717;\r\n}\r\n\r\nbutton.bluBtn {\r\n    color: #fff;\r\n}\r\n\r\n.leave_history {\r\n    font-family: Ubuntu;\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n}\r\n\r\n    .leave_history td, .leave_history th {\r\n        border: 1px solid #ddd;\r\n        padding: 8px;\r\n    }\r\n\r\n    .leave_history tr:nth-child(even) {\r\n        background-color: #f2f2f2;\r\n    }\r\n\r\n    .leave_history tr:hover {\r\n        background-color: #ddd;\r\n    }\r\n\r\n    .leave_h