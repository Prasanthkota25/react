\r\n                    <td>12</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>2 years & above</td>\r\n                    <td>14</td>\r\n                </tr>\r\n            </table>\r\n            <h5 class="sub-head-help">Category 3:</h5>\r\n            <p>Employees joined between …. To …….</p>\r\n            <table>\r\n                <tr>\r\n                    <th>Years of service</th>\r\n                    <th>Days of leave</th>\r\n                </tr>\r\n                <tr>\r\n                    <td>1-2 years</td>\r\n                    <td>12</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>2-4 years</td>\r\n                    <td>14</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>4 & above years</td>\r\n                    <td>18</td>\r\n                </tr>\r\n            </table>\r\n            <h5 class="sub-head-help">Category 4:</h5>\r\n            <p>Employees having fixed leave of 14 per year</p>\r\n            <table>\r\n                <tr>\r\n                    <th>Years of service</th>\r\n                    <th>Days of leave</th>\r\n                </tr>\r\n                <tr>\r\n                    <td>Any year</td>\r\n                    <td>14</td>\r\n                </tr>\r\n            </table>\r\n            <h5 class="sub-head-help">Category 5:</h5>\r\n            <p>Employees on contract rolls:</p>\r\n            <table>\r\n                <tr>\r\n                    <th>Contract duration</th>\r\n                    <th>Days of leave</th>\r\n                </tr>\r\n                <tr>\r\n                    <td>Less than 6 months</td>\r\n                    <td>1 leave to be credited every month</td>\r\n                </tr>\r\n                <tr>\r\n                    <td>More than 6 months</td>\r\n                    <td>Credited after 3 months on a Monthly prorated basis</td>\r\n                </tr>\r\n            </table>\r