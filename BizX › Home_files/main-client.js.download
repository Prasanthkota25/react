</h4>\r\n    <table class="documentTable">\r\n        <tr><th></th><th>Name</th></tr>\r\n        <tr><td style="text-align:center;"><i class="fa fa-file-text-o" aria-hidden="true"></i></td><td>Defect clasification guidelines</td></tr>\r\n    </table>\r\n    <h4>Templates</h4>\r\n    <table class="documentTable">\r\n        <tr><th></th><th>Name</th></tr>\r\n        <tr><td style="text-align:center;"><i class="fa fa-file-text-o" aria-hidden="true"></i></td><td>Defect clasification templates</td></tr>\r\n    </table>\r\n</div>\r\n<div mat-dialog-actions style="display: inline-block;width: 100%;text-align: right;">\r\n    <button mat-button (click)="onDismiss()">Close</button>\r\n</div>'},function(e,t,n){var r=n(1073);e.exports="string"==typeof r?r:r.toString()},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,".emp-info-blk {\r\n    padding: 0px 12px 12px 12px;\r\n    /*font-size: 12px;*/\r\n}\r\n.col-xs-12.col-md-4 label {\r\n    /*font-size: 12px;*/\r\n}\r\n.emp-info-blk .col-xs-12.col-md-3 {\r\n    padding: 0;\r\n}\r\n.mat-dialog-title {\r\n    background: #09b9b9;\r\n    color: #fff;\r\n    text-transform: uppercase;\r\n    padding: 2px 0px 2px 11px;\r\n    font-size: 14px;\r\n    margin-bottom: 4px;\r\n}\r\nbutton.btnIcon.CloseBtn {\r\n    min-width: 2px;\r\n    float: right;\r\n    line-height: 0;\r\n    padding: 8px;\r\n}\r\n.documentTable {\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n    font-size: 13px;\r\n}\r\n\r\n   .documentTable td,.documentTable th {\r\n        border: 1px solid #ddd;\r\n        padding: 2px;\r\n    }\r\n\r\n   .documentTable tr:nth-child(even) {\r\n        background-color: #f2f2f2;\r\n    }\r\n\r\n   .documentTable tr:hover {\r\n        background-color: #ddd;\r\n    }\r\n\r\n    .documentTable th {\r\n        padding-top: 0px;\r\n        padding-bottom: 0px;\r\n        text-align: left;\r\n        background-color: #5fb8e2;\r\n        color: #f5f5f5;\r\n    }\r\n.mat-di