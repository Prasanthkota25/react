nIn(\'infinite\')" class="signBtn login-btn" mat-raised-button>\r\n                                    Infinite Sign-In\r\n                                </button><mat-icon style="float:right;margin-top:14px;" matTooltip="Login using @infinite.com">info</mat-icon>\r\n\r\n                                <button (click)="onSignIn(\'zyter\')" class="signBtn login-btn" mat-raised-button>\r\n                                    Zyter Sign-In\r\n                                </button><mat-icon style="float:right;margin-top:14px;" matTooltip="Login using @zyter.com">info</mat-icon>\r\n\r\n                                <div class="login-attinio">\r\n                                    <button (click)="onSignIn(\'attinio\')" class="signBtn login-btn" mat-raised-button>\r\n                                        Attinio Sign-In\r\n                                    </button><mat-icon style="float:right;margin-top:14px;" matTooltip="Login using @attinio.ai">info</mat-icon>\r\n                                </div>\r\n\r\n                                <div class="login-thoriva">\r\n                                    <button (click)="onSignIn(\'thoriva\')" class="signBtn login-btn" mat-raised-button>\r\n                                        Thoriva Sign-In\r\n                                    </button><mat-icon style="float:right;margin-top:14px;" matTooltip="Login using @thoriva.com">info</mat-icon>\r\n                                </div>\r\n\r\n                                <button routerLink="/bizx-login" class="signBtn login-btn" mat-raised-button>\r\n                                    APAC Sign-In\r\n                                </button><mat-icon style="float:right;margin-top:14px;" matTooltip="Login using email address">info</mat-icon>\r\n\r\n                                <button routerLink="/bizx-login" class="signBtn login-btn" mat-raised-button>\r\n                                    Partner Resource Sign-In\r\n                                </button><mat-icon style="float:right;margin-top:14px;" matTooltip="Partner Resource Sign-In">info</mat-icon>\r\n\r\n                            </div>\r\n                        </h4>\r\n\r\n                    </div>\r\n\r\n                </mat-card-content>\r\n            </div>\r\n        </mat-card>\r\n\r\n\r\n    </div>\r\n\r\n    <div class="bixAppsLogo">\r\n        <a href="https://itunes.apple.com/in/app/ics-bizx/id1390944529?mt=8" target="_blank"><img loading="lazy" width="109" height="33" src="{{this._bizxrooturi.bindBaseURL()+\'/dist/assets/images/App-Store.png\'}}" title="bizx" /></a>\r\n        <a href="https://play.google.com/store/apps/details?id=com.bizx.infinite.bizx" target="_blank"><img loading="lazy" width="109" height="33" src="{{this._bizxrooturi.bindBaseURL()+\'/dist/assets/images/Google-Play.png\'}}" title="bizx" /></a>\r\n    </div>\r\n\r\n</div>\r\n'},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,".signIn-container {\r\n    display: flex;\r\n    flex-direction: column;\r\n    min-height: 100%;\r\n    min-width: 100%;\r\n    position: absolute;\r\n    /*background-color: #b9b2b269;*/\r\n    background-color: #a8d1e4;\r\n    /*background-image: linear-gradient(141deg, #a2bcf7 0%, #3a99fb 51%, #3d8fd6 75%);*/\r\n    background-image: url(https://bizx.infinite.com/dist/assets/images/login-bg-v2.png);\r\n    background-position: center;\r\n    background-size: cover;\r\n    background-repeat: no-repeat;\r\n}\r\n\r\n.example-header {\r\n    min-height: 64px;\r\n    display: flex;\r\n    align-items: center;\r\n    padding-left: 24px;\r\n    font-size: 20px;\r\n}\r\n\r\n.example-table {\r\n    overflow: auto;\r\n    min-height: 300px;\r\n}\r\n\r\n.example-loading-shade {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    bottom: 56px;\r\n    right: 0;\r\n    background: rgba(0, 0, 0, 0.15);\r\n    z-index: 1;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    min-height: 100%;\r\n}\r\n\r\n.example-rate-limit-reached {\r\n    color: #980000;\r\n    max-width: 360px;\r\n    text-align: center;\r\n}\r\n\r\nmat-card {\r\n    max-width: 400px;\r\n    margin: 2em auto;\r\n    text-align: center;\r\n    min-height: auto;\r\n}\r\n\r\n.signin-content {\r\n    padding: 6px 1rem;\r\n}\r\n\r\n.full-width-input {\r\n    width: 100%;\r\n}\r\n\r\nbutton.signBtn.mat-raised-button {\r\n    /*width: 50%;*/\r\n    background-color: #004356;\r\n    color: #fff;\r\n    box-shadow: none;\r\n    /*min-width: 156px;*/\r\n    font-size: 1.1em;\r\n    float: left;\r\n    width: 160px;\r\n    /*padding: 10px 8px;*/\r\n}\r\n\r\n    button.signBtn.mat-raised-button[disabled] {\r\n        background-color: #dedede;\r\n        color: #222;\r\n    }\r\n\r\nbutton.login-btn {\r\n    background-color: #004356;\r\n    box-shadow: none;\r\n    color: #fff;\r\n    margin: 10px;\r\n    font-size: 1.3em;\r\n}\r\n\r\nbutton.login-btn-org {\r\n    background-color: #d06060;\r\n    box-shadow: none;\r\n    color: #fff;\r\n    font-size: 1.3em;\r\n}\r\n\r\nspan.uName {\r\n    font-size: 1.3em;\r\n    text-transform: capitalize;\r\n    color: #a70b04;\r\n    margin-bottom: 10px;\r\n    display: block;\r\n}\r\n\r\nbutton .login-btn[disabled] {\r\n    background-color: #dedede;\r\n    color: #222;\r\n}\r\n\r\n.logMain {\r\n    display: inline-block;\r\n    width: 75%;\r\n    /*border-bottom: 3px solid #f8842b;*/\r\n    /*padding-bottom: 10px;*/\r\n    /*width: 90%;*/\r\n    padding: 2px 0;\r\n    float: left;\r\n}\r\n\r\n.logInner {\r\n    /*text-align: right;*/\r\n    /*margin-right: 18px;*/\r\n    /*display: inline;*/\r\n    width: 100%;\r\n    margin: 0 auto;\r\n    margin-top: 0px\r\n}\r\n\r\nimg.logo {\r\n    /*width: 12%;*/\r\n}\r\n\r\n.regDiv {\r\n    padding: 12px;\r\n}\r\n\r\nspan.noAcct {\r\n    color: #2e2f39;\r\n}\r\n\r\na.RegLnk {\r\n    /* display: inline; */\r\n    color: #1096e4;\r\n    text-decoration: none;\r\n}\r\n\r\n.signin-content mat-form-field {\r\n    display: block;\r\n}\r\n\r\nh2.logINtitle {\r\n    font-size: 1.3em;\r\n    /*line-height: 2;*/\r\n    font-weight: 100;\r\n    color: #004356;\r\n    padding: 0;\r\n    margin: 0;\r\n}\r\n\r\nspan.bzxLogoX {\r\n    color: #157aab;\r\n    font-size: 16px;\r\n    font-weight: bold;\r\n}\r\n\r\nspan.bzxLogo {\r\n    color: #2d9a8b;\r\n    font-size: 25px;\r\n    font-weight: 500;\r\n}\r\n\r\n.logoBizX {\r\n    display: inline-block;\r\n    width: 80%;\r\n    text-align: left;\r\n    font-family: Ubuntu;\r\n}\r\n\r\n::ng-deep snack-bar-container.snakeBox {\r\n    background: #115279;\r\n}\r\n\r\n.rembrMe .mat-checkbox-inner-container.mat-checkbox-inner-container-no-side-margin {\r\n    height: 14px;\r\n    width: 14px;\r\n}\r\n\r\nmat-card-content.logInScreen {\r\n    min-height: 510px;\r\n    /*margin: 17% 0;*/\r\n    margin: 0;\r\n    /*border-top: 1px solid #10adb5;*/\r\n    width: 25%;\r\n    margin: 0 auto;\r\n    margin-right: 0px;\r\n    padding: 8px;\r\n    background-color: #fff;\r\n    float:right\r\n}\r\n\r\n.centerDiv {\r\n    background-color: #fff;\r\n    display: flex;\r\n}\r\n\r\nbutton.login-btn {\r\n    margin: 10px;\r\n}\r\n\r\n.signin-content .mat-card {\r\n    padding: 0;\r\n    max-width: 100%;\r\n    margin: 3em auto;\r\n    background: rgba(255, 255, 255,0.65);\r\n    box-shadow: -1px 0px 5px -2px rgba(0,0,0,.2), 6px 5px 2px 0 rgba(0,0,0,.14), 12px 2px 15px 0 rgba(0,0,0,.12), 1px 1px 4px 0 rgba(0,0,0,.12);\r\n}\r\n\r\n::ng-deep .mat-progress-bar-fill::after {\r\n    background-color: #f77917;\r\n}\r\n\r\n::ng-deep .mat-progress-bar-buffer {\r\n    background: #d4d4d4;\r\n}\r\n\r\n::ng-deep .mat-progress-bar {\r\n    border-radius: 2px;\r\n}\r\n\r\n::ng-deep .mat-progress-bar {\r\n}\r\n\r\n.bixLogo {\r\n    position: absolute;\r\n    padding: 0 1%;\r\n}\r\n\r\n.bixAppsLogo {\r\n    position: absolute;\r\n    bottom: 12%;\r\n    left: 78%;\r\n}\r\n\r\n.usrName input {\r\n    border: 2px solid #387182;\r\n    padding: 6px;\r\n    width: 80%;\r\n    font-size: 1.6em;\r\n    text-align: center;\r\n}\r\n\r\n.usrName label {\r\n    color: #004356;\r\n    font-size: 1.4em;\r\n    font-weight: normal;\r\n}\r\n\r\n.login-box-body {\r\n    font-family: Arimo;\r\n    margin-top: 100px;\r\n}\r\n\r\n.usrName {\r\n    min-height: 115px;\r\n}\r\n\r\n.sent {\r\n    margin-top: 18px;\r\n    font-size: 13px;\r\n    float: left;\r\n    margin-left: 12px;\r\n}\r\n\r\n.lblTitlelogin {\r\n    font-weight: normal;\r\n    font-size: 15px;\r\n    text-align: left;\r\n    float: left;\r\n    margin-left: 11px;\r\n}\r\n\r\n\r\n/* Disables the selection */\r\n.disableselect {\r\n    -webkit-touch-callout: none; /* iOS Safari */\r\n    -webkit-user-select: none; /* Chrome/Safari/Opera */\r\n    -khtml-user-select: none; /* Konqueror */\r\n    -moz-user-select: none; /* Firefox */\r\n    -ms-user-select: none; /* Internet Explorer/Edge*/\r\n    user-select: none; /* Non-prefixed version browser */\r\n}\r\n\r\n/* Disables the drag event for images */\r\n.disabledrag {\r\n    -webkit-user-drag: none;\r\n    -khtml-user-drag: none;\r\n    -moz-user-drag: none;\r\n    -o-user-drag: none;\r\n    user-drag: none;\r\n}\r\n\r\n.greetingsMasg {\r\n    font-size: 11px;\r\n    color: #0371a8;\r\n    font-weight: bold;\r\n}\r\n\r\n.bixLogo img {\r\n    width: 100%;\r\n}\r\n\r\n.bixAppsLogo img {\r\n    width: 45%;\r\n}\r\n\r\nimg.loginBizLogo {\r\n    width: 100%;\r\n    display: flex;\r\n    flex-direction: column;\r\n    \r\n    \r\n}\r\n\r\n.btnext {\r\n    width: 200px;\r\n    height: 50px;\r\n}\r\n\r\n/* Forgot Password*/\r\n.forgot-password-content {\r\n    padding: 60px 1rem;\r\n}\r\n.forgot-password-content .bixLogo {\r\n    position: absolute;\r\n    padding: 1px 4%;\r\n    width: 24%;\r\n}\r\n.forgot-password-content mat-card.mat-card {\r\n    max-width: 350px;\r\n    margin: 4em auto;\r\n}\r\n.forgot-password-content mat-card {\r\n    max-width: 350px;\r\n    margin: 4em auto;\r\n}\r\nmat-card-content.forgotScreen {\r\n    margin: 0 auto;\r\n    margin-right: 0px;\r\n    padding: 8px;\r\n}\r\nbutton.forgetBtn {\r\n    background-color: #004356;\r\n    color: #fff;\r\n    box-shadow: none;\r\n    font-size: 1.3em;\r\n    width: 160px;\r\n}\r\n.forgot-password-content .logMain {\r\n    width: 100%;\r\n}\r\n/* Forgot Password*/\r\n\r\n.login-attinio{\r\n    display:block;\r\n}\r\n.login-thoriva {\r\n    display: block;\r\n}",""])},function(e,t){e.exports='<div class="data-view-container" [@routerTransition]>\r\n    <mat-card [@routerTransition] class="dashBG">\r\n        <mat-card-content>\r\n            <mat-card-title _ngcontent-c13="" class="mat-card-title ng-tns-c13-3">\r\n                <h4 class="SubHead dashboard">\r\n                    Dashboard\r\n                    <button style="float:right;" class="modle-selct-btn" mat-button (click)="openModuleDialog()">Select Modules</button>\r\n                </h4>\r\n            </mat-card-title>\r\n            \x3c!--carousl--\x3e\r\n            <div class="carousel-reviews broun-block">\r\n                <div class="row dashcontainerTop" style="margin: 0 0px;padding:5px 0px 0px 5px;">\r\n                    <ng-container *ngFor="let m of dashboardStatusSummary | slice:0:14; let i = index">\r\n                        <div *ngIf="m.moduleName != \'Raise Hand\'">\r\n                            <div class="col-md-2 col-xs-12 grad grid-{{i+1}}" style="padding: 0;" matTooltip="{{m.moduleName}}">\r\n                                <div [ngClass]="actModule == m.moduleName ? \'activebox \'+\'actID-\'+m.moduleId : \'\'" class="border-top icn-div" (click)="loadTeamView(m.moduleName,\'manager\',i+1)">\r\n                                    <div class="col-md-12 mainBlock">\r\n\r\n                                        <div class="col-md-4 col-xs-4 backTransIcon">\r\n                                            \x3c!--<i class="fa {{m.iconClass}}" aria-hidden="true"></i>--\x3e\r\n\r\n                                            <ng-container *ngIf="currentTheme == \'StyleSheet\'">\r\n                                                <img src="{{this._bizxrooturi.bindBaseURL() + \'/dist/assets/images/module_images/purplewhite/\' + m.moduleName}}.png" />\r\n                                            </ng-container>\r\n\r\n                                            <ng-container *ngIf="currentTheme == \'StyleSheet-blue\'">\r\n                                                <img src="{{this._bizxrooturi.bindBaseURL() + \'/dist/assets/images/module_images/purplewhite/\' + m.moduleName}}.png" />\r\n                                            </ng-container>\r\n\r\n                                            <ng-container *ngIf="currentTheme == \'StyleSheet-darkBlue\'">\r\n                                                <img src="{{this._bizxrooturi.bindBaseURL() + \'/dist/assets/images/module_images/purple/\' + m.moduleName}}.png" />\r\n                                            </ng-container>\r\n                                        </div>\r\n                                        <div class="col-md-8 col-xs-8">\r\n                                            <ng-container (click)="loadTeamView(m.moduleName,\'manager\',i+1)">\r\n                                                <div style="cursor:pointer" class="col-md-12 modName">\r\n                                                    <p class="blk-1"><span class="blck-tit">{{m.displayModuleName}}</span></p>\r\n                                                </div>\r\n                                                <div class="col-md-12 countoNo" counto [step]="10" [countTo]="m.managerCount" [countFrom]="0" [duration]="2" (countoChange)="m.id = $event">\r\n                                                    <span class="tot-count">{{m.id | number:\'1.0-0\' }}</span>\r\n                                                </div>\r\n                                            </ng-container>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </ng-container>\r\n                </div>\r\n            </div>\r\n            \x3c!--carousl--\x3e\r\n            <div class="mainTbleBody">\r\n                <h5 class="in-title" [ngClass]=" \'actID-\'+ actFilterCls" *ngIf="!displayMsg">{{pendingModuleName}}</h5>\r\n\r\n                <div class="dashboardList-header" *ngIf="!displayMsg">\r\n                    \x3c!--<label *ngIf="selection.selected.length > 0" style="margin-right: -61px;">Selected: {{selection.selected.length}} </label>--\x3e\r\n                    <div class="LftRecutritFilterArea">\r\n                        <mat-paginator [pageSizeOptions]="[ 10, 25,50, 100]"></mat-paginator>\r\n                    </div>\r\n                    <div class="dashFilterArea">\r\n\r\n\r\n                        <mat-form-field matColumnDef="entityClass" *ngIf="tblPoSignOff && !displayMsg">\r\n                            <mat-select placeholder="PO Location" (change)="LoadPOApprovedList($event.value)" [(ngModel)]="tenantId">\r\n                                <mat-option value="{{entity.id}}" *ngFor="let entity of EntityList"> {{entity.tenantName}}  </mat-option>\r\n                            </mat-select>\r\n                        </mat-form-field>\r\n\r\n                        \x3c!--<mat-form-field matColumnDef="entityClass" *ngIf="tblPoSignOff && !displayMsg">\r\n                            <mat-select placeholder="PO Status" (change)="LoadPOApprovedListUnsigned($event.value)" [(ngModel)]="Issigned">\r\n                                <mat-option value="0"> Unsigned PO </mat-option>\r\n                                <mat-option value="1"> Signed PO  </mat-option>\r\n                            </mat-select>\r\n                        </mat-form-field>--\x3e\r\n                        <mat-form-field>\r\n                            <input matInput (keyup)="applyFilter($event.target.value)" placeholder="Filter">\r\n                        </mat-form-field>\r\n                        <button mat-button class="btnBulkDshPge" matTooltip="Approve requests" *ngIf=" dataSource.data.length!==0 && bulkBtn"\r\n                                (click)="BulkApprove(1)">\r\n                            <i class="fa fa-check" aria-hidden="true"></i> Approve\r\n                        </button>\r\n                        <label *ngIf="selection.selected.length > 0">Selected: {{selection.selected.length}} </label>\r\n                        \x3c!--<button mat-button class="btnBulkDshPge" matTooltip="Reject requests" *ngIf=" dataSource.data.length!==0 && bulkBtn"\r\n            (click)="BulkApprove(0)">\r\n        <i class="fa fa-remove" aria-hidden="true"></i> Reject\r\n    </button>--\x3e\r\n\r\n\r\n                    </div>\r\n\r\n                </div>\r\n                \x3c!--Timesheet--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblTimesheet && !displayMsg">\r\n\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length">\r\n                        <ng-container matColumnDef="select">\r\n                            <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                                <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                              [checked]="selection.hasValue() && isEntirePageSelected()"\r\n                                              [indeterminate]="selection.hasValue() && !isEntirePageSelected()"\r\n                                              [aria-label]="checkboxLabel()">\r\n                                </mat-checkbox>\r\n                            </mat-header-cell>\r\n                            <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                                <mat-checkbox (click)="$event.stopPropagation()"\r\n                                              (change)="$event ? selection.toggle(row) : null"\r\n                                              [checked]="selection.isSelected(row)">\r\n                                </mat-checkbox>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!--<ng-container matColumnDef="select">\r\n                <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                    <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                  [checked]="selection.hasValue() && isAllSelected()"\r\n                                  [indeterminate]="selection.hasValue() && !isAllSelected()">\r\n                    </mat-checkbox>\r\n                </mat-header-cell>\r\n                <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                    <mat-checkbox (click)="$event.stopPropagation()"\r\n                                  (change)="$event ? selection.toggle(row) : null"\r\n                                  [checked]="selection.isSelected(row)">\r\n                    </mat-checkbox>\r\n                </mat-cell>\r\n            </ng-container>--\x3e\r\n\r\n                        <ng-container matColumnDef="employeeNo">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="tsEmployeeNo"> Employee ID </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="tsEmployeeNo">{{element.employeeNo}}</mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="fullName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="tsFullName"> Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="tsFullName"> {{element.fullName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="approvalStatus">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="tsApprovalStatus"> Status </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="tsApprovalStatus">   {{ element.approvalStatus == 0 ? \'Not-Submitted\' :element.approvalStatus == 1 ? \'Rejected\': element.approvalStatus == 2 ? \'Submitted\' : element.approvalStatus == 3 ? \'Approved\' : \'\' }} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Status Column --\x3e\r\n                        <ng-container matColumnDef="totalHours">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="taTotalHours"> Hrs. </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="taTotalHours">{{element.totalHours}}</mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Logged Time Column --\x3e\r\n                        <ng-container matColumnDef="createdOn">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="tsCreatedOn"> Submitted On </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="tsCreatedOn"> {{this._timesheetService.getFormattedDate(element.createdOn)}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="openTimesheetDetails(row)"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!--Leave--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblLeave && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length">\r\n                        <ng-container matColumnDef="select">\r\n                            <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                                <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                              [checked]="selection.hasValue() && isEntirePageSelected()"\r\n                                              [indeterminate]="selection.hasValue() && !isEntirePageSelected()"\r\n                                              [aria-label]="checkboxLabel()">\r\n                                </mat-checkbox>\r\n                            </mat-header-cell>\r\n                            <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                                <mat-checkbox (click)="$event.stopPropagation()"\r\n                                              (change)="$event ? selection.toggle(row) : null"\r\n                                              [checked]="selection.isSelected(row)">\r\n                                </mat-checkbox>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!--<ng-container matColumnDef="select">\r\n                <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm ">\r\n                    <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                  [checked]="selection.hasValue() && isAllSelected()"\r\n                                  [indeterminate]="selection.hasValue() && !isAllSelected()">\r\n                    </mat-checkbox>\r\n                </mat-header-cell>\r\n                <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                    <mat-checkbox (click)="$event.stopPropagation()"\r\n                                  (change)="$event ? selection.toggle(row) : null"\r\n                                  [checked]="selection.isSelected(row)">\r\n                    </mat-checkbox>\r\n                </mat-cell>\r\n            </ng-container>--\x3e\r\n                        <ng-container matColumnDef="employeeNo">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="lvEmployeeNo"> Employee No</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="lvEmployeeNo"> {{element.employeeNo}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="fullName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="lvName"> Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="lvName"> {{element.fullName}} </mat-cell>\r\n                        </ng-container>\r\n                        <ng-container matColumnDef="appliedOn">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Applied On</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.appliedOn)}} </mat-cell>\r\n                        </ng-container>\r\n                        <ng-container matColumnDef="leaveName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Leave Type</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.leaveName}} </mat-cell>\r\n                        </ng-container>\r\n                        <ng-container matColumnDef="transactionType">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Request Type </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.requestType}}</mat-cell>\r\n                        </ng-container>\r\n                        <ng-container matColumnDef="startDate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> From Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.startDate)}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="endDate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> To Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.endDate)}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="noOfDays">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="lvNodays"> Days </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="lvNodays"> {{element.noOfDays}} </mat-cell>\r\n                        </ng-container>\r\n                        <ng-container matColumnDef="status">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Status </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.statusValue}}</mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="employeeRemarks">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Remarks </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.employeeRemarks}} </mat-cell>\r\n                        </ng-container>\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!--Expense--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblExpense && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length">\r\n                        <ng-container matColumnDef="select">\r\n                            <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                                <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                              [checked]="selection.hasValue() && isEntirePageSelected()"\r\n                                              [indeterminate]="selection.hasValue() && !isEntirePageSelected()"\r\n                                              [aria-label]="checkboxLabel()">\r\n                                </mat-checkbox>\r\n                            </mat-header-cell>\r\n                            <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                                <mat-checkbox (click)="$event.stopPropagation()"\r\n                                              (change)="$event ? selection.toggle(row) : null"\r\n                                              [checked]="selection.isSelected(row)">\r\n                                </mat-checkbox>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!--<ng-container matColumnDef="select">\r\n                <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                    <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                  [checked]="selection.hasValue() && isAllSelected()"\r\n                                  [indeterminate]="selection.hasValue() && !isAllSelected()">\r\n                    </mat-checkbox>\r\n                </mat-header-cell>\r\n                <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                    <mat-checkbox (click)="$event.stopPropagation()"\r\n                                  (change)="$event ? selection.toggle(row) : null"\r\n                                  [checked]="selection.isSelected(row)">\r\n                    </mat-checkbox>\r\n                </mat-cell>\r\n            </ng-container>--\x3e\r\n                        \x3c!-- requestno Column --\x3e\r\n                        <ng-container matColumnDef="expenseNo">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Request No </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                {{element.expenseNo}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- expense Raised by (Name) --\x3e\r\n                        <ng-container matColumnDef="fullName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- expense Date --\x3e\r\n                        <ng-container matColumnDef="createdOn">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Expense Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.createdOn)}}</mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- client Column --\x3e\r\n                        <ng-container matColumnDef="departmentClient">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Client/Department </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.departmentClient}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- claimtype Column --\x3e\r\n                        <ng-container matColumnDef="claimType">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Claim Type </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.claimType}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- billability Column --\x3e\r\n                        <ng-container matColumnDef="billableType">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Billability </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.billableType}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- status Column --\x3e\r\n                        <ng-container matColumnDef="expenseCategory">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Expense Category </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">{{element.expenseCategory}}</mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="totalAmount">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Total </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" style="text-align:right;">\r\n\r\n                                {{element.currencyCode == \'INR\'?(element.totalAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):element.currencyCode == \'USD\'?(element.totalAmount | currency):element.totalAmount}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="Action">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Action </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                <button class="btnIcon" mat-icon-button type="button"\r\n                                        matTooltip="View" (click)="onExpenseRequestClick(element.id,element.isHelpdeskList,1)">\r\n                                    <i class="fa fa-search" aria-hidden="true"></i>\r\n                                </button>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="onExpenseRequestClick(row.id,row.isHelpdeskList)"></mat-row>\r\n                    </mat-table>\r\n\r\n                    <div *ngIf="!dataSource?.filteredData.length">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!--Travel--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblTravel && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length">\r\n                        <ng-container matColumnDef="select">\r\n                            <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                                <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                              [checked]="selection.hasValue() && isEntirePageSelected()"\r\n                                              [indeterminate]="selection.hasValue() && !isEntirePageSelected()"\r\n                                              [aria-label]="checkboxLabel()">\r\n                                </mat-checkbox>\r\n                            </mat-header-cell>\r\n                            <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                                <mat-checkbox (click)="$event.stopPropagation()"\r\n                                              (change)="$event ? selection.toggle(row) : null"\r\n                                              [checked]="selection.isSelected(row)">\r\n                                </mat-checkbox>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!--<ng-container matColumnDef="select">\r\n                <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                    <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                  [checked]="selection.hasValue() && isAllSelected()"\r\n                                  [indeterminate]="selection.hasValue() && !isAllSelected()">\r\n                    </mat-checkbox>\r\n                </mat-header-cell>\r\n                <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                    <mat-checkbox (click)="$event.stopPropagation()"\r\n                                  (change)="$event ? selection.toggle(row) : null"\r\n                                  [checked]="selection.isSelected(row)">\r\n                    </mat-checkbox>\r\n                </mat-cell>\r\n            </ng-container>--\x3e\r\n                        <ng-container matColumnDef="TravelRequestId">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Travel Request Id </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                TR-{{element.id}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- emp_no Column --\x3e\r\n                        <ng-container matColumnDef="employeeNo">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee No </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.employeeNo}}</mat-cell>\r\n                        </ng-container>\r\n                        <ng-container matColumnDef="fullName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.fullName}}</mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- travel_type Column --\x3e\r\n                        <ng-container matColumnDef="TravelType">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Travel Type </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.travelType}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- dateofrequest Column --\x3e\r\n                        <ng-container matColumnDef="dateOfRequest">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Date of Request </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.dateOfRequest)}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- request_status Column --\x3e\r\n                        <ng-container matColumnDef="StatusText">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Approval Status </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.approvalStatus}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="Action">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> View </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                <button class="btnIcon" mat-icon-button type="button"\r\n                                        matTooltip="View" (click)="onTravelRequestClick(element, 1)">\r\n                                    <i class="fa fa-search" aria-hidden="true"></i>\r\n                                </button>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="onTravelRequestClick(row)"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!--Skill--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblSkillPack && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length != 0">\r\n\r\n                        \x3c!-- empId ID Column --\x3e\r\n                        <ng-container matColumnDef="EmployeeNo">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee ID </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" (click)="$event.stopPropagation()">\r\n                                {{element.EmployeeNo}}\r\n                                <span *ngIf="element.uid==0">\r\n                                    {{element.EmployeeNo}}\r\n                                </span>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- empName Column --\x3e\r\n                        <ng-container matColumnDef="EmployeeName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.EmployeeName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Status Column --\x3e\r\n                        <ng-container matColumnDef="Status">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Status </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.Status}}</mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="Type">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Type </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.Skills}}</mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- approvedDate Column --\x3e\r\n                        <ng-container matColumnDef="ApprovedOn">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Approved Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.Status=="Approved" ? this._timesheetService.getFormattedDate(element.ApprovedOn) : \'\'}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- sumittedDate Column --\x3e\r\n                        <ng-container matColumnDef="SubmittedOn">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Submitted Date </mat-header-cell>\r\n                            \x3c!--<mat-cell *matCellDef="let element"> {{element.SubmittedOn}}</mat-cell>--\x3e\r\n                            <mat-cell *matCellDef="let element"> {{this._timesheetService.getFormattedDate(element.SubmittedOn)}}</mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- CategoryName Column --\x3e\r\n                        \x3c!--<ng-container matColumnDef="Action">\r\n                <mat-header-cell *matHeaderCellDef mat-sort-header>Action</mat-header-cell>\r\n                <mat-cell *matCellDef="let row">\r\n\r\n                    <button style="width:22px;" *ngIf="(row.IsCerificateSubmitted == 1 ||row.IsDomainSubmitted == 1||row.IsSkillsSubmitted == 1||row.status > 0 || row.status==-1)" class="btnIcon" mat-icon-button type="button" matTooltip="View Details" (click)="onDataClick(row)">\r\n                        <i class="fa fa-share-square-o" aria-hidden="true"></i>\r\n                    </button>\r\n\r\n                    <button *ngIf="(row.status == 1)" type="button" mat-icon-button class="btnGray" matTooltip="Approve"\r\n                            (click)="GetEmployeeDetails(row.uid)">\r\n                        <i class="fa fa-check" aria-hidden="true"></i>\r\n                    </button>\r\n\r\n                </mat-cell>\r\n            </ng-container>--\x3e\r\n\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="redirectToUpdateSkillPack(row)"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!--Recruitment--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblRecuitment && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length">\r\n                        <ng-container matColumnDef="select">\r\n                            <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                                <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                              [checked]="selection.hasValue() && isEntirePageSelected()"\r\n                                              [indeterminate]="selection.hasValue() && !isEntirePageSelected()"\r\n                                              [aria-label]="checkboxLabel()">\r\n                                </mat-checkbox>\r\n                            </mat-header-cell>\r\n                            <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                                <mat-checkbox (click)="$event.stopPropagation()"\r\n                                              (change)="$event ? selection.toggle(row) : null"\r\n                                              [checked]="selection.isSelected(row)">\r\n                                </mat-checkbox>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!--<ng-container matColumnDef="select">\r\n                <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                    <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                  [checked]="selection.hasValue() && isAllSelected()"\r\n                                  [indeterminate]="selection.hasValue() && !isAllSelected()">\r\n                    </mat-checkbox>\r\n                </mat-header-cell>\r\n                <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                    <mat-checkbox (click)="$event.stopPropagation()"\r\n                                  (change)="$event ? selection.toggle(row) : null"\r\n                                  [checked]="selection.isSelected(row)">\r\n                    </mat-checkbox>\r\n                </mat-cell>\r\n            </ng-container>--\x3e\r\n\r\n                        <ng-container matColumnDef="reqno">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="rcReqno"> Req no </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="rcReqno">\r\n                                {{element.id}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- tenantName Column --\x3e\r\n                        <ng-container matColumnDef="tenantName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="rcTenantName"> Organization </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="rcTenantName"> {{element.organization}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="client">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Client Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.clientName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Name Column --\x3e\r\n                        <ng-container matColumnDef="goc">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="rcGoc"> Project Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" class="rcGoc"> {{element.goc}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- designation Column --\x3e\r\n                        <ng-container matColumnDef="designation">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Designation </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.designation}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- skills Column --\x3e\r\n                        <ng-container matColumnDef="skills">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Skills </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.skills}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- noopen Column --\x3e\r\n                        <ng-container matColumnDef="noopen">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> No of Openings </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.noofOpening}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- status Column --\x3e\r\n                        <ng-container matColumnDef="statusRec">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Status </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">{{(element.status)? (\'Pending with \'+ element.status): (element.status)}}</mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- Action--\x3e\r\n                        <ng-container matColumnDef="Action">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Action </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                <button class="btnIcon" mat-icon-button type="button"\r\n                                        matTooltip="View" (click)="onRecruitmentRequestClick(element,1)">\r\n                                    <i class="fa fa-search" aria-hidden="true"></i>\r\n                                </button>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="onRecruitmentRequestClick(row)"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!--ELM--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblELM && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length">\r\n                        \x3c!-- empid Column --\x3e\r\n                        <ng-container matColumnDef="employeeNo">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Id </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.employeeNo}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- empname Column --\x3e\r\n                        <ng-container matColumnDef="fullName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- depatment Column --\x3e\r\n                        <ng-container matColumnDef="depatment">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Department/Client</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.departmentClient}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- grade Column --\x3e\r\n                        <ng-container matColumnDef="grade">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Grade </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.grade}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- resigndate Column --\x3e\r\n                        <ng-container matColumnDef="resigndate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Resignation Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.resignationDate | date }} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- relivedate Column --\x3e\r\n                        <ng-container matColumnDef="relivedate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Relieving Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.relievingDate | date }} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="action">\r\n                            <mat-header-cell *matHeaderCellDef> Action </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                <button type="button" mat-icon-button class="btnGray" matTooltip="View" (click)="openManagerApprovalView(element)"><i class="fa fa-search" aria-hidden="true"></i></button>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource?.filteredData.length === 0">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!--Onboarding--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblOnBoarding && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" *ngIf="dataSource.data.length">\r\n                        <ng-container matColumnDef="id">\r\n                            <mat-header-cell *matHeaderCellDef> Candidate Request Id </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                RIN-{{element.id}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="fullName">\r\n                            <mat-header-cell *matHeaderCellDef> Full Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="mobileNumber">\r\n                            <mat-header-cell *matHeaderCellDef> Mobile Number </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.mobileNumber}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="candidateStatus">\r\n                            <mat-header-cell *matHeaderCellDef> Candidate Status </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">  {{ getStatusValue(element.candidateStatus) }} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="gender">\r\n                            <mat-header-cell *matHeaderCellDef> Gender </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.gender}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="country">\r\n                            <mat-header-cell *matHeaderCellDef> Country </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.country}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="viewCandidateDetails(row.id)">\r\n                        </mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource?.filteredData.length === 0">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!--Project--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblProject && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" *ngIf="dataSource.data.length">\r\n                        \x3c!-- empid Column --\x3e\r\n                        <ng-container matColumnDef="empid">\r\n                            <mat-header-cell *matHeaderCellDef> Employee Id </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.employeeNo}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- empname Column --\x3e\r\n                        <ng-container matColumnDef="empname">\r\n                            <mat-header-cell *matHeaderCellDef> Employee Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- projectname Column --\x3e\r\n                        <ng-container matColumnDef="projectname">\r\n                            <mat-header-cell *matHeaderCellDef> Project Name</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.projectName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="employeeType">\r\n                            <mat-header-cell *matHeaderCellDef> Employee Type</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.employeeType}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- track Column --\x3e\r\n                        <ng-container matColumnDef="allocationStartDate">\r\n                            <mat-header-cell *matHeaderCellDef>Allocation Start Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.allocationStartDate}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- subtrack Column --\x3e\r\n                        <ng-container matColumnDef="allocationEndDate">\r\n                            <mat-header-cell *matHeaderCellDef> Allocation End Date</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.allocationEndDate}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- billing_type Column --\x3e\r\n                        <ng-container matColumnDef="billing_type">\r\n                            <mat-header-cell *matHeaderCellDef> Billing Type </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.billableType}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="!dataSource?.filteredData.length">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!--SR--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblServiceDesk && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length">\r\n                        <ng-container matColumnDef="select">\r\n                            <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                                <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                              [checked]="selection.hasValue() && isEntirePageSelected()"\r\n                                              [indeterminate]="selection.hasValue() && !isEntirePageSelected()"\r\n                                              [aria-label]="checkboxLabel()">\r\n                                </mat-checkbox>\r\n                            </mat-header-cell>\r\n                            <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                                <mat-checkbox (click)="$event.stopPropagation()"\r\n                                              (change)="$event ? selection.toggle(row) : null"\r\n                                              [checked]="selection.isSelected(row)">\r\n                                </mat-checkbox>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!--<ng-container matColumnDef="select">\r\n                <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                    <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                  [checked]="selection.hasValue() && isAllSelected()"\r\n                                  [indeterminate]="selection.hasValue() && !isAllSelected()">\r\n                    </mat-checkbox>\r\n                </mat-header-cell>\r\n                <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                    <mat-checkbox (click)="$event.stopPropagation()"\r\n                                  (change)="$event ? selection.toggle(row) : null"\r\n                                  [checked]="selection.isSelected(row)">\r\n                    </mat-checkbox>\r\n                </mat-cell>\r\n            </ng-container>--\x3e\r\n                        \x3c!-- SR ID Column --\x3e\r\n                        <ng-container matColumnDef="incidentID">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>SR No</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                {{element.incidentNo}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Logged Time Column --\x3e\r\n                        <ng-container matColumnDef="loggedTime">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Logged Time </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.loggedTime)}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Status Column --\x3e\r\n                        <ng-container matColumnDef="statusServiceDesk">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Service Type </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                {{element.serviceType}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- caller Column --\x3e\r\n                        <ng-container matColumnDef="caller">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Caller </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.callerName}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- remaingsla Column --\x3e\r\n                        <ng-container matColumnDef="remaingsla">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Department </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.departmentName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n\r\n\r\n                        \x3c!--Workgroup Column\r\n            <ng-container matColumnDef="workgroup">\r\n                <mat-header-cell *matHeaderCellDef mat-sort-header> Category </mat-header-cell>\r\n                <mat-cell *matCellDef="let element"> {{element.catalogueName}} </mat-cell>\r\n            </ng-container>--\x3e\r\n                        \x3c!-- Symptom Column --\x3e\r\n                        <ng-container matColumnDef="symptom">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Sub Category </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">{{element.workGroupName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="requestDesc">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Request Description </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                <span *ngIf="!element.showMore">\r\n                                    {{trimString(element.description,20)}}\r\n                                </span>\r\n                                <span *ngIf="element.showMore">\t{{element.description}} </span>\r\n                                <a *ngIf="element.description.length > 20" (click)="element.showMore = !element.showMore">\r\n                                    Show\r\n                                    <span>{{element.showMore?\'less\':\'more\'}}</span>\r\n                                </a>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        <ng-container matColumnDef="remarks">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Remarks </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                <span *ngIf="!element.showMore1">\r\n                                    {{trimString(element.symptom,20)}}\r\n                                </span>\r\n                                <span *ngIf="element.showMore1">\t{{element.symptom}} </span>\r\n                                <a *ngIf="element.symptom.length > 20" (click)="element.showMore1 = !element.showMore1">\r\n                                    Show\r\n                                    <span>{{element.showMore1?\'less\':\'more\'}}</span>\r\n                                </a>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- Action Coloumn--\x3e\r\n                        <ng-container matColumnDef="Action">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Action </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                <button class="btnIcon" mat-icon-button type="button"\r\n                                        matTooltip="View" (click)="onIncidentClick(element.id,element.serviceType,element.departmentName,element.displayCategoryId,1)">\r\n                                    <i class="fa fa-search" aria-hidden="true"></i>\r\n                                </button>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclickNo\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource?.filteredData.length === 0 && !displayMsg">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!--VISA--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblVisa && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length">\r\n                        <ng-container matColumnDef="select">\r\n                            <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                                <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                              [checked]="selection.hasValue() && isEntirePageSelected()"\r\n                                              [indeterminate]="selection.hasValue() && !isEntirePageSelected()"\r\n                                              [aria-label]="checkboxLabel()">\r\n                                </mat-checkbox>\r\n                            </mat-header-cell>\r\n                            <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                                <mat-checkbox (click)="$event.stopPropagation()"\r\n                                              (change)="$event ? selection.toggle(row) : null"\r\n                                              [checked]="selection.isSelected(row)">\r\n                                </mat-checkbox>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!--<ng-container matColumnDef="select">\r\n                <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                    <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                  [checked]="selection.hasValue() && isAllSelected()"\r\n                                  [indeterminate]="selection.hasValue() && !isAllSelected()">\r\n                    </mat-checkbox>\r\n                </mat-header-cell>\r\n                <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                    <mat-checkbox (click)="$event.stopPropagation()"\r\n                                  (change)="$event ? selection.toggle(row) : null"\r\n                                  [checked]="selection.isSelected(row)">\r\n                    </mat-checkbox>\r\n                </mat-cell>\r\n            </ng-container>--\x3e\r\n                        \x3c!-- requestno ID Column --\x3e\r\n                        <ng-container matColumnDef="requestno">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Request No </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">{{element.id}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Visa Request Date Column --\x3e\r\n                        <ng-container matColumnDef="requestdate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Visa Request Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.visaRequestDate)}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Status Column --\x3e\r\n                        <ng-container matColumnDef="statusVisa">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Status </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.status}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Emp Name Column --\x3e\r\n                        <ng-container matColumnDef="fullName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Country Column --\x3e\r\n                        <ng-container matColumnDef="country">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Country </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.countryName}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- Visa Type Column --\x3e\r\n                        <ng-container matColumnDef="visatype">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Visa Type </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.visaType}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="Action">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> View </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                <button class="btnIcon" mat-icon-button type="button"\r\n                                        matTooltip="View" (click)="visaItemClick(element.id, 1)">\r\n                                    <i class="fa fa-search" aria-hidden="true"></i>\r\n                                </button>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="visaItemClick(row.id, row.approvalLevel)"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource?.filteredData.length === 0 && !displayMsg">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n                \x3c!----\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblCoreHR && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" *ngIf="dataSource.data.length">\r\n                        \x3c!-- emp_id Column --\x3e\r\n                        <ng-container matColumnDef="candidate_id">\r\n                            <mat-header-cell *matHeaderCellDef> Candidate ID </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                Candidate-{{element.id}}\x3c!--expenseNo--\x3e\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="rin_no">\r\n                            <mat-header-cell *matHeaderCellDef> RIN Number </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> Rin-{{element.recruitmentMasterId}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- fullname Column --\x3e\r\n                        <ng-container matColumnDef="fullname">\r\n                            <mat-header-cell *matHeaderCellDef> Candidate Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.candidateFullName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- bu Column --\x3e\r\n                        <ng-container matColumnDef="bu">\r\n                            <mat-header-cell *matHeaderCellDef> BU </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.buName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- sbu Column --\x3e\r\n                        <ng-container matColumnDef="sbu">\r\n                            <mat-header-cell *matHeaderCellDef> SBU </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.sbuName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- doj Column --\x3e\r\n                        <ng-container matColumnDef="client">\r\n                            <mat-header-cell *matHeaderCellDef> Client Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.clientName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="project">\r\n                            <mat-header-cell *matHeaderCellDef> Project Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.projectName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- reportingmanager Column --\x3e\r\n                        <ng-container matColumnDef="reportingmanager">\r\n                            <mat-header-cell *matHeaderCellDef> Reporting Manager </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.reportingManagerName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="onCandidateListClick(row.id,row.recruitmentMasterId, row.reportingManagerName)"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0 && !displayMsg">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n\r\n                </div>\r\n                \x3c!--PR/PO--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="(tblPR || tblPO) && !displayMsg">\r\n                    <mat-tab-group class="procurement_PR-PO" (selectedTabChange)="tabChanged($event)">\r\n\r\n                        <mat-tab>\r\n                            <ng-template mat-tab-label>\r\n                                <mat-icon class="example-tab-icon">call_missed_outgoing</mat-icon>\r\n                                Purchase Request\r\n                            </ng-template>\r\n\r\n                            <mat-table #table [dataSource]="dataSource" matSort matSortDisableClear matSortDirection="asc" *ngIf="dataSource?.filteredData.length && tblPR">\r\n\r\n                                \x3c!-- prid Column --\x3e\r\n                                <ng-container matColumnDef="prNumber">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header> PR Id </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.prNumber}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                \x3c!-- client Column --\x3e\r\n                                <ng-container matColumnDef="fullName">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header> Requester Name </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                \x3c!-- client Column --\x3e\r\n                                <ng-container matColumnDef="clientName">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header> Client Name </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.clientName}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                \x3c!-- bu Column --\x3e\r\n                                <ng-container matColumnDef="buName">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header> BU </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.buName}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                \x3c!-- PR Creation Column --\x3e\r\n                                <ng-container matColumnDef="prDate">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header> PR Creation Date </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.prDate| date:\'dd MMM yyy\'}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                <ng-container matColumnDef="totalPRAmount">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header> PR Amount </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element" style="text-align:right;">\r\n                                        {{\r\n                                                element.prCurrency == \'INR\'\r\n                                                ? (element.totalPRAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2 }))\r\n                                                : element.prCurrency == \'USD\'\r\n                                                ? (element.totalPRAmount | currency)\r\n                                                : element.prCurrency == \'NPR\'\r\n                                                ? (element.totalPRAmount.toLocaleString(\'en-NP\', { style: \'currency\', currency: \'NPR\', maximumFractionDigits: 2 }))\r\n                                                : element.totalPRAmount\r\n                                        }}\r\n                                    </mat-cell>\r\n                                </ng-container>\r\n\r\n                                \x3c!-- projectname Column --\x3e\r\n                                <ng-container matColumnDef="projectName">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header> Project Name </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.projectName}} </mat-cell>\r\n                                </ng-container>\r\n                                \x3c!-- budgetno Column --\x3e\r\n                                <ng-container matColumnDef="budgetno">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header> PR Type </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.prType}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                <ng-container matColumnDef="displayAddress">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header> PR Location </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.displayAddress}} </mat-cell>\r\n                                </ng-container>\r\n\r\n\r\n                                <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                                <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="onPRDetailClick(row.id)"></mat-row>\r\n                            </mat-table>\r\n                            <div *ngIf="dataSource.data.length === 0 && !loadingMessage">\r\n                                <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                            </div>\r\n                            <div *ngIf="loadingMessage">\r\n                                <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">Please wait...</h4>\r\n                            </div>\r\n\r\n                        </mat-tab>\r\n\r\n                        <mat-tab>\r\n                            <ng-template mat-tab-label>\r\n                                <mat-icon class="example-tab-icon">call_missed</mat-icon>\r\n                                Purchase Order\r\n                            </ng-template>\r\n\r\n                            <mat-table #table [dataSource]="dataSource" matSort matSortDisableClear matSortDirection="asc" *ngIf="dataSource?.filteredData.length && tblPO">\r\n\r\n                                <ng-container matColumnDef="purchaseOrderNumber">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header style="text-align:center;"> PO Number </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.purchaseOrderNumber}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                <ng-container matColumnDef="employeeName">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header style="text-align:center;"> Requester Name </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.employeeName}} </mat-cell>\r\n                                </ng-container>\r\n\r\n\r\n\r\n                                \x3c!--<ng-container matColumnDef="prType">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header style="text-align:center;"> PO Type </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.prCategory}} </mat-cell>\r\n                    </ng-container>--\x3e\r\n                                \x3c!-- client Column --\x3e\r\n                                <ng-container matColumnDef="vendorCompanyName">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header style="text-align:center;"> Vendor Company </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.vendorCompanyName}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                <ng-container matColumnDef="pOdate">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header style="text-align:center;"> PO Date</mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.pOdate ?(element.pOdate | date:\'dd MMM yyy\'):\'NA\'}} </mat-cell>\r\n                                </ng-container>\r\n                                \x3c!-- bu Column --\x3e\r\n                                <ng-container matColumnDef="poStartdate">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header style="text-align:center;"> PO Start Date</mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.poStartdate ?(element.poStartdate | date:\'dd MMM yyy\'):\'NA\'}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                \x3c!-- sbu Column --\x3e\r\n                                <ng-container matColumnDef="poEnddate">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header style="text-align:center;"> PO End Date </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.poEnddate? (element.poEnddate | date:\'dd MMM yyy\'):\'NA\'}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                <ng-container matColumnDef="requiredDeliverydate">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header style="text-align:center;">Required Delivery Date </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.requiredDeliverydate? (element.requiredDeliverydate | date:\'dd MMM yyy\'):\'NA\'}} </mat-cell>\r\n                                </ng-container>\r\n\r\n                                <ng-container matColumnDef="totalPOAmount">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header style="text-align:center;">Total Amount </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element" style="text-align:right;">\r\n                                        {{\r\n                                      element.poCurrency == \'INR\'\r\n                                     ?(element.totalPOAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2}))\r\n                                     : element.poCurrency == \'USD\'\r\n                                     ?(element.totalPOAmount | currency)\r\n                                     : element.poCurrency == \'NPR\'\r\n                                     ? (element.totalPOAmount.toLocaleString(\'en-NP\', { style: \'currency\', currency: \'NPR\', maximumFractionDigits: 2 }))\r\n                                     :element.totalPOAmount\r\n                                        }}\r\n                                    </mat-cell>\r\n                                </ng-container>\r\n\r\n                                <ng-container matColumnDef="poLocationValue">\r\n                                    <mat-header-cell *matHeaderCellDef mat-sort-header style="text-align:center;">PO Location </mat-header-cell>\r\n                                    <mat-cell *matCellDef="let element"> {{element.poLocationValue}} </mat-cell>\r\n                                </ng-container>\r\n\r\n\r\n                                <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                                <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="onPODetailClick(row)"></mat-row>\r\n                            </mat-table>\r\n\r\n                            <div *ngIf="dataSource.data.length === 0 && !loadingMessage">\r\n                                <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                            </div>\r\n\r\n                            <div *ngIf="loadingMessage">\r\n                                <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">Please wait...</h4>\r\n                            </div>\r\n\r\n                        </mat-tab>\r\n                    </mat-tab-group>\r\n                </div>\r\n                \x3c!--BU Head Approval--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblBUHead && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource?.filteredData.length">\r\n\r\n                        \x3c!-- rinno Column --\x3e\r\n                        <ng-container matColumnDef="rinno">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> RIN No </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.recruitmentMasterId}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- candidatename Column --\x3e\r\n                        <ng-container matColumnDef="candidatename">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Candidate Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.candidateName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="designation">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Designation </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.designation}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="client">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Client Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.clientName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="project">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Project Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.projectName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- buname Column --\x3e\r\n                        <ng-container matColumnDef="totalexp">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Total Experience</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.totalYearsExperience}} Years</mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- clientname Column --\x3e\r\n                        <ng-container matColumnDef="joiningdate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Joining Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.joiningDate)}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- project Column --\x3e\r\n                        <ng-container matColumnDef="mandatoryskills">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Candidate Mandatory Skills </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.candidateMandatorySkills}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Current Column --\x3e\r\n                        <ng-container matColumnDef="currentCTC">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Current CTC </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.currentCTC == 0?\'NA\':element.currentCTC}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- hrctc Column --\x3e\r\n                        <ng-container matColumnDef="hrctc">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> HR CTC </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.hrctc}} </mat-cell>\r\n                        </ng-container>\r\n\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="onBUHeadDetailsClick(row)"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0 && !displayMsg">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n\r\n                </div>\r\n                \x3c!--Movement--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblMovement && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort matSortDisableClear matSortDirection="asc" *ngIf="dataSource?.filteredData.length">\r\n                        \x3c!-- empid Column --\x3e\r\n                        <ng-container matColumnDef="employeeNumber">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Id </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                {{element.employeeNumber}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- empname Column --\x3e\r\n                        <ng-container matColumnDef="employeeName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.employeeName}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- reporting manger Column --\x3e\r\n                        <ng-container matColumnDef="reportingManager">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Reporting Manager</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.reportingManager}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- billability Column --\x3e\r\n                        \x3c!-- request status Column --\x3e\r\n                        <ng-container matColumnDef="requestStatus">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Status</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                {{element.requestStatus == \'1\' ? "Pending with Review Manager" : element.requestStatus == \'2\' ? "Pending with New Project Manager" : ""}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- movement type Column --\x3e\r\n                        <ng-container matColumnDef="movementType">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Movement Type </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">{{element.movementType}}</mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- release date Column --\x3e\r\n                        <ng-container matColumnDef="releasedDate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Release Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.releasedDate)}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- action Column --\x3e\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="onMovementClick(row.empMovementId, row.employeeUID)"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0 && !displayMsg">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n\r\n                </div>\r\n                \x3c!--Bill Register--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblBillRegisterBillMaster && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort matSortDisableClear matSortDirection="asc" *ngIf="dataSource?.filteredData.length">\r\n                        \x3c!-- PoNo Column --\x3e\r\n                        <ng-container matColumnDef="poNo">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> PO No. </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                {{element.poNo}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- Bill Number Column --\x3e\r\n                        <ng-container matColumnDef="billNo">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Bill No. </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.billNo}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- Vendor Column --\x3e\r\n                        <ng-container matColumnDef="vendor">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Vendor</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.vendorName}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- Utility Column --\x3e\r\n                        <ng-container matColumnDef="utility">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Utility</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                {{element.utilityName}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- Activity Column --\x3e\r\n                        <ng-container matColumnDef="activity">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Activity </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">{{element.activityName}}</mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- release date Column --\x3e\r\n                        <ng-container matColumnDef="location">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Location </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.locationName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="billStatus">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Bill Status </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">{{element.billStatus}}</mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="createdBy">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Created By </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">{{element.employeeName}}</mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="createdDate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Created Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">{{element.createdDate}}</mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- action Column --\x3e\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="OnBillsClick(row.bill_ID,row.approvalLevel,row.billRegisterApprovalDetailsId)"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0 && !displayMsg">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                \x3c!--ELM--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblresignation && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort matSortDisableClear matSortDirection="asc" *ngIf="dataSource?.filteredData.length">\r\n                        <ng-container matColumnDef="employeeId">\r\n                            <mat-header-cell *matHeaderCellDef showColumn showInput="none" mat-sort-header> Employee Id </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" showColumn showInput="none"> {{element.employeeId}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- empid Column --\x3e\r\n                        <ng-container matColumnDef="employeeNumber">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee No </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                <a (click)="openHRApprovalView(element)">{{element.employeeNumber}}</a>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- empname Column --\x3e\r\n                        <ng-container matColumnDef="employeeName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.employeeName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- depatment Column --\x3e\r\n                        <ng-container matColumnDef="mobile">\r\n                            <mat-header-cell *matHeaderCellDef> Mobile No</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.mobile}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- Visible for India Tenants Start--\x3e\r\n                        \x3c!-- resigndate Column --\x3e\r\n                        <ng-container matColumnDef="resignationDate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Resignation Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.resignationDate) }} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- relivedate Column --\x3e\r\n                        <ng-container matColumnDef="relievingDate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Relieving Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{_timesheetService.getFormattedDate(element.relievingDate)}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- attrition_type Column --\x3e\r\n                        <ng-container matColumnDef="resignationReasonEmployee">\r\n                            <mat-header-cell *matHeaderCellDef> Attrition Type</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.resignationReasonEmployee }} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- action Column --\x3e\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row [ngClass]="bulkBtn === false ? \'sclick\' : \'sclickNo\'" *matRowDef="let row; columns: displayedColumns;" (click)="openManagerApprovalView(row)"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0 && !displayMsg">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n\r\n                </div>\r\n                \x3c!--Project Request--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblProjectRequest && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" *ngIf="dataSource.data.length">\r\n                        \x3c!-- projectid Column --\x3e\r\n                        <ng-container matColumnDef="projectid">\r\n                            <mat-header-cell *matHeaderCellDef>Project Request Id </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" (click)="$event.stopPropagation()">\r\n\r\n                                {{element.projectNumber}}\r\n\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- clientname Column --\x3e\r\n                        <ng-container matColumnDef="clientname">\r\n                            <mat-header-cell *matHeaderCellDef> Client Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.clientName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- projectname Column --\x3e\r\n                        <ng-container matColumnDef="projectname">\r\n                            <mat-header-cell *matHeaderCellDef> Project Name</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.projectName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- startdate Column --\x3e\r\n                        <ng-container matColumnDef="startdate">\r\n                            <mat-header-cell *matHeaderCellDef> Start Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{this._timesheetService.getFormattedDate(element.startDate)}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- enddate Column --\x3e\r\n                        <ng-container matColumnDef="enddate">\r\n                            <mat-header-cell *matHeaderCellDef> End Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{this._timesheetService.getFormattedDate(element.endDate)}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!--status Column--\x3e\r\n                        <ng-container matColumnDef="projectinitiationStatus">\r\n                            <mat-header-cell *matHeaderCellDef> Status </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.projectInitiationStatusValue}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- manager Column --\x3e\r\n                        <ng-container matColumnDef="manager">\r\n                            <mat-header-cell *matHeaderCellDef> Manager </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="action">\r\n                            <mat-header-cell *matHeaderCellDef> Action </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element">\r\n                                <button class="btnIcon" mat-icon-button type="button"\r\n                                        matTooltip="View" (click)="viewProjectOnButtonClick(element)">\r\n                                    <i class="fa fa-search" aria-hidden="true"></i>\r\n                                </button>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="!dataSource?.filteredData.length">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n\r\n                \x3c!-- Payout--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblPayout && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length">\r\n                        <ng-container matColumnDef="select">\r\n                            <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                                <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                              [checked]="selection.hasValue() && isEntirePageSelected()"\r\n                                              [indeterminate]="selection.hasValue() && !isEntirePageSelected()"\r\n                                              [aria-label]="checkboxLabel()">\r\n                                </mat-checkbox>\r\n                            </mat-header-cell>\r\n                            <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                                <mat-checkbox (click)="$event.stopPropagation()"\r\n                                              (change)="$event ? selection.toggle(row) : null"\r\n                                              [checked]="selection.isSelected(row)">\r\n                                </mat-checkbox>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="employeeNo">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>RM Employee No </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" matTooltip="View Details">\r\n                                <a (click)="popupTimesheetPayoutData(element)">{{element.EmployeeNo}}</a>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="name">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>RM Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.FullName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="Amount">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Total Amount</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" style="text-align:right;"> {{element.Amount}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="Status">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Status</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.Status}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="SubmittedOn">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Submitted On</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.SubmittedOn}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="Month">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Month</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.MonthName}} </mat-cell>\r\n                        </ng-container>\r\n                        <ng-container matColumnDef="Year">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Year</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.Year}} </mat-cell>\r\n                        </ng-container>\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n\r\n                \x3c!-- New Timesheet--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblTimesheetV2 && !displayMsg">\r\n                    <mat-table #table [dataSource]="dataSource" matSort *ngIf="dataSource.data.length">\r\n                        <ng-container matColumnDef="select">\r\n                            <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                                <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                              [checked]="selection.hasValue() && isEntirePageSelected()"\r\n                                              [indeterminate]="selection.hasValue() && !isEntirePageSelected()"\r\n                                              [aria-label]="checkboxLabel()">\r\n                                </mat-checkbox>\r\n                            </mat-header-cell>\r\n                            <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                                <mat-checkbox (click)="$event.stopPropagation()"\r\n                                              (change)="$event ? selection.toggle(row) : null"\r\n                                              [checked]="selection.isSelected(row)">\r\n                                </mat-checkbox>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="employeeName">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Employee Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" matTooltip="View Details">\r\n                                {{element.employeeName}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="empID">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Employee No </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.empID}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="project">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Project</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.project}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="weekenddate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Weekend Date</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.weekenddate}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="SubmittedOn">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Submitted On</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.submitedOn}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="totalHrs">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Total Hours</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" style="text-align:center"> {{element.totalHrs  | number:\'2.2-2\'}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="totalworkHrs">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Total Worked Hours </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" style="text-align:center"> {{element.totalworkHrs   | number:\'2.2-2\'}} </mat-cell>\r\n\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="totalnonworkHrs">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Total Non-Worked Hours</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" style="text-align:center"> {{element.totalHrs - element.totalworkHrs   | number:\'2.2-2\'}} </mat-cell>\r\n\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="action">\r\n                            <mat-header-cell *matHeaderCellDef> Actions </mat-header-cell>\r\n                            <mat-cell mat-cell *matCellDef="let element">\r\n                                <button class="btnIcon" mat-icon-button type="button"\r\n                                        matTooltip="View" (click)="openDialogviewTimesheetV2(element)" style="width: 30px">\r\n                                    <i class="fa fa-search" aria-hidden="true"></i>\r\n                                </button>\r\n                                <button class="btnIcon" mat-icon-button type="button"\r\n                                        matTooltip="Approve" (click)="ApproveByManager(1,element)" style="width: 30px">\r\n                                    <i class="fa fa-check" aria-hidden="true"></i>\r\n                                </button>\r\n                                <button class="btnIcon" mat-icon-button type="button"\r\n                                        matTooltip="Reject" (click)="ApproveByManager(0,element)" style="width: 30px">\r\n                                    <i class="fa fa-remove" aria-hidden="true"></i>\r\n                                </button>\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n                    </mat-table>\r\n                    <div *ngIf="dataSource.data.length === 0">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                    </div>\r\n                </div>\r\n\r\n                \x3c!-- PO Sign Off--\x3e\r\n                <div class="vendor-list-container mat-elevation-z8" *ngIf="tblPoSignOff && !displayMsg">\r\n\r\n                    <mat-table #table [dataSource]="dataSource" matSort matSortDirection="asc" *ngIf="dataSource?.filteredData.length">\r\n\r\n                        <ng-container matColumnDef="poNumber">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> PO Number </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" matTooltip="View Details">\r\n                                {{element.PurchaseOrderNumber}}\r\n                            </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="requester">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Requester Name </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.fullname}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="poLocation">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>PO Location </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.POLocationValue}} </mat-cell>\r\n                        </ng-container>\r\n                        \x3c!-- client Column --\x3e\r\n                        <ng-container matColumnDef="vendorCompany">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Supplier </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.VendorCompanyName}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="totalAmount">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header class="poAmount">Total Amount </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" style="text-align:right;flex:0 9%"> {{element.POCurrency == \'INR\'?(element.TotalPOAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):element.poCurrency == \'USD\'?(element.TotalPOAmount | currency):element.TotalPOAmount}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="deliveryDate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> Delivery Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.deliveryDate | date:\'dd MMM yyy\'}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="poDate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> PO Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.PODate | date:\'dd MMM yyy\'}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="poStartDate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> PO Start Date</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.POStartdate != \'0001-01-01T00:00:00\' ?(element.POStartdate | date:\'dd MMM yyy\'):\'NA\'}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!-- sbu Column --\x3e\r\n                        <ng-container matColumnDef="poEndDate">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header> PO End Date </mat-header-cell>\r\n                            <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.POEnddate != \'0001-01-01T00:00:00\' ?(element.POEnddate | date:\'dd MMM yyy\'):\'NA\'}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="billAddress">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Ship To Address</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.billAddress}} </mat-cell>\r\n                        </ng-container>\r\n                        <ng-container matColumnDef="PRNumber">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>PR No.</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.PurchaseRequestType}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        \x3c!--<ng-container matColumnDef="poStatus">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Status</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.PurchaseOrderStatusValue}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="redraftRemarks">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Re-Draft Remarks</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.redraftRemarks}} </mat-cell>\r\n                        </ng-container>\r\n\r\n                        <ng-container matColumnDef="closedRemarks">\r\n                            <mat-header-cell *matHeaderCellDef mat-sort-header>Closed Remarks</mat-header-cell>\r\n                            <mat-cell *matCellDef="let element"> {{element.POClosedRemarks}} </mat-cell>\r\n                        </ng-container>--\x3e\r\n\r\n                        <ng-container matColumnDef="action">\r\n                            <mat-header-cell class="po-action" *matHeaderCellDef> Action </mat-header-cell>\r\n                            <mat-cell class="po-action" *matCellDef="let element">\r\n\r\n                                <button style="width:22px;" type="button" mat-icon-button class="btnIcon" matTooltip="Unsigned pdf" *ngIf="Issigned==0" (click)="UnsignedPO(element)">\r\n                                    <i style="color:#FFBF00;font-size:13px" class="fa fa-file-pdf-o"></i>\r\n                                </button>\r\n                                <button style="width:22px;" type="button" mat-icon-button class="btnIcon" matTooltip="Unsigned annexure" *ngIf="(Issigned==0) && (element.AnxUnSigned==1)" (click)="UnsignedAnnexure(element)">\r\n                                    <i style="color:#FFBF00;font-size:13px" class="fa fa-file-pdf-o"></i>\r\n                                </button>\r\n\r\n                                <button style="width:22px;" class="btnIcon" mat-icon-button type="button" matTooltip="View Details" (click)="onPODetailClickPOSignOff(element,\'view\')">\r\n                                    <i style="font-size:13px" class="fa fa-search" aria-hidden="true"></i>\r\n                                </button>\r\n                                <button style="width:22px;" type="button" mat-icon-button class="btnIcon" matTooltip="Generate Signed PDF" *ngIf="Issigned==0" (click)="exportPDF(element)">\r\n                                    \x3c!--<i style="font-size:13px" class="fa fa-file-pdf-o" aria-hidden="true"></i>--\x3e\r\n                                    <i style="font-size:13px" class="fa fa-file-code-o" aria-hidden="true"></i>\r\n                                </button>\r\n\r\n\r\n\r\n                                <button style="width:22px;" type="button" mat-icon-button class="btnIcon" matTooltip="Signed pdf" *ngIf="Issigned==1" (click)="viewFile(element)">\r\n                                    <i style="color:#08f308;font-size:13px" class="fa fa-file-pdf-o"></i>\r\n                                </button>\r\n                                <button style="width:22px;" type="button" mat-icon-button class="btnIcon" matTooltip="Signed annexure" *ngIf="(Issigned==1) && (element.AnxUnSigned==1)" (click)="viewannexurefile(element)">\r\n                                    <i style="color:#08f308;font-size:13px" class="fa fa-file-pdf-o"></i>\r\n                                </button>\r\n\r\n                            </mat-cell>\r\n\r\n\r\n                        </ng-container>\r\n                        \x3c!--&& !row.isAmmendmentCreated--\x3e\r\n\r\n\r\n                        <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                        <mat-row class="sclick" *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n\r\n                        \x3c!--<ng-container matColumnDef="reDraftRemarks">\r\n            <mat-header-cell *matHeaderCellDef mat-sort-header>Re-Draft Remarks </mat-header-cell>\r\n            <mat-cell *matCellDef="let element"> {{element.redraftRemarks}} </mat-cell>\r\n        </ng-container>--\x3e\r\n                        \x3c!-- action Column --\x3e\r\n                        \x3c!--.purchaseOrderMasterId,element.purchaseRequestType, element.purchaseOrderStatus,element.accountManagerStatus,element.financeManagerStatus--\x3e\r\n                        \x3c!--<ng-container matColumnDef="action">\r\n            <mat-header-cell *matHeaderCellDef class="action-colms"> Action </mat-header-cell>\r\n            <mat-cell *matCellDef="let element" class="action-colms">\r\n                <button type="button" mat-icon-button class="btnGray" (click)="onPODetailClick(element)"\r\n                        matTooltip="View">\r\n                    <i class="fa fa-search" aria-hidden="true"></i>\r\n                </button>\r\n\r\n\r\n            </mat-cell>\r\n        </ng-container>--\x3e\r\n                        \x3c!--<button *ngIf="element.purchaseRequestType == \'Consultant\' && element.purchaseOrderStatusValue == \'Approved\'" type="button" mat-icon-button class="btnGray" (click)="onUpdatePODetailClick(element.purchaseOrderMasterId,element.purchaseRequestType, element.purchaseOrderStatus)"\r\n                matTooltip="Update Funding">\r\n            <i class="fa fa-edit" aria-hidden="true"></i>\r\n        </button>--\x3e\r\n\r\n                    </mat-table>\r\n                </div>\r\n                </div>\r\n\r\n                \x3c!--<div *ngIf="displayMsg">\r\n        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">Employee Request data loading is in progress....</h4>\r\n    </div>--\x3e\r\n</mat-card-content>\r\n    </mat-card>\r\n</div>\r\n<div class="loading-shade" *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>\r\n'},function(e,t,n){var r=n(1003);e.exports="string"==typeof r?r:r.toString()},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,".grad {\r\n    color: #2b2929;\r\n    opacity: 0.95;\r\n    margin: 0px 10px 0px 0px;\r\n    padding: 12px;\r\n    width: 15.8%;\r\n    /*background-color: #ffffff;*/\r\n    overflow: hidden;\r\n    /*min-height: 135px;*/\r\n    /*font-weight: bold;*/  \r\n    cursor: pointer;\r\n}\r\n\r\nmat-icon.view {\r\n    color: #878181;\r\n    cursor: pointer;\r\n}\r\n\r\n.grid-1 {\r\n    /*background-color: #68b828;*/\r\n    /*background-image: linear-gradient(141deg, #0c0c0c 0%, #1fc8db 51%, #2cb5e8 75%);*/\r\n}\r\n\r\n.grid-2 {\r\n    /*background-color: #f7aa47;*/\r\n    /*background-image: linear-gradient(141deg, #0c0c0c 0%, #c5b124 51%, #e8c82c 75%);*/\r\n}\r\n\r\n.grid-3 {\r\n    /*background-color: #0e62c7;*/\r\n    /*background-image: linear-gradient(141deg, #0c0c0c 0%, #7824c5 51%, #632ce8 75%);*/\r\n}\r\n\r\n.grid-4 {\r\n    /*background-color: #ff6264;*/\r\n    /*background-image: linear-gradient(141deg, #0c0c0c 0%, #9dc524 51%, #d4e82c 75%);*/\r\n}\r\n\r\n.grid-5 {\r\n    /*background-color: #00b19d;*/\r\n    /*background-image: linear-gradient(141deg, #0c0c0c 0%, #c52451 51%, #e82c35 75%);*/\r\n}\r\n\r\n.grid-9 {\r\n    /*background-color: #7c38bc;*/\r\n    /*background-image: linear-gradient(141deg, #0c0c0c 0%, #c5249bfa 51%, #b12ce8 75%);*/\r\n   \r\n}\r\n\r\n\r\n.blck-rit {\r\n    float: right;\r\n}\r\n\r\ni.fa.fa-user.fa-3 {\r\n    font-size: 3em;\r\n    color: #8e8e8e;\r\n}\r\n\r\nspan.tm-mbr-name {\r\n    font-size: 11px;\r\n    display: block;\r\n    color: #000;\r\n}\r\n\r\nspan.tm-mbr-desingnation {\r\n    display: block;\r\n    font-size: 10px;\r\n    color: #9a9999;\r\n}\r\n\r\n.myteam {\r\n    border: 1px solid #ddd;\r\n    box-shadow: 0 4px 10px 0 rgba(0,0,0,0.2), 0 4px 20px 0 rgba(0,0,0,0.19);\r\n}\r\n\r\n.empye-list {\r\n    padding: 8px 5px;\r\n    font-weight: bold;\r\n}\r\n\r\n.cbtn {\r\n    cursor: pointer;\r\n}\r\n\r\n.col-md-12 .row.cont_area {\r\n    overflow-y: hidden;\r\n    overflow-x: hidden;\r\n}\r\n\r\n.chart-tab li.active a {\r\n    color: #ff982e;\r\n    font-size: 14px;\r\n    background: #ef5353;\r\n}\r\n\r\n\r\n\r\nul.nav.nav-tabs.chart-tab {\r\n    background: #1e4861;\r\n    margin: 10px 0;\r\n    margin-bottom: 0;\r\n    padding: 0px;\r\n}\r\n\r\n    ul.nav.nav-tabs.chart-tab a {\r\n        padding: 5px;\r\n        border-radius: 0;\r\n        color: #fff;\r\n    }\r\n\r\n.col-md-12.tb-cntnt {\r\n    border: 1px solid #ddd;\r\n    border-top: none;\r\n    color: #fff;\r\n    box-shadow: 0 4px 10px 0 rgba(0,0,0,0.2), 0 4px 20px 0 rgba(0,0,0,0.19);\r\n}\r\n\r\nbutton.tg-btn {\r\n    background: #f53b44;\r\n    border: none;\r\n    color: #e6e4e4;\r\n    padding: 4px 12px;\r\n    border-radius: 2px;\r\n    font-size: 11px;\r\n}\r\n\r\n.data-view {\r\n    border: 1px solid #ddd;\r\n    color: #333;\r\n}\r\n\r\n.thead {\r\n    background: #1599f7;\r\n    font-weight: bold;\r\n}\r\n\r\n.data-view td, .data-view th {\r\n    /*border: 1px solid #b7b7b7;*/\r\n    padding: 5px;\r\n    text-align: center;\r\n    /*font-size: 12px;*/\r\n}\r\n\r\n.grad .lft-icn i.fa {\r\n    font-size: 2em;\r\n    height: