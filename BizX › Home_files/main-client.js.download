v">\r\n        <span class="logoArea" routerLink="/">\r\n            <img width="65" height="30" src="{{this._bizxrooturi.bindBaseURL() + \'/dist/assets/images/Logo-white.png\'}}"\r\n                 title="bizx" routerLink="/" />\r\n        </span>\r\n    </div>\r\n    <span class="fill-remaining-space"></span>\r\n    \x3c!-- Nav Start --\x3e\r\n    <nav class="navbar navbar-default">\r\n        <div class="container-fluid">\r\n            \x3c!-- Brand and toggle get grouped for better mobile display --\x3e\r\n            <div class="navbar-header">\r\n                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1" aria-expanded="false">\r\n                    <span class="sr-only">Toggle navigation</span>\r\n                    <span class="icon-bar"></span>\r\n                    <span class="icon-bar"></span>\r\n                    <span class="icon-bar"></span>\r\n                </button>\r\n            </div>\r\n\r\n            \x3c!-- Collect the nav links, forms, and other content for toggling --\x3e\r\n            <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">\r\n                <div class="menu_submenu m-hide">\r\n                    <ul class="nav navbar-nav navbar-right">\r\n                        <li class="dropdown">\r\n                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">\r\n                                <i class="fa fa-user" aria-hidden="true"></i> {{userName}} <span class="caret"></span>\r\n                            </a>\r\n                            <ul class="dropdown-menu header-dropdown">\r\n                                <li><a routerLink="/profile"><i class="fa fa-user" aria-hidden="true"></i>&nbsp;&nbsp;Profile</a></li>\r\n                                <li *ngIf="!isADAuthorized"><a routerLink="/change-password"><i class="fa fa-user" aria-hidden="true"></i>&nbsp;&nbsp;Change Password</a></li>\r\n                                <li><a (click)="openQueryBuilder(\'https://bizx-apps.infinite.com/bizx-reports/landing\')"><i class="fa fa-file-excel-o" aria-hidden="true"></i>&nbsp;BizX-Reports</a></li>\r\n                                <li *ngIf="isAdminLinkEnabled && !isAdminLogin"><a (click)="openAdminLink();"><i class="fa fa-users" aria-hidden="true"></i>&nbsp;Admin</a></li>\r\n                                <li *ngIf="isDelegateAdminLinkEnabled && !isAdminLogin"><a (click)="openDelegateAdminLink();"><i class="fa fa-users" aria-hidden="true"></i>&nbsp;Delegate Admin</a></li>\r\n                                <li><a (click)="onLogout(0)"><i class="fa fa-sign-out" aria-hidden="true"></i>&nbsp;Logout</a></li>\r\n                                <li *ngIf="isAdminLogin"><a (click)="onLogout(1)"><i class="fa fa-sign-out" aria-hidden="true"></i>&nbsp;Logout with {{userName}}</a></li>\r\n                            </ul>\r\n                        </li>\r\n                        \x3c!--Notification area --\x3e\r\n                        <li class="dropdown" style="display:none;">\r\n                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">\r\n                                <i class="fa fa-bell-o" aria-hidden="true"></i>   <span class="count animated">{{totalCountManager}}</span>\r\n                            </a>\r\n                            <ul class="dropdown-menu header-dropdown">\r\n                                <li *ngFor="let m of dashboardStatusSummary | slice:0:9; let i = index"><a routerLink="/{{m.relativeUrl}}"> {{m.moduleName}}&nbsp;&nbsp;<span class="badge badge-info ml-2">{{m.managerCount}}</span></a></li>\r\n                            </ul>\r\n                        </li>\r\n                        \x3c!--Notification area --\x3e\r\n                    </ul>\r\n                  \r\n                </div>\r\n\r\n                <div class="mbsmsouter">\r\n                    <div class="input-group" *ngIf="!isVendorType">\r\n                        <input type="text" class="search-profile"\r\n                               placeholder="Search Employee Profile" [(ngModel)]="employee" (keyup)="clearlist(employee)" (keyup.enter)="filterEmployee(employee)" autocomplete="off">\r\n                       \r\n                        <div class="suggestions" *ngIf="filtered_EmployeeList.length > 0 && employee !=\'\'">\r\n                            <ul>\r\n                                <li *ngFor="let item of filtered_EmployeeList">\r\n                                    <a (click)="selectEmployee(item);">{{item.fullName}}-{{item.employeeNo}}</a>\r\n                                </li>\r\n                            </ul>\r\n                        </div>\r\n                        \x3c!--added--\x3e\r\n                        <div class="serch-icon input-group-append">\r\n                            \r\n                            <button class="btn btn-secondary" type="button" matTooltip="search" (click)="filterEmployee(employee)">\r\n                                <i class="fa fa-search"></i>\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n               \r\n                <div class="mbsmsouter">\r\n\r\n                    <button mat-icon-button *ngIf="isAttendanceRequired== \'true\' && EmployeeEntityShortName == \'IN\'" style="height: 26px;line-height: 26px;border:none !important;" (click)="ShowPunchInData();" matTooltip="Employee Attendance">\r\n                        <span class="material-icons">\r\n                            free_cancellation\r\n                        </span>\r\n                    </button>\r\n\r\n                </div>\r\n\r\n            </div>\x3c!-- /.navbar-collapse --\x3e\r\n        </div>\x3c!-- /.container-fluid --\x3e\r\n    </nav>\r\n    \x3c!-- Nav End --\x3e\r\n    <button mat-icon-button *ngIf="isOrganizationHierarcyRequired== \'true\' && isOrganizationHierarcyAccessRequired ==  \'true\' && !isVendorType" (click)="ShowOrganization()" matTooltip="Organization Hierarchy">\r\n        <mat-icon>groups_2</mat-icon>\r\n    </button>\r\n    <button mat-icon-button [matMenuTriggerFor]="help_menu" matTooltip="Help || Support">\r\n        <mat-icon>support</mat-icon>\r\n    </button>\r\n    <mat-menu #help_menu="matMenu">\r\n        <div class="contactMainHead" style="font-size:11px;">\r\n            \x3c!--<p class="blink">BizX Support</p>--\x3e\r\n            <span><i class="fa fa-envelope-o"></i> &nbsp; BizX-Support@infinite.com</span><br />\r\n            <ng-container *ngIf="tenantMasterId != 7">\r\n                <span><i class="fa fa-phone"></i> &nbsp; USA VoIP # : <a>(001) 347 778 0864</a></span>\r\n            </ng-container>\r\n        </div>\r\n    </mat-menu>\r\n\r\n    <button mat-icon-button [matMenuTriggerFor]="menu" matTooltip="Select a theme!">\r\n        <mat-icon>format_color_fill</mat-icon>\r\n    </button>\r\n    <mat-menu #menu="matMenu">\r\n        <button mat-menu-item [disabled]="currentTheme == \'StyleSheet-blue\'" (click)="ChangeTheme(\'StyleSheet-blue\')">\r\n            <div class="tmeclr tm-1"></div><span>Aqua</span>\r\n        </button>\r\n        <button mat-menu-item [disabled]="currentTheme == \'StyleSheet-darkBlue\'" (click)="ChangeTheme(\'StyleSheet-darkBlue\')">\r\n            <div class="tmeclr tm-2"></div><span>Misty Mountains</span>\r\n        </button>\r\n        <button mat-menu-item [disabled]="currentTheme == \'StyleSheet\'" (click)="ChangeTheme(\'StyleSheet\')">\r\n            <div class="tmeclr tm-3"></div><span>Mustangs</span>\r\n        </button> \r\n    </mat-menu>\r\n    <div class="menuDrewerDiv">\r\n        <button mat-icon-button id="menu" (click)="navService.openNav()" title="Menu">\r\n            <mat-icon>menu</mat-icon>\r\n        </button>\r\n    </div>\r\n\r\n</mat-toolbar>'},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,'.bizx-logo {\r\n    margin: 0 4px 3px 0;\r\n    height: 35px;\r\n    vertical-align: middle;\r\n}\r\n\r\n.fill-remaining-space {\r\n    flex: 1 1 auto;\r\n}\r\n\r\n\r\n\r\n.fixed-top {\r\n    position: fixed;\r\n    top: 0;\r\n    right: 0;\r\n    left: 0;\r\n    z-index: 99;\r\n}\r\n\r\n\r\n.mat-button, .mat-fab, .mat-icon-button, .mat-mini-fab, .mat-raised-button {\r\n    color: #fff;\r\n}\r\nul.dropdown-menu {\r\n    z-index: 9999;\r\n}\r\n\r\nbutton.mat-button:hover {\r\n    color: #040000;\r\n    background: #ffffff;\r\n}\r\n\r\nnav.navbar.navbar-default {\r\n    width: 100%;\r\n    background: transparent;\r\n    border: none;\r\n    margin: 0;\r\n    text-transform: capitalize;\r\n}\r\n\r\n.navbar-default .navbar-nav > li > a, .navbar-default .navbar-text {\r\n    color: #fff;\r\n    font-size: 11px;\r\n    /*font-weight: 700;*/\r\n}\r\n\r\n.navbar-default .navbar-nav > .open > a, .navbar-default .navbar-nav > .open > a:focus, .navbar-default .navbar-nav > .open > a:hover {\r\n    color: #101010 !important;\r\n    background-color: #fdf7f7;\r\n}\r\n\r\n.navbar-default .navbar-toggle .icon-bar {\r\n    background-color: #fffbfb;\r\n}\r\n\r\n.navbar-default .navbar-toggle {\r\n    border: none;\r\n}\r\n\r\n@media only screen and (max-width: 767px) {\r\n\r\n    span.logoArea {\r\n        display: inline;\r\n        float: right;\r\n        /*position: absolute;*/\r\n        top: 5px;\r\n        width: 54px;\r\n    }\r\n    span.logoArea img{\r\n        width:100%;\r\n    }\r\n        mat-toolbar .mat-toolbar {\r\n        height: auto;\r\n    }\r\n\r\n    .navbar-default .navbar-text {\r\n        font-size: 14px;\r\n    }\r\n\r\n    .navbar-default .navbar-nav .open .dropdown-menu > li > a {\r\n        color: #1b1111;\r\n    }\r\n    .navbar-header {\r\n        display: none;\r\n    }\r\n}\r\n\r\n.navbar-default .navbar-toggle:focus, .navbar-default .navbar-toggle:hover {\r\n    background-color: #380a0a;\r\n}\r\n\r\n.dropdown-menu > li > a {\r\n    cursor: pointer;\r\n    font-family: "Arimo","Segoe UI","Helvetica Neue",Arial,sans-serif;\r\n    /*font-size:13px !important;*/\r\n}\r\n\r\n.dropdown-menu .divider {\r\n    margin: 2px 0;\r\n}\r\n/*Drop New*/\r\n.dropdown-submenu {\r\n    position: relative;\r\n}\r\n\r\n    .dropdown-submenu > .dropdown-menu {\r\n        top: 0;\r\n        left: 100%;\r\n        margin-top: -6px;\r\n        margin-left: -1px;\r\n        -webkit-border-radius: 0 6px 6px 6px;\r\n        -moz-border-radius: 0 6px 6px;\r\n        border-radius: 0 6px 6px 6px;\r\n        width: 198px;\r\n    }\r\n\r\n    .dropdown-submenu:hover > .dropdown-menu {\r\n        display: block;\r\n    }\r\n\r\n    .dropdown-submenu > a:after {\r\n        display: block;\r\n        content: " ";\r\n        float: right;\r\n        width: 0;\r\n        height: 0;\r\n        border-color: transparent;\r\n        border-style: solid;\r\n        border-width: 5px 0 5px 5px;\r\n        border-left-color: #ccc;\r\n        margin-top: 5px;\r\n        margin-right: -10px;\r\n    }\r\n\r\n    .dropdown-submenu:hover > a:after {\r\n        border-left-color: #fff;\r\n    }\r\n\r\n    .dropdown-submenu.pull-left {\r\n        float: none;\r\n    }\r\n\r\n        .dropdown-submenu.pull-left > .dropdown-menu {\r\n            left: -100%;\r\n            margin-left: 10px;\r\n            -webkit-border-radius: 6px 0 6px 6px;\r\n            -moz-border-radius: 6px 0 6px 6px;\r\n            border-radius: 6px 0 6px 6px;\r\n        }\r\n/*Drop New*/\r\n\r\n.mbsmsouter {\r\n    /*width: 70%;*/\r\n    float: right;\r\n    display: inline-block;\r\n    text-align: right;\r\n    margin: 17px 0;\r\n    margin-right: 10px;\r\n}\r\n    .mbsmsouter input.search-profile {\r\n        /*width: 245px;*/\r\n        background: none;\r\n        color: #fff;\r\n        border-radius: 2px;\r\n        padding: 0 6px;\r\n        height: 24px;\r\n        font-size: 10px;\r\n        margin: 6px 0;\r\n        border: 1px solid #fff;\r\n        width: 168px;\r\n    }\r\n    .mbsmsouter button {\r\n        border-radius: 0px 3px 3px 0px;\r\n        background: none;\r\n        color: #fff;\r\n        border: 1px solid #fff;\r\n    }\r\n    .mbsmsouter .input-group {\r\n        float: right;\r\n        /*margin-top: 7px;*/\r\n    }\r\n\r\n\r\n.has-search .form-control {\r\n    padding-left: 2.375rem;\r\n}\r\n\r\n.has-search .form-control-feedback {\r\n    position: absolute;\r\n    z-index: 2;\r\n    display: block;\r\n    width: 2.375rem;\r\n    height: 2.375rem;\r\n    line-height: 2.375rem;\r\n    text-align: center;\r\n    pointer-events: none;\r\n    color: #aaa;\r\n}\r\n\r\n.mbsmsouter .selected {\r\n    border: solid #c0c1c0 1px;\r\n    float: left;\r\n    margin: 4px 6px 4px 0px;\r\n    padding: 3px 5px;\r\n    border-radius: 6px;\r\n    background: #f3f3f3;\r\n}\r\n\r\n    .mbsmsouter .selected a {\r\n        cursor: pointer;\r\n        font-weight: bold;\r\n    }\r\n.mbsmsouter .suggestions {\r\n    max-height: 160px;\r\n    overflow: auto;\r\n    background: #ffffff;\r\n    border: 1px solid #d3d3d3;\r\n    width: 285px;\r\n    position: absolute;\r\n    z-index: 8;\r\n    top: 34px;\r\n    border-radius: 2px;\r\n}\r\n\r\n    .mbsmsouter .suggestions ul {\r\n        padding: 5px;\r\n    }\r\n\r\n    .mbsmsouter .suggestions li {\r\n        list-style: none;\r\n        text-align: left;\r\n    }\r\n\r\n    .mbsmsouter .suggestions a {\r\n        color: #2b2929;\r\n        cursor: pointer;\r\n        display: block;\r\n        padding: 2px;\r\n        font-size: 11px;\r\n        font-family: Arimo;\r\n    }\r\n\r\n        .mbsmsouter .suggestions a:hover {\r\n            text-decoration: none;\r\n            color: #333;\r\n        }\r\n\r\n.mbsmsouter li:hover {\r\n    background: #d3d3d3;\r\n}\r\n\r\n.mbsmsouter  .selected button.mat-icon-button {\r\n    max-width: 16px;\r\n    line-height: 0;\r\n    height: 23px;\r\n}\r\n\r\n.mbsmsouter .selected span {\r\n    font-size: 11px;\r\n    padding: 6px;\r\n}\r\n.logoArea img:focus {\r\n    outline: none;\r\n}\r\nspan.logoArea {\r\n    cursor: pointer\r\n}\r\n.search-profile::placeholder{\r\n    color:#ffffff;\r\n}\r\n.menu_submenu {\r\n    display: inline-block;\r\n    float: right;\r\n    padding: 9px 0;\r\n}\r\n.wlc-txt {\r\n    display: block;\r\n    font-size: 11px;\r\n    font-weight: bold;\r\n    color: #60d1ff;\r\n}\r\n::ng-deep .pickerMenu button.Mustangs {\r\n    color: #1B2330 !important;\r\n}\r\n::ng-deep .pickerMenu button.Aqua {\r\n    color: #139CD2 !important;\r\n}\r\n::ng-deep .pickerMenu button.Mountains {\r\n    color: #2A1B3C !important;\r\n}\r\n::ng-deep .pickerMenu button {\r\n    font-size: 11px;\r\n}\r\n\r\n.plateMenu {\r\n    width: 12px;\r\n    height: 12px;\r\n    display: inline-block;\r\n}\r\n.docs-Mustangs {\r\n    background: #d61111;\r\n}\r\n.mat-toolbar-row, .mat-toolbar-single-row {\r\n    height: 50px;\r\n}\r\n.dropdown-menu.header-dropdown {\r\n    font-size: 11px;\r\n}\r\n.dropdown .count {\r\n    position: absolute;\r\n    top: 11px;\r\n    right: 2px;\r\n    height: 15px;\r\n    width: 15px;\r\n    overflow: hidden;\r\n    background: #ff2f2f;\r\n    color: #FFF;\r\n    text-align: center;\r\n    border-radius: 100%;\r\n    font-size: 9px;\r\n    font-weight: bold;\r\n    line-height: 15px;\r\n}\r\n\r\n.ts-container {\r\n    font-size: 11px;\r\n}\r\nspan.attLbleName {\r\n    font-weight: bold;\r\n}\r\nbutton.tsViewCloseBtn {\r\n    min-width: 2px;\r\n    float: right;\r\n    line-height: 0;\r\n    padding: 4px;\r\n    color: #0a0a0a;\r\n    background: #e6e4e4;\r\n}\r\n.main-lbs .col-xs-12.col-md-3, .main-lbs .col-xs-12.col-md-4, .main-lbs .col-xs-12.col-md-5, \r\n.main-lbs .col-xs-12.col-md-6, .main-lbs .col-xs-12.col-md-7 {\r\n    padding: 0;\r\n}\r\nh5.InnerHeadAtt {\r\n    font-size: 1.3em;\r\n    font-weight: bold;\r\n    color: #ff9900;\r\n}\r\n.RitFilterArea.attAra {\r\n    width: 100%;\r\n    color: #f9f8f8;\r\n}\r\n.contactMainHead {\r\n    padding: 12px;\r\n    font-weight: bold;\r\n    line-height:2.5;\r\n}\r\n\r\n.contactMainHead i{\r\n    color: orange;\r\n    font-size:15px;\r\n}\r\n/*ShowOrg*/\r\n.orgBlockMain {\r\n    display: block;\r\n    width: 18.7%;\r\n    border: 1px solid #d3d3d3;\r\n    margin-bottom: 24px;\r\n    margin: 0 auto;\r\n    margin-bottom: 12px;\r\n    min-height: 50px;\r\n}\r\n.orgBlockLetft {\r\n    display: inline-block;\r\n    width: 23%;\r\n    text-align: center;\r\n    float: left;\r\n}\r\n.orgBlockLetft mat-icon {\r\n    font-size: 2em;\r\n    color: #d3d3d3;\r\n    width: 100%;\r\n    margin-top: 8px;\r\n}\r\n.orgBlockRight {\r\n    display: inline-block;\r\n    width: 76%;\r\n}\r\np.tile {\r\n    font-weight: bold;\r\n    color: #333;\r\n    font-size: 10px;\r\n    margin: 7px 0 3px 0px;\r\n}\r\np.dsig {\r\n    font-size: 9px;\r\n    color: #636161;\r\n}\r\n.orgBlockMoreRecords .orgBlockMain {\r\n    display: inline-block;\r\n    margin: 8px 6px;\r\n    float: left;\r\n}\r\n.orgBlockMoreRecords {\r\n    border-top: 1px solid #d3d3d3;\r\n}\r\n.hrLineArea {\r\n    padding: 0;\r\n    border: 1px solid #d3d3d3;\r\n    width: 1px;\r\n    margin: 0 auto;\r\n    height: 24px;\r\n}\r\nbutton.btnIcon.OrgCloseBtn {\r\n    background: #9d9999d3;\r\n    min-width: 26px;\r\n    float: right;\r\n    line-height: 8px;\r\n    padding: 4px;\r\n}\r\n.clsBtnDiv {\r\n    display: inline-block;\r\n    width: 100%;\r\n}\r\n.orgBlockMain.actv {\r\n    border: 2px solid #333;\r\n}\r\n\r\n/*ShowOrg*/\r\n.mbsmsouter .serch-icon {\r\n    display: inline;\r\n    padding: 4px;\r\n    margin: 1px;\r\n}\r\n.mbsmsouter .serch-icon .btn {\r\n    padding: 1px 6px;\r\n    margin: 0;\r\n    border:none;\r\n}',""])},function(e,t){e.exports='<div class="ts-head">\r\n    <mat-card-title><h4 class="SubHead">\r\n    Attendance Details <button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn"><i class="fa fa-times" aria-hidden="true" ></i></button></h4></mat-card-title>\r\n\r\n    <div class="ts-container">\r\n        <div class="main-lbs col-xs-12 col-md-12" style="margin-bottom:14px;padding:0;">\r\n            <div class="col-xs-12 col-md-2" style="padding:0px;">\r\n                <div class="col-xs-12 col-md-3"><span class="attLbleName">Date: </span></div>\r\n                <div class="col-xs-12 col-md-9">  <span class="empName">{{CurrentDate | date: \'dd MMM yyy\'}}</span></div>\r\n            </div>\r\n            <div class="col-xs-12 col-md-3" *ngIf="!isShow">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <span class="attLbleName">Time: </span>\r\n                </div><div class="col-xs-12 col-md-7"><span class="empName">{{CurrentDate | date: \'hh:mm a\'}}</span></div>\r\n            </div>\r\n            <div class="col-xs-12 col-md-3" style="margin-right: 27px;" *ngIf="isShow">\r\n                <div class="col-xs-12 col-md-6">\r\n                    <span class="attLbleName">Punch- In Time:</span>\r\n                </div><div class="col-xs-12 col-md-6"> <span *ngFor="let data of AttandanceList"> {{data.loggedInTime> 0? ( data.loggedInTime * 1000 | date:\'dd MMM yyy hh:mm a\') : \'\'}}</span></div>\r\n            </div>\r\n            <div class="col-xs-12 col-md-3" style="margin-right: 27px;" *ngIf="isAllsubmitted && isShow">\r\n                <div class="col-xs-12 col-md-6">\r\n                    <span class="attLbleName"> Punch- Out Time:</span>\r\n                </div><div class="col-xs-12 col-md-6"><span *ngFor="let data of AttandanceList"> {{data.loggedOutTime> 0? ( data.loggedOutTime * 1000 | date:\'dd MMM yyy hh:mm a\') : \'\' }}</span></div>\r\n            </div>\r\n\r\n            <div class="col-xs-12 col-md-3" *ngIf="isAllsubmitted && isShow">\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span class="attLbleName"> Total Worked Hours:</span>\r\n                </div><div class="col-xs-12 col-md-5"><span *ngFor="let data of AttandanceList">  {{data.TotalWorkHours}}</span></div>\r\n            </div>\r\n\r\n\r\n            <div class="row">\r\n                <div class="col-xs-12 col-md-12" style="text-align:right">\r\n                    <button mat-button class="org-btn" *ngIf="!isShow && !isAllsubmitted " (click)="OnPunchinClick()">Punch-In</button>\r\n                    <button mat-button class="org-btn" *ngIf="isShow && !isAllsubmitted" (click)="OnPunchOutClick()">Punch-Out</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        \x3c!--<div class="ts-container">--\x3e\r\n      \r\n                <h5 class="InnerHeadAtt">Attendance History</h5>\r\n\r\n             \r\n                <div class="tableListViewHeader">\r\n                    <div class="RitFilterArea attAra">\r\n                        <mat-form-field>\r\n                            <mat-select placeholder="Select  Month" (change)="OnDateChanged($event.value, selectedYear)" [(ngModel)]="selectedMonth">\r\n                                <mat-option *ngFor="let c of month" [value]="c.key">{{ c.value }}</mat-option>\r\n                                \x3c!--<mat-datepicker #rdate (selectedChanged)="OnDateChanged($event)"></mat-datepicker>--\x3e\r\n                            </mat-select>\r\n                        </mat-form-field>\r\n                        <mat-form-field>\r\n                            <mat-select placeholder="Select Year" (change)="OnDateChanged(selectedMonth,$event.value)" [(ngModel)]="selectedYear">\r\n                                <mat-option value="2022">2022</mat-option>\r\n                                <mat-option value="2023">2023</mat-option>\r\n                                <mat-option value="2024">2024</mat-option>\r\n                                <mat-option value="2025">2025</mat-option>\r\n                            </mat-select>\r\n                        </mat-form-field>\r\n                    </div>\r\n                </div>\r\n                    <div class="PR-list-container mat-elevation-z8">\r\n                        <mat-table #table [dataSource]="dataSource" *ngIf="dataSource.data.length">\r\n                            <ng-container matColumnDef="Date">\r\n                                <mat-header-cell *matHeaderCellDef> Date </mat-header-cell>\r\n                                <mat-cell *matCellDef="let element"> {{element?.createdOn| date}} </mat-cell>\r\n                            </ng-container>\r\n                        <ng-container matColumnDef="Punch In">\r\n                        <mat-header-cell *matHeaderCellDef> Punch- In Time </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element?.loggedInTime * 1000 | date:\'dd MMM yyy hh:mm a\'}} </mat-cell>\r\n                            </ng-container>\r\n                        <ng-container matColumnDef="Punch Out">\r\n                        <mat-header-cell *matHeaderCellDef> Punch- Out Time </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{ (element?.loggedOutTime > 0 ) ?(element?.loggedOutTime * 1000 | date:\'dd MMM yyy hh:mm a\') : \'\'}} </mat-cell>\r\n                            </ng-container>\r\n                        <ng-container matColumnDef="Total Worked Hours">\r\n                        <mat-header-cell *matHeaderCellDef> Total Worked Hours </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element?.TotalWorkHours}} </mat-cell>\r\n                            </ng-container>\r\n\r\n                        <mat-header-row *matHeaderRowDef="AttendanceHistory"></mat-header-row>\r\n                        <mat-row *matRowDef="let row; columns: AttendanceHistory;"></mat-row>\r\n                        </mat-table>\r\n\r\n                        <div *ngIf="dataSource.data.length === 0">\r\n                        <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                        </div>\r\n                    </div>\r\n\r\n          \r\n\r\n        </div>\r\n    </div>\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>\r\n'},function(e,t){e.exports='<div class="orgMainContainer">\r\n    <div class="orgContainerInner">\r\n        <div class="clsBtnDiv">\r\n            <button mat-button [mat-dialog-close]="true" class="btnIcon OrgCloseBtn"><i class="fa fa-times" aria-hidden="true"></i></button>\r\n        </div>\r\n        <div class="orgBlocksInner">\r\n            <div *ngFor="let managerObj of hierarchy">\r\n                <div [ngClass]="{\'actv\': uid == managerObj.UID }" class="orgBlockMain" (click)="getEmployeeOrgHierarchy(managerObj.UID)" style="cursor:pointer">\r\n                    <div class="orgBlockLetft">\r\n                        <mat-icon>\r\n                            account_circle\r\n                        </mat-icon>\r\n                    </div>\r\n                    <div class="orgBlockRight">\r\n                        <p class="tile">{{managerObj.FullName}}</p>\r\n                        <p class="dsig">{{managerObj.Designation}}</p>\r\n                    </div>\r\n                </div>\r\n                <div class="hrLineArea">\r\n                    <div class="hrline">\r\n\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class="orgBlockMoreRecords">\r\n\r\n                <div class="orgBlockMain" *ngFor="let reporteeObj of reportee" (click)="getEmployeeOrgHierarchy(reporteeObj.UID)" style="cursor:pointer">\r\n                    <div class="orgBlockLetft">\r\n                        <mat-icon>\r\n                            account_circle\r\n                        </mat-icon>\r\n                    </div>\r\n                    <div class="orgBlockRight">\r\n                        <p class="tile" matTooltip="{{ reporteeObj.FullName }}">\r\n            