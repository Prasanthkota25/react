bixLogo">\r\n        <img src="{{this._bizxrooturi.bindBaseURL() + \'/dist/assets/images/bix-Logo-332.png\'}}" title="bizx" style="width: 71%;">\r\n    </div>\r\n\r\n    \x3c!-- ChangePassword Form --\x3e\r\n    <div class="passMain">\r\n        <div class="passInner">\r\n\r\n            <div class="ChangePasswordMain">\r\n                <div class="ChangePassword">\r\n                    <div class="logInner">\r\n                        <img class="disableselect disabledrag logo" oncontextmenu="return false;" title="bizx" src="{{this._bizxrooturi.bindBaseURL() + \'/dist/assets/images/Infinite-Logo-loginPage.png\'}}">\r\n                    </div>\r\n                    <h4 class="SubHead">Reset Password</h4>\r\n                    <form [formGroup]="resetPwdForm" (ngSubmit)="onResetPwdSubmit(resetPwdForm)" novalidate>\r\n                        <div class="row">\r\n                            <div class="col-xs-12 col-md-12">\r\n                                <mat-form-field>\r\n                                    <input type="password" matInput placeholder="New Password" [(ngModel)]="newPassword" formControlName="newPassword" minlength="8" maxlength="20" required />\r\n                                </mat-form-field>\r\n                                <div *ngIf="newPassword"><password-strength-bar [passwordToCheck]="newPassword" [barLabel]="barLabel" (valueChange)=\'displayScore($event)\'></password-strength-bar></div>\r\n                            </div>\r\n                            <div class="col-xs-12 col-md-12">\r\n                                <mat-form-field>\r\n                                    <input type="password" matInput placeholder="Confirm New Password" [(ngModel)]="confirmNewPassword" formControlName="confirmNewPassword" minlength="8" maxlength="20" required />\r\n                                    <mat-error *ngIf="!resetPwdForm.hasError(\'notEquivalent\')">\r\n                                        Password Mismatch\r\n              