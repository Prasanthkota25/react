ol-md-3">\r\n                    <mat-form-field>\r\n                        <input matInput placeholder="{{whichModule}} ID To" formControlName="incidentIdTo" minlength=0 maxlength=10 (keypress)="keyPress($event)">\r\n                    </mat-form-field>\r\n                </div>\r\n                <div class="col-xs-12 col-md-3">\r\n                    <mat-form-field hintLabel="min 4 characters">\r\n                        <input matInput placeholder="Caller" autocomplete="off" type="text" class="validate filter-input" formControlName="callerName" [(ngModel)]="callerName" [value]="editCallerName" (keyup)="filterEmployee(callerName)">\r\n                        <button mat-button *ngIf="callerName" matSuffix mat-icon-button aria-label="Clear" (click)="removeEmployee(item)">\r\n                            <mat-icon>close</mat-icon>\r\n                        </button>\r\n                    </mat-form-field>\r\n                    <div class="suggestions" *ngIf="filtered_EmployeeList.length>0">\r\n                        <ul>\r\n                            <li *ngFor="let item of filtered_EmployeeList">\r\n                                <a (click)="selectEmployee(item);">{{item.fullName}}</a>\r\n                            </li>\r\n                        </ul>\r\n                    </div>\r\n                </div>\r\n                <div class="col-xs-12 col-md-3">\r\n                    <mat-form-field>\r\n                        <input matInput [matDatepicker]="logFromTime" placeholder="Log From Time" formControlName="logFromTime">\r\n                        <mat-datepicker-toggle matSuffix [for]="logFromTime"></mat-datepicker-toggle>\r\n                        <mat-datepicker #logFromTime></mat-datepicker>\r\n                    </mat-form-field>\r\n                </div>\r\n            </div>\r\n\r\n            <div class="row">\r\n                <div class="col-xs-12 col-md-3">\r\n                    <mat-form-field>\r\n                        <input matI