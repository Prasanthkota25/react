" [(ngModel)]="RememberUserName" formControlName="RememberUserName"\r\n                                              (change)="onChange($event)" class="rembrMe"></mat-checkbox>\r\n                                Remember User name\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class="row">\r\n                            <div class="col-md-12">\r\n\r\n                                <button type="submit" [disabled]="loginFormFirstStep.invalid" class="signBtn login-btn"\r\n                                        mat-raised-button>\r\n                                    Next &nbsp; <i class="fa fa-arrow-right" aria-hidden="true"></i>\r\n                                </button>\r\n                            </div>\x3c!-- /.col --\x3e\r\n                        </div>\r\n\r\n                    </form>\r\n                </div>\r\n\r\n                <div class="login-box-body" [hidden]="!isForms">\r\n\r\n                    <span class="uName"><i class="fa fa-user-circle-o" aria-hidden="true"></i>&nbsp;{{ UserName }}</span>\r\n\r\n                    <form [formGroup]="loginFormSecondStep" (ngSubmit)="onSubmit(loginFormSecondStep)" autocomplete="off"\r\n                          class="example-full-width">\r\n\r\n                        <div class="usrName">\r\n                            <label>Enter your Password</label>\r\n                            <input class="passwdIn" autofocus matInput [type]="!hide ? \'password\' : \'text\'" formControlName="Password" [(ngModel)]="Password" />\r\n                            <mat-icon matSuffix (click)="hide = !hide" style="margin: 20px 0;"><i class="fa fa-{{hide ? \'eye\' : \'eye-slash\'}}"></i></mat-icon>\r\n                            <p *ngIf="loginFormSecondStep.get(\'Password\').hasError(\'required\')" style="color:#ef5656;">\r\n                                Password is required\r\n                            </p>\r\n\r\n                        </div>\r\n\r\n                        <div class="usrName cpta">\r\n                            <label>Enter OTP sent to the Email</label>\r\n                            <input class="passwdIn" autofocus matInput [type]="!hide ? \'password\' : \'text\'" formControlName="otppassword" [(ngModel)]="otppassword" />\r\n                            <mat-icon matSuffix (click)="hide = !hide" style="margin: 20px 0;padding-left: 12px;"><i class="fa fa-{{hide ? \'eye\' : \'eye-slash\'}}"></i></mat-icon>\r\n                            <p *ngIf="loginFormSecondStep.get(\'otppassword\').hasError(\'required\')" style="color:#ef5656;">\r\n                                OTP is Mandatory\r\n                            </p>\r\n\r\n                        </div>\r\n                        <div class="usrName">\r\n                            <div class="repend">\r\n                                <div class="captcha-code">{{generatedCaptchaCode}}</div>\r\n                                <img style="display:none;" id="img-captcha" [src]=\'imageByte\' />\r\n                                <label (click)="getCodeCaptcha()"><i class="material-icons">refresh</i></label>\r\n                            </div>\r\n                            <input style="width: 80%;margin-right: 20px;" type="text" class="passwdIn" formControlName="captchaCode" placeholder="Enter captcha code"\r\n                                   asp-for="CaptchaCode" maxlength="4" />\r\n                            <span asp-validation-for="CaptchaCode" class="text-danger"></span>\r\n                        </div>\r\n\r\n                        <div class="row">\r\n                            <div style="display:none;" class="col-md-12">\r\n                                <div class="checkbox icheck">\r\n                                    <mat-checkbox formControlName="RememberMe" class="rembrMe"> </mat-checkbox>\r\n                                    Remember Me\r\n                                </div>\r\n                            </