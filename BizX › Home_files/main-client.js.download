  }\r\n    .col-xs-12.col-md-2.resource {\r\n        width: 20%;\r\n    }\r\n    .col-xs-12.col-md-2.workType {\r\n        width: 13%;\r\n    }\r\n    .col-xs-12.col-md-2.requiredDate {\r\n        width: 14%;\r\n    }\r\n    .col-xs-12.col-md-1.unitRate {\r\n        width: 13%;\r\n    }\r\n    .col-xs-12.col-md-1.quantity {\r\n        width: 10%;\r\n    }\r\n    .col-xs-12.col-md-2.amount {\r\n        width: 10%;\r\n    }\r\n    .ItemDetailblock:nth-child(even) {\r\n        background: #efefef;\r\n    }\r\n</style>\r\n<h2 mat-dialog-title>PR Details</h2>\r\n<mat-dialog-content class="mat-typography">\r\n    <div class="prDetailsBlocks">\r\n\r\n        <div class="row prDetailsBasic">\r\n            <div class="col-xs-12 col-md-4">\r\n                <div class="col-xs-12 col-md-4">\r\n                    <label>Client</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-8">\r\n                    <span>{{obj.client}}</span>\r\n                </div>\r\n            </div>\r\n\r\n\r\n            <div class="col-xs-12 col-md-6">\r\n                <div class="col-xs-12 col-md-4">\r\n                    <label>Project</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-8">\r\n                    <span>{{obj.project}}</span>\r\n                </div>\r\n            </div>\r\n\r\n\r\n        </div>\r\n        <div class="prd-item-div">\r\n            <label class="prd-item-lble">Products Item</label>\r\n        </div>\r\n        \x3c!-- Item Detail block --\x3e\r\n        <div class="row prDTile">\r\n            <div class="col-xs-12 col-md-2 resource">\r\n                <label>Resource</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 workType">\r\n                <label>Work Type</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 requiredDate">\r\n                <label>Required Date</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-1 unitRate">\r\n                <label>Unit Rate</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-1 quantity">\r\n                <label>Quantity</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 amount">\r\n                <label> Amount</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 description">\r\n                <label>Description</label>\r\n            </div>\r\n        </div>\r\n        <div class="ItemDetailblock" *ngFor="let item of obj.purchaseRequestConsultantDetails">\r\n            <div class="row">\r\n                \x3c!-- REpeatable Rows--\x3e\r\n                <div class="col-xs-12 col-md-2 resource">\r\n                    <span>{{item?.employeeName}}</span>\r\n                </div>\r\n\r\n                <div class="col-xs-12 col-md-2 workType">\r\n                    <span>{{item?.workType}}</span>\r\n                </div>\r\n                <div class="col-xs-12 col-md-2 requiredDate">\r\n                    <span>{{item?.requiredDate | date:\'dd MMM yyy\'}}</span>\r\n                </div>\r\n              \r\n                <div class="col-xs-12 col-md-1 unitRate">\r\n\r\n\r\n                    <span>{{poCurrency == \'INR\'?(item?.unitRate.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):poCurrency == \'USD\'?(item?.unitRate | currency):item?.unitRate}}</span>\r\n\r\n                </div>\r\n                <div class="col-xs-12 col-md-1 quantity">\r\n\r\n\r\n                    <span>{{item?.quantity}}</span>\x3c!--attributeElementName--\x3e\r\n\r\n                </div>\r\n                \r\n                <div class="col-xs-12 col-md-2 amount">\r\n\r\n\r\n                    <span>{{poCurrency == \'INR\'?(item?.totalAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):poCurrency == \'USD\'?(item?.totalAmount | currency):item?.totalAmount}}</span>\r\n\r\n                </div>\r\n                <div class="col-xs-12 col-md-2 description">\r\n\r\n                    <span>{{item?.description}}</span>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n        \x3c!-- Item Detail block --\x3e\r\n    </div>\r\n\r\n</mat-dialog-content>\r\n<mat-dialog-actions align="end">\r\n    <button mat-button mat-dialog-close>Cancel</button>\r\n</mat-dialog-actions>'},function(e,t){e.exports='<mat-card [@routerTransition]>\r\n   \r\n    <mat-card-title>\r\n        <h4 class="SubHead">\r\n            Purchase Request - {{purchaseRequestNonConsultantDetailsById?.prNumber}}<span class="spgeBack">\r\n                <button mat-icon-button class="pdfBtn" matTooltip="Export to Pdf" (click)="exportPDF(\'pdf\')" *ngIf="isAllPRAccess == \'1\'" [disabled]="purchaseRequestNonConsultantDetailsById.pendingManagerUID != 0">\r\n                    <i class="fa fa-file-pdf-o"></i>\r\n                </button>\r\n                <a class="pgeBack"  (click) ="backClick()" ><mat-icon><i class="material-icons">arrow_back_ios</i></mat-icon>Back</a>\r\n            </span>\r\n        </h4>\r\n    </mat-card-title>\r\n    <mat-card-content>\r\n        <div class="vendor-block">\r\n            <employee-information *ngIf="RequesterEmployeeUID != 0" [InputEmployeeNumber]="RequesterEmployeeUID"></employee-information>\r\n\r\n            <mat-expansion-panel [expanded]="allExpandState">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">import_contacts</i></mat-icon>  Request Details\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <div class="row">\r\n                    \x3c!--<pre>{{purchaseRequestNonConsultantDetailsById |json}}</pre>--\x3e\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Entity</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{EntityName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3 viw-stle-1">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PR Number</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseRequestNonConsultantDetailsById?.prNumber}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3 viw-stle-1">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PR Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseRequestNonConsultantDetailsById?.createdOn| date:\'dd MMM yyy\'}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Requester</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{loadEmployeeDetailsById.fullName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <div class="row">\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PR For</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseRequestNonConsultantDetailsById?.prCategory}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Client</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{ClientName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>BU</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{BuName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>SBU</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{SbuName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class="row">\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Budget Type</label>\r\n                        </div>\r\n\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseRequestNonConsultantDetailsById.budgetType}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3 viw-stle-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Billability</label>\r\n                        </div>\r\n\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseRequestNonConsultantDetailsById.billableType}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Project Name</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{ProjectName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PR Currency</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{currencyName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                </div>\r\n                <div class="row">\r\n                    <div class="col-xs-12 col-md-3 viw-stle-2">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Total Amount</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{currencyName == \'INR\'?(totalPRAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):currencyName == \'USD\'?(totalPRAmount | currency):totalPRAmount}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Budget Ref#</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseRequestNonConsultantDetailsById?.budgetReferenceNo}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>SR No</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8" *ngIf="purchaseRequestNonConsultantDetailsById?.srNo != \'\'">\r\n                            <a *ngFor="let item of srSplitlist"\r\n                               (click)="getServiceDetailsById(item)" style="cursor:pointer;padding:0px 5px 0px 0px;">SR-{{item}}</a>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3" *ngIf="isPONoVisible == \'true\'">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO No</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <a (click)="getPODetailsById()" style="cursor:pointer;">{{poNumber}}</a>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Employee Name</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseRequestNonConsultantDetailsById?.contactPersonName}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Vendor Name</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{vendorCompanyName}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-12">\r\n                            <label>Justification</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-12">\r\n                            <span>{{purchaseRequestNonConsultantDetailsById?.remarks}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class="prd-item-div">\r\n                    <label class="prd-item-lble">Products Item</label>\r\n                </div>\r\n                \x3c!-- Item Detail block --\x3e\r\n                <div class="ItemDetailblock" *ngFor="let purchaseDetail of purchaseRequestNonConsultantDetails">\r\n                    <div class="row">\r\n                        <div class="col-xs-12 col-md-3">\r\n                            <div class="col-xs-12 col-md-4">\r\n                                <label>Services</label>\r\n                            </div>\r\n                            <div class="col-xs-12 col-md-8">\r\n                                <span>{{purchaseDetail?.productName}}</span>\x3c!--attributeElementName--\x3e\r\n                            </div>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-3">\r\n                            <div class="col-xs-12 col-md-4">\r\n                                <label>Product/Item</label>\r\n                            </div>\r\n                            <div class="col-xs-12 col-md-8">\r\n                                <span>{{purchaseDetail?.itemName}}</span>\x3c!--attributeElementName--\x3e\r\n                            </div>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-3">\r\n                            <div class="col-xs-12 col-md-4">\r\n                                <label>Required Date</label>\r\n                            </div>\r\n                            <div class="col-xs-12 col-md-8">\r\n                                <span>{{purchaseDetail?.requiredDate | date:\'dd MMM yyy\'}}</span>\x3c!--attributeElementName--\x3e\r\n                            </div>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-3">\r\n                            <div class="col-xs-12 col-md-4">\r\n                                <label>Quantity</label>\r\n                            </div>\r\n                            <div class="col-xs-12 col-md-8">\r\n                                <span>{{purchaseDetail?.quantity}}</span>\x3c!--attributeElementName--\x3e\r\n                            </div>\r\n                        </div>\r\n\r\n                    </div>\r\n                    <div class="row">\r\n\r\n                        <div class="col-xs-12 col-md-3">\r\n                            <div class="col-xs-12 col-md-4">\r\n                                <label>UOM</label>\r\n                            </div>\r\n                            <div class="col-xs-12 col-md-8">\r\n                                <span>{{purchaseDetail?.uom}}</span>\x3c!--attributeElementName--\x3e\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class="col-xs-12 col-md-3">\r\n                            <div class="col-xs-12 col-md-4">\r\n                                <label>Unit Rate</label>\r\n                            </div>\r\n                            <div class="col-xs-12 col-md-8">\r\n                                <span>{{currencyName == \'INR\'?(purchaseDetail?.unitRate.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):currencyName == \'USD\'?(purchaseDetail?.unitRate | currency):purchaseDetail?.unitRate}}</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-3">\r\n                            <div class="col-xs-12 col-md-4">\r\n                                <label>Amount</label>\r\n                            </div>\r\n                            <div class="col-xs-12 col-md-8">\r\n                                <span>{{currencyName == \'INR\'?(purchaseDetail?.amount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):currencyName == \'USD\'?(purchaseDetail?.amount | currency):purchaseDetail?.amount}}</span>\x3c!--attributeElementName--\x3e\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class="col-xs-12 col-md-3">\r\n                            <div class="col-xs-12 col-md-4">\r\n                                <label>Location</label>\r\n                            </div>\r\n                            <div class="col-xs-12 col-md-8">\r\n                                <span>{{purchaseDetail?.unitLocationString}}</span>\x3c!--attributeElementName--\x3e\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div class="row">\r\n                        \x3c!--<div class="col-xs-12 col-md-4">\r\n                    <div class="col-xs-12 col-md-6">\r\n                        <label>Required Infinite Unit</label>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-6">\r\n                        <span>{{purchaseDetail?.unitRate}}</span>\r\n                    </div>\r\n                </div>--\x3e\r\n\r\n                    </div>\r\n\r\n                    <div class="row">\r\n                        <div class="col-xs-12 col-md-12">\r\n                            <div class="col-xs-12 col-md-12">\r\n                                <label>Description</label>\r\n                            </div>\r\n                            <div class="col-xs-12 col-md-12">\r\n                                <span>{{purchaseDetail?.description}}</span>\x3c!--attributeElementName--\x3e\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                \x3c!-- Item Detail block --\x3e\r\n                \x3c!--<mat-action-row>\r\n            <button mat-button class="org-btn" (click)="prevStep()">\r\n                Previous\r\n\r\n            </button>\r\n            <button mat-button class="blu-btn" (click)="nextStep()">Next</button>\r\n        </mat-action-row>--\x3e\r\n            </mat-expansion-panel>\r\n            <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">attachment</i></mat-icon>  Supporting Documents Attachment\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <div class="row" *ngIf="purchaseRequestNonConsultantAttachments.length">\r\n                    <br />\r\n                    <table class="itemRows-tble" *ngIf="purchaseRequestNonConsultantAttachments !== undefined && purchaseRequestNonConsultantAttachments.length > 0">\r\n                        <tr>\r\n                            <th width="6%">No</th>\r\n                            <th width="22%">\r\n                                Document Description\r\n                            </th>\r\n                            <th>Attachment</th>\r\n                            \x3c!--<th>Download</th>--\x3e\r\n                        </tr>\r\n                        <tr *ngFor="let purchaseAttachment of purchaseRequestNonConsultantAttachments; let i=index">\r\n                            <td>{{i+1}}</td>\r\n                            \x3c!--<td> Certificate of Incorporation</td>--\x3e\r\n                            <td>{{purchaseAttachment.documentDescription}} </td>\r\n                            \x3c!--<td>{{purchaseAttachment.documentName}} </td>--\x3e\r\n                            <td><button mat-icon-button class="smlBtn" (click)="downloadPDF(purchaseAttachment.id)"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp; {{purchaseAttachment.documentName}}</button></td>\r\n\r\n                        </tr>\r\n\r\n                    </table>\r\n                </div>\r\n\r\n                <div class="row" *ngIf="purchaseRequestNonConsultantAttachments.length === 0">\r\n                    <h4 style="text-align: center;margin: 12px;padding: 6px;"> No Attachment found....</h4>\r\n                </div>\r\n\r\n            </mat-expansion-panel>\r\n            \x3c!-- Approval information --\x3e\r\n            <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">check_circle_outline</i></mat-icon> Approval information\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <br />\r\n                <table class="itemRows-tble">\r\n                    <tr>\r\n                        <th>Approver Name</th>\r\n                        <th>Role</th>\r\n                        <th>Status</th>\r\n                        <th>Approved Date</th>\r\n                        <th>Remarks</th>\r\n                    </tr>\r\n\r\n\r\n                    <tr *ngFor="let element of approvalHeirarchyList;let i=index">\r\n                        <td>{{element.approverName}} </td>\r\n                        <td>{{element.role}}   (Level-{{i+1}})</td>\r\n                        <td>{{element.status}}</td>\r\n                        <td><span *ngIf="element.status != \'Pending\'">{{element.approvalDate * 1000 | date:\'dd MMM yyyy hh:mm a\'}}</span></td>\r\n                        <td>{{element.remarks}}</td>\r\n                    </tr>\r\n\r\n                </table>\r\n                <br />\r\n\r\n                <div class="row" *ngIf="isPendingPR == 1">\r\n\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <label>Remarks<span class="asterik-mark">*</span></label>\r\n                        <textarea class="cust-validation" style="width:100%;min-height: 30px;" autocomplete="off" required [(ngModel)]="txtRemarks"></textarea>\r\n                    </div>\r\n\r\n                </div>\r\n                <mat-action-row *ngIf="isPendingPR == 1">\r\n\r\n                    <button mat-button class="reject-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePRStatus(-1,\'reject\')"> <i class="fa fa-undo" aria-hidden="true"></i> &nbsp;Reject</button>\r\n                    <button mat-button class="approve-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePRStatus(1,\'approve\')"><i class="fa fa-send-o" aria-hidden="true"></i> &nbsp; Approve</button>\r\n                    <button mat-button class="approve-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="RedraftProcurementApproval()"><i class="fa fa-send-o" aria-hidden="true"></i> &nbsp; Re-Draft</button>\r\n                </mat-action-row>\r\n            </mat-expansion-panel>\r\n            \r\n            <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">check_circle_outline</i></mat-icon> PR History\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <br />\r\n                <table class="itemRows-tble">\r\n                    <tr>\r\n                        <th>Approver Name</th>\r\n                        <th>Role</th>\r\n                        <th>Status</th>\r\n                        <th>Date of Action</th>\r\n                        <th>Remarks</th>\r\n                    </tr>\r\n\r\n\r\n                    <tr *ngFor="let element of procurementApprovalSummaryData;let i=index">\r\n                        <td>{{element.ApproverName}} </td>\r\n                        <td>{{element.Role}}</td>\r\n                        <td>{{element.Status}}</td>\r\n                        <td><span *ngIf="element.Status != \'Pending for Approval\'">{{element.DateOfAction * 1000 | date:\'dd MMM yyyy hh:mm a\'}}</span></td>\r\n                        <td>{{element.Remarks}}</td>\r\n                    </tr>\r\n\r\n                </table>\r\n                <br />\r\n            </mat-expansion-panel>\r\n            \x3c!-- Approval information --\x3e\r\n\r\n\r\n            <div class="col-xs-12 col-md-4" *ngIf="isClose == \'close\'">\r\n                <mat-form-field style="width: 25%;">\r\n                    <textarea matInput placeholder="Reason for closing" [(ngModel)]="closeRemarks" required></textarea>\r\n                </mat-form-field>\r\n            </div>\r\n            <div class="col-xs-12 col-md-4" *ngIf="isClose == \'on-hold\'">\r\n                <mat-form-field style="width: 25%;">\r\n                    <textarea matInput placeholder="On-Hold Reason" [(ngModel)]="closeRemarks" required></textarea>\r\n                </mat-form-field>\r\n            </div>\r\n\r\n            <mat-action-row>\r\n                <button mat-button class="org-btn" (click)="backClick()">\r\n                    Cancel\r\n                </button>\r\n                <button *ngIf="isClose == \'close\'||isClose == \'on-hold\'" mat-button class="blu-btn" [disabled]="closeRemarks == \'\' || closeRemarks == undefined" (click)="ClosedPurchaseRequest()">\r\n                    Submit\r\n                </button>\r\n            </mat-action-row>\r\n\r\n\r\n        </div>\r\n    </mat-card-content>\r\n</mat-card>\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>'},function(e,t,n){var r=n(1058);e.exports="string"==typeof r?r:r.toString()},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,".vendor-block .col-md-3, .vendor-block .col-md-3, .vendor-block .col-md-3 {\r\n}\r\n\r\n.view-PR-header mat-panel-title .material-icons {\r\n    margin-right: 12px\r\n}\r\n\r\n.view-PR-header .col-xs-12.col-md-6, .view-PR-header .col-xs-12.col-md-3 {\r\n    padding: 0px;\r\n}\r\n\r\n.view-PR-header .row {\r\n    /*font-size: 12px;*/\r\n    padding: 0 8px;\r\n}\r\n\r\n.attacment {\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n}\r\n\r\n    .attacment td, .attacment th {\r\n        border: 1px solid #ddd;\r\n        padding: 8px;\r\n        /*font-size: 12px;*/\r\n    }\r\n\r\n    .attacment tr:nth-child(even) {\r\n        background-color: #f2f2f2;\r\n    }\r\n\r\n    .attacment tr:hover {\r\n        background-color: #ddd;\r\n    }\r\n\r\n    .attacment th {\r\n        padding-top: 5px;\r\n        padding-bottom: 5px;\r\n        background-color: #0e7ddc;\r\n        color: white;\r\n    }\r\n.ItemDetailblock {\r\n    border: 1px solid #dedede;\r\n    margin: 2px 0;\r\n}\r\nlabel.prd-item-lble {\r\n    margin: 0;\r\n    color: #333;\r\n    font-size: 13px;\r\n}\r\n.prd-item-div {\r\n    background: #e6e6e6;\r\n    padding: 7px;\r\n}\r\n.TripTble {\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n    border: 1px solid #ddd;\r\n}\r\n.TripTble tr:nth-child(even) {\r\n    background-color: #f2f2f2;\r\n}\r\n    .TripTble td, .TripTble th {\r\n        border-top: 1px solid #dcdcdc;\r\n        text-align: center;\r\n        padding: 6px;\r\n    }\r\n.TripTble th {\r\n    background-color: #0c85b3;\r\n    color: white;\r\n}\r\nspan.expoBtn {\r\n    display: inline-block;\r\n    text-align: right;\r\n    width: 80%;\r\n}\r\nmat-expansion-panel ::ng-deep .mat-expansion-panel-body {\r\n    /*font-size: 12px;*/\r\n}",""])},function(e,t){e.exports='<style>\r\n    .row.srDetailsArea .col-sm-12.col-md-3, .row.srDetailsArea .col-sm-12.col-md-1{\r\n        /*width: 20%;*/\r\n        font-size: 11px;\r\n        padding: 0;\r\n    }\r\n    .srDetailsBlocks p{\r\n        font-size:11px;\r\n    }\r\n    .close-btn {\r\n        padding: 4px;\r\n        height: 32px;\r\n        line-height: 1;\r\n        font-size: 11px;\r\n    }\r\n    .col-md-10 p{\r\n        text-align:justify;\r\n    }\r\n    .col-md-11 p {\r\n        padding-left: 12px;\r\n    }\r\n</style>\r\n<h2 mat-dialog-title style="border-bottom: 1px solid;">Service Request Details - {{serviceDetailsById?.srNumber}}</h2>\r\n\r\n<mat-dialog-content class="mat-typography">\r\n    <div class="srDetailsBlocks">\r\n\r\n        <div class="row srDetailsArea">\r\n            <div class="col-sm-12 col-md-3">\r\n                <div class="col-sm-12 col-md-5">\r\n                    <label>Raised By</label>\r\n                </div>\r\n                <div class="col-sm-12 col-md-7">\r\n                    <p>{{serviceDetailsById?.employeeName}}</p>\r\n                </div>\r\n            </div>\r\n            <div class="col-sm-12 col-md-3">\r\n                <div class="col-sm-12 col-md-5">\r\n                    <label>Department</label>\r\n                </div>\r\n                <div class="col-sm-12 col-md-7">\r\n                    <p>{{serviceDetailsById?.departmentName}}</p>\r\n                </div>\r\n            </div>\r\n            <div class="col-sm-12 col-md-3">\r\n                <div class="col-sm-12 col-md-5">\r\n                    <label>Category</label>\r\n                </div>\r\n                <div class="col-sm-12 col-md-7">\r\n                    <p>{{serviceDetailsById?.parentCategoryName}}</p>\r\n                </div>\r\n            </div>\r\n            <div class="col-sm-12 col-md-3">\r\n                <div class="col-sm-12 col-md-5">\r\n                    <label>Sub Category</label>\r\n                </div>\r\n                <div class="col-sm-12 col-md-7">\r\n                    <p>{{serviceDetailsById?.categoryName}}</p>\r\n                </div>\r\n            </div>\r\n            <div class="col-sm-12 col-md-3" *ngIf="serviceDetailsById.projectMasterId >0">\r\n                <div class="col-sm-12 col-md-5">\r\n                    <label>Project</label>\r\n                </div>\r\n                <div class="col-sm-12 col-md-7">\r\n                    <p>{{serviceDetailsById.projectName}}</p>\r\n                </div>\r\n            </div>\r\n            <div class="col-sm-12 col-md-3">\r\n                <div class="col-sm-12 col-md-5">\r\n                    <label>Log Time</label>\r\n                </div>\r\n                <div class="col-sm-12 col-md-7">\r\n                    <p>{{serviceDetailsById?.srLoggedTime * 1000 | date:\'dd MMM yyy hh:mm a\'}}</p>\r\n                </div>\r\n            </div>\r\n            </div>\r\n        <div class="row srDetailsArea">\r\n            <div class="col-sm-12 col-md-12">\r\n                <div class="col-sm-12 col-md-1">\r\n                    <label>Description</label>\r\n                </div>\r\n                <div class="col-sm-12 col-md-11">\r\n                    <p>{{serviceDetailsById?.srDescription }}</p>\r\n                </div>\r\n            </div>\r\n            <div class="col-sm-12 col-md-12">\r\n                <div class="col-sm-12 col-md-1">\r\n                    <label>Remarks</label>\r\n                </div>\r\n                <div class="col-sm-12 col-md-11">\r\n                    <p>{{serviceDetailsById?.remarks}}</p>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n \r\n        <hr />\r\n        <div class="detailsArea">\r\n            <h4>Details</h4>\r\n                <table class="itemRows-tble">\r\n                    <tr>\r\n                        <th>S.no</th>\r\n                        <th>Catalogue Group</th>\r\n                        <th>Catalogue</th>\r\n                        <th>Quantity</th>\r\n                        <th>Cost</th>\r\n                        <th>Total Cost</th>\r\n                    </tr>\r\n                    <tr *ngFor="let item of serviceDetailsById?.srmasterdetails;let i =index">\r\n                        <td>\r\n                            {{i+1}}\r\n                        </td>\r\n                        <td>\r\n                            <span class="row-item-val">{{item.catalogueGroupName}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <span class="row-item-val">{{item.catalogueName}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <span class="row-item-val">{{item.quantity}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <span class="row-item-val">{{item.itemCost.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})}}</span>\r\n                        </td>\r\n                        <td>\r\n                            <span class="row-item-val">{{item.totalCost.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})}}</span>\r\n                        </td>\r\n                    </tr>\r\n                    \r\n                </table>\r\n        </div>\r\n        <br />\r\n        <div class="Approval-information">\r\n            <h4>Approval information</h4>\r\n            <table class="itemRows-tble">\r\n                <tr>\r\n                    <th>Approver Name</th>\r\n                    <th>Role</th>\r\n                    <th>Status</th>\r\n                    <th>Approved Date</th>\r\n                    <th>Remarks</th>\r\n                </tr>\r\n                <tr *ngFor="let element of serviceDetailsById.approvalHeirarchy;let i=index">\r\n                    <td>\r\n                        <span class="row-item-val">{{element.approverName}}</span>\r\n                    </td>\r\n                    <td>\r\n                        <span class="row-item-val">{{element.role}}</span>\r\n                    </td>\r\n                    <td>\r\n                        <span class="row-item-val">{{element.status}}</span>\r\n                    </td>\r\n                    <td>\r\n                        <span class="row-item-val" *ngIf="element.status != \'Pending\'">{{element.approvalDate * 1000 | date:\'dd MMM yyy hh:mm a\'}}</span>\r\n                    </td>\r\n                    <td>\r\n                        <span class="row-item-val">{{element.remarks}}</span>\r\n                    </td>\r\n                </tr>\r\n                \r\n            </table>\r\n        </div>\r\n\r\n\r\n\r\n        </div>\r\n\r\n</mat-dialog-content>\r\n<mat-dialog-actions align="end">\r\n    <button mat-button mat-dialog-close class="close-btn org-btn">Cancel</button>\r\n</mat-dialog-actions>'},function(e,t){e.exports='<mat-card [@routerTransition]>\r\n    <mat-card-title>\r\n        <h4 class="SubHead">\r\n            Purchase Order - {{purchaseOrderNonConsultantDetailsById?.purchaseOrderNo}}<span class="spgeBack">\r\n                <button mat-icon-button class="pdfBtn" *ngIf="isPrivilegedAccess == \'1\'" matTooltip="Export to Pdf" [disabled]="!purchaseOrderNonConsultantDetailsById?.isFinalApproved && isPendingPO == \'1\'" (click)="exportPDF(\'pdf\')">\r\n                    <i class="fa fa-file-pdf-o"></i>\r\n                </button>\r\n                \x3c!--<button mat-icon-button class="pdfBtn" matTooltip="Export to Word Doc" (click)="exportPDF(\'doc\')">\r\n                    <i class="fa fa-file-word-o"></i>\r\n                </button>--\x3e\r\n                <a class="pgeBack" (click)="backClick()"><mat-icon><i class="material-icons">arrow_back_ios</i></mat-icon>Back</a>\r\n            </span>\r\n        </h4>\r\n    </mat-card-title>\r\n    <mat-card-content>\r\n        <div class="vendor-block">\r\n            <employee-information *ngIf="RequesterEmployeeUID != 0" [InputEmployeeNumber]="RequesterEmployeeUID"></employee-information>\r\n            \x3c!--<button (click)="allExpandState = true">Expand All </button>--\x3e\r\n            \x3c!-- Approval information --\x3e\r\n            \x3c!-- Approval information --\x3e\r\n            <mat-expansion-panel [expanded]="allExpandState">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">import_contacts</i></mat-icon> Purchase Order Details\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n\r\n                <div class="row">\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Entity</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{EntityName}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3 viw-stle-1">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO No</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.purchaseOrderNo}}</span>\r\n                        </div>\r\n                    </div>\r\n                    \x3c!--<div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PR No</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{prDetailsObjectPrNumber}}</span>\r\n                        </div>\r\n                    </div>--\x3e\r\n                    <div class="col-xs-12 col-md-3 viw-stle-1">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.createdOn| date:\'dd MMM yyy\'}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3 viw-stle-1">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PR Number</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <a (click)="LoadProjectsOnClient()" style="cursor:pointer;">{{prDetailsObjectPrNumber}}</a>\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                </div>\r\n                <div class="row">\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>SR No</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <a *ngFor="let item of srSplitlist"\r\n                               (click)="getServiceDetailsById(item)" style="cursor:pointer;padding:0px 5px 0px 0px;">SR-{{item}}</a>\r\n                            \x3c!--<a (click)="getServiceDetailsById(prDetailsObject?.srNo)" style="cursor:pointer;">{{prDetailsObject?.srNo}}</a>--\x3e\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3 viw-stle-1">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Vendor</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{vendorCompanyName}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Vendor Address</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{vendorAddress}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Location</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poLocation}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class="row">\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Ship To Address</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.shipToAddress}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Required Delivery Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{requiredDeliveryDate | date:\'dd MMM yyy\'}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Start Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poStartDate != null? (poStartDate | date:\'dd MMM yyy\'):\'NA\'}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO End Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poEndDate != null? (poEndDate | date:\'dd MMM yyy\'):\'NA\'}}</span>\r\n                        </div>\r\n                    </div>\r\n                    \x3c!--<div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Payment Term</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{paymentTerms}}</span>\r\n                        </div>\r\n                    </div>--\x3e\r\n\r\n\r\n\r\n                </div>\r\n                <div class="row">\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Currency</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poCurrency}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3 viw-stle-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Billability</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{prDetailsObject?.billableType}}</span>\r\n                        </div>\r\n                    </div>\r\n                    \x3c!--<div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Taxes</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.taxes}}</span>\r\n                        </div>\r\n                    </div>--\x3e\r\n\r\n                    <div class="col-xs-12 col-md-3 viw-stle-2">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Total Amount</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poCurrency == \'INR\'?(purchaseOrderNonConsultantDetailsById?.totalAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):poCurrency == \'USD\'?(purchaseOrderNonConsultantDetailsById?.totalAmount | currency):purchaseOrderNonConsultantDetailsById?.totalAmount}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Employee Name</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.contactPersonName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Vendor Consultant Name</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.vendorConsultantName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Internal Remarks</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.internalRemarks}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Savings Amount</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poCurrency == \'INR\'?(purchaseOrderNonConsultantDetailsById?.savingsAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):poCurrency == \'USD\'?(purchaseOrderNonConsultantDetailsById?.savingsAmount | currency):purchaseOrderNonConsultantDetailsById?.savingsAmount}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Savings Remarks</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.savingsRemarks}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                </div>\r\n\r\n\r\n                <div class="row">\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Payment Term</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{paymentTerms}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>OtherPayment Term</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.otherPaymentTerms}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Delivery</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.deliveryRemarks}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Taxes</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.taxes}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Reference</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.reference}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Warranty</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.warranty}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Note</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.notes}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-12">\r\n                            <label>Remarks</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-12">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.poRemarks}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class="prd-item-div">\r\n                    <label class="prd-item-lble">Products List</label>\r\n                </div>\r\n                <table class="itemRows-tble">\r\n                    <tr>\r\n                        <th>PR Number</th>\r\n                        <th>Services</th>\r\n                        <th>Product/Item</th>\r\n                        <th>UOM</th>\r\n                        <th>Quantity</th>\r\n                        <th>Unit Rate</th>\r\n                        <th>Amount</th>\r\n                        <th>Description</th>\r\n                        \x3c!--<th>Action</th>--\x3e\r\n                    </tr>\r\n                    <tr *ngFor="let purchaseOrderDetail of purchaseOrderGoodsLineDetails">\r\n                        <td>{{purchaseOrderDetail?.prNumber}}</td>\r\n                        <td>{{purchaseOrderDetail?.poProductName}}</td>\r\n                        <td>{{purchaseOrderDetail?.poServiceName}}</td>\r\n                        <td>{{purchaseOrderDetail?.uom}}</td>\r\n                        <td>{{purchaseOrderDetail?.quantity}}</td>\r\n                        <td>{{poCurrency == \'INR\'?(purchaseOrderDetail?.unitRate.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):poCurrency == \'USD\'?(purchaseOrderDetail?.unitRate | currency):purchaseOrderDetail?.unitRate}}</td>\r\n                        <td>{{poCurrency == \'INR\'?(purchaseOrderDetail?.amount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):poCurrency == \'USD\'?(purchaseOrderDetail?.amount | currency):purchaseOrderDetail?.amount}}</td>\r\n                        <td>{{purchaseOrderDetail?.description}}</td>\r\n                    </tr>\r\n\r\n                </table>\r\n            </mat-expansion-panel>\r\n\r\n            <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">attachment</i></mat-icon>  Attachments\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <div>\r\n\r\n                    <table class="itemRows-tble" *ngIf="purchaseOrderAttachmentLineDeatils.length > 0">\r\n                        <tr>\r\n                            <th width="6%">Sr.No.</th>\r\n                            <th width="22%">Document Description</th>\r\n                            <th>Attachment</th>\r\n                        </tr>\r\n                        <tr *ngFor="let purchaseAttachment of purchaseOrderAttachmentLineDeatils; let i=index">\r\n                            <td>{{i+1}}</td>\r\n                            <td>{{purchaseAttachment.documentDescription}} </td>\r\n                            <td><button mat-icon-button class="smlBtn" (click)="downloadPDF(purchaseAttachment.id)"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp; {{purchaseAttachment.documentName}}</button></td>\r\n                        </tr>\r\n\r\n                    </table>\r\n\r\n                </div>\r\n                <div class="row" *ngIf=" purchaseOrderAttachmentLineDeatils.length == 0">\r\n                    <h4 style="text-align: center;margin: 12px;padding: 6px;"> No Attachment found....</h4>\r\n                </div>\r\n\r\n            </mat-expansion-panel>\r\n\r\n            <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">attachment</i></mat-icon>  Annexure Documents\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <div>\r\n                    <table class="itemRows-tble" *ngIf="PurchaseOrderAnnexureLineDeatils.length > 0">\r\n                        <tr>\r\n                        <th width="6%">Sr.No.</th>\r\n                        <th width="22%">Document Description</th>\r\n                        <th>Attachment</th>\r\n                        </tr>\r\n                        <tr *ngFor="let purchaseAnnexure of PurchaseOrderAnnexureLineDeatils; let i=index">\r\n                            <td>{{i+1}}</td>\r\n                            <td>{{purchaseAnnexure.documentDescription}}</td>\r\n                          <td> <button mat-icon-button class="smlBtn" (click)="downloadannexuredoc(purchaseAnnexure.purchaseOrderMasterId,purchaseAnnexure.employeeId)"> <i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;  {{purchaseAnnexure.documentName}}\r\n                            </button>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </div>\r\n                <div class="row" *ngIf=" PurchaseOrderAnnexureLineDeatils.length == 0">\r\n                    <h4 style="text-align: center;margin: 12px;padding: 6px;">No Attachment found...</h4>\r\n                </div>\r\n            </mat-expansion-panel>\r\n\r\n            <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">check_circle_outline</i></mat-icon> Approval Information\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <br />\r\n                <table class="itemRows-tble">\r\n                    <tr>\r\n                        <th>ApproverNname</th>\r\n                        <th>Role</th>\r\n                        <th>Status</th>\r\n                        <th>Approved Date</th>\r\n                        <th>Remarks</th>\r\n                    </tr>\r\n                    <tr *ngFor="let element of approvalHeirarchyList;let i=index">\r\n                        <td>{{element.approverName}} </td>\r\n                        <td>{{element.role}}   (Level-{{i+1}})</td>\r\n                        <td>{{element.status}}</td>\r\n                        <td><span *ngIf="element.status != \'Pending\'">{{element.approvalDate * 1000 | date:\'dd MMM yyy hh:mm a\'}}</span></td>\r\n\r\n                        \x3c!--<td>{{element.status==\'Pending\'?"": _timesheetService.getFormattedDate(element.approvedDate)}}</td>--\x3e\r\n                        <td>{{element.remarks}}</td>\r\n                    </tr>\r\n                </table>\r\n                <br />\r\n                <div class="row" *ngIf="isPendingPO == 0">\r\n\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <label>Remarks<span class="asterik-mark">*</span></label>\r\n                        <textarea class="cust-validation" style="width:100%;min-height: 30px;" autocomplete="off" required [(ngModel)]="txtRemarks"></textarea>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <mat-action-row *ngIf="isPendingPO == 0">\r\n                    <button mat-button class="approve-btn" *ngIf="isFinanceManagerLoggedIn" (click)="UpdatePOStatus(0,\'edit&approve\',0)"><i class="fa fa-check" aria-hidden="true"></i> &nbsp;Edit & Approve</button>\r\n                    <button mat-button class="status-btn" (click)="UpdatePOStatus(0,\'edit PO\',0)"> <i class="fa fa-undo" aria-hidden="true"></i> &nbsp;Edit PO</button>\r\n\r\n                    <button mat-button class="status-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(1,\'redraft with approval\',2)"> <i class="fa fa-undo" aria-hidden="true"></i> &nbsp;Redraft WA</button>\r\n                    \x3c!--<button mat-button class="status-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(1,\'redraft without approval\',3)"> <i class="fa fa-undo" aria-hidden="true"></i> &nbsp;Redraft WOA</button>--\x3e\r\n\r\n                    <button mat-button class="reject-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(-1,\'reject\',0)"> <i class="fa fa-times" aria-hidden="true"></i> &nbsp;Reject</button>\r\n                    <button mat-button class="approve-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(1,\'approve\',0)"><i class="fa fa-check" aria-hidden="true"></i> &nbsp; Approve</button>\r\n                </mat-action-row>\r\n            </mat-expansion-panel>\r\n            <div class="col-xs-12 col-md-4" *ngIf="isClose == \'close\'">\r\n                <mat-form-field>\r\n                    <textarea matInput placeholder="Reason for closing" [(ngModel)]="closeRemarks"></textarea>\r\n                </mat-form-field>\r\n            </div>\r\n\r\n            <mat-action-row>\r\n                <button *ngIf="isClose == \'close\'" mat-button class="blu-btn" (click)="ClosedPurchaseOrder()">\r\n                    Submit\r\n                </button>\r\n            </mat-action-row>\r\n        </div>\r\n    </mat-card-content>\r\n</mat-card>\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>\r\n'},function(e,t){e.exports='<style>\r\n    .row.prDetailsBasic {\r\n        font-size: 11px;\r\n    }\r\n\r\n    .prd-item-div {\r\n        margin: 8px 0;\r\n        background: #ddd;\r\n    }\r\n\r\n        .prd-item-div label {\r\n            padding: 6px 12px;\r\n            font-size: 12px;\r\n            margin: 0;\r\n        }\r\n\r\n    .prDTile div {\r\n        font-size: 11px;\r\n    }\r\n\r\n    .ItemDetailblock {\r\n        font-size: 11px;\r\n        padding: 0 12px;\r\n    }\r\n\r\n    .row.prDTile {\r\n        padding: 0 12px;\r\n    }\r\n    .col-xs-12.col-md-2.resource {\r\n        width: 15%;\r\n    }\r\n    .col-xs-12.col-md-2.description {\r\n        width: 25%;\r\n    }\r\n    .col-xs-12.col-md-2.workType {\r\n        width: 11%;\r\n    }\r\n    .col-xs-12.col-md-2.requiredDate {\r\n        width: 12%;\r\n    }\r\n    .col-xs-12.col-md-1.unitRate {\r\n        width: 11%;\r\n    }\r\n    .col-xs-12.col-md-1.quantity {\r\n        width: 8%;\r\n    }\r\n    .col-xs-12.col-md-2.amount {\r\n        width: 8%;\r\n    }\r\n    .col-xs-12.col-md-2.location {\r\n        width: 10%;\r\n    }\r\n    .ItemDetailblock:nth-child(even) {\r\n        background: #efefef;\r\n    }\r\n    .close-btn {\r\n        padding: 4px;\r\n        height: 32px;\r\n        line-height: 1;\r\n        font-size: 11px;\r\n    }\r\n</style>\r\n<h2 mat-dialog-title style="border-bottom: 1px solid;">PR Details {{goodsPRObject.prNumber}}</h2>\r\n<mat-dialog-content class="mat-typography">\r\n    <div class="prDetailsBlocks">\r\n\r\n        <div class="row prDetailsBasic">\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>Entity</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject.tenantName}}</span>\r\n                </div>\r\n            </div>\r\n\r\n\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>PR Date</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject?.createdOn| date:\'dd MMM yyy\'}}</span>\r\n                </div>\r\n            </div>\r\n\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>Requestor</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject?.requesterName}}</span>\r\n                </div>\r\n            </div>\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>PR For</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject?.prCategory}}</span>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n        <div class="row prDetailsBasic">\r\n\r\n\r\n\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>Client</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject?.clientName}}</span>\r\n                </div>\r\n            </div>\r\n\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>Project</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject?.projectName}}</span>\r\n                </div>\r\n            </div>\r\n\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>BU</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject?.buName}}</span>\r\n                </div>\r\n            </div>\r\n\r\n\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>SBU</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject?.sbuName}}</span>\r\n                </div>\r\n            </div>\r\n\r\n\r\n\r\n        </div>\r\n       \r\n        <div class="row prDetailsBasic">\r\n\r\n\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>Budget Type</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject.budgetType}}</span>\r\n                </div>\r\n            </div>\r\n\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>Billability</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject.billableType}}</span>\r\n                </div>\r\n            </div>\r\n\r\n\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>PR Currency</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject.currency}}</span>\r\n                </div>\r\n            </div>\r\n\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>Budget Ref# </label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject?.budgetReferenceNo}}</span>\r\n                </div>\r\n            </div>\r\n\r\n\r\n        </div>\r\n        <div class="row prDetailsBasic">\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>Total Amount</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <span>{{goodsPRObject.currency == \'INR\'?(goodsPRObject.totalPRAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):goodsPRObject.currency == \'USD\'?(goodsPRObject.totalPRAmount | currency):goodsPRObject.totalPRAmount}}</span>\r\n                </div>\r\n            </div>\r\n            <div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-5">\r\n                    <label>SR No</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-7">\r\n                    <a *ngFor="let item of srSplitlist"\r\n                       (click)="getServiceDetailsById(item)" style="cursor:pointer;padding:0px 5px 0px 0px;">SR-{{item}}</a>\r\n                    \x3c!--<a (click)="getServiceDetailsById(goodsPRObject?.srNo)" style="cursor:pointer;">{{goodsPRObject?.srNo}}</a>--\x3e\r\n                </div>\r\n            </div>\r\n\r\n\r\n            <div class="col-xs-12 col-md-6">\r\n                <div class="col-xs-12 col-md-2">\r\n                    <label>Justification</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-10" style="padding-left: 30px;">\r\n                    <span>{{goodsPRObject?.remarks}}</span>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n        \r\n        <div class="prd-item-div">\r\n            <label class="prd-item-lble">Products Item</label>\r\n        </div>\r\n        \x3c!-- Item Detail block --\x3e\r\n        <div class="row prDTile">\r\n            <div class="col-xs-12 col-md-2 resource">\r\n                <label>Services</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 workType">\r\n                <label>Product/Item</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 requiredDate">\r\n                <label>Required Date</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 location">\r\n                <label>Required Location</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-1 quantity">\r\n                <label>Quantity</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-1 unitRate">\r\n                <label>Unit Rate</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 amount">\r\n                <label> Amount</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 description">\r\n                <label>Description</label>\r\n            </div>\r\n        </div>\r\n        <div class="ItemDetailblock"  *ngFor="let item of goodsPRObject.purchaseRequestGoodsDetails">\r\n            <div class="row">\r\n                \x3c!-- REpeatable Rows--\x3e\r\n                <div class="col-xs-12 col-md-2 resource">\r\n                    <span>{{item?.productName}}</span>\r\n                </div>\r\n\r\n                <div class="col-xs-12 col-md-2 workType">\r\n                    <span>{{item?.itemName}}</span>\r\n                </div>\r\n                <div class="col-xs-12 col-md-2 requiredDate">\r\n                    <span>{{item?.requiredDate | date:\'dd MMM yyy\'}}</span>\r\n                </div>\r\n                <div class="col-xs-12 col-md-2 location">\r\n                    <span>{{item?.unitLocationString }}</span>\r\n                </div>\r\n                <div class="col-xs-12 col-md-1 quantity">\r\n\r\n\r\n                    <span>{{item?.quantity}}</span>\r\n\r\n                </div>\r\n                <div class="col-xs-12 col-md-1 unitRate">\r\n\r\n\r\n                    <span>{{goodsPRObject.currency == \'INR\'?(item?.unitRate.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):goodsPRObject.currency == \'USD\'?(item?.unitRate | currency):item?.unitRate}}</span>\r\n\r\n                </div>\r\n               \r\n                \r\n                <div class="col-xs-12 col-md-2 amount">\r\n\r\n\r\n                    <span>{{goodsPRObject.currency == \'INR\'?(item?.amount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):goodsPRObject.currency == \'USD\'?goodsPRObject.currency == \'USD\'?(item?.amount | currency):item?.amount:item?.amount}}</span>\r\n\r\n                </div>\r\n                <div class="col-xs-12 col-md-2 description">\r\n\r\n                    <span>{{item?.description}}</span>\r\n\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n        \x3c!-- Approval Detail block --\x3e\r\n        \r\n        <div class="prd-item-div">\r\n            <label class="prd-item-lble">Approval Information</label>\r\n        </div>\r\n        \x3c!-- Approval Detail block --\x3e\r\n        <div class="row prDTile">\r\n            <div class="col-xs-12 col-md-2 resource">\r\n                <label>Approver Name</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 workType">\r\n                <label>Role</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 requiredDate">\r\n                <label>Status</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 quantity">\r\n                <label>Approved Date</label>\r\n            </div>\r\n            <div class="col-xs-12 col-md-2 unitRate">\r\n                <label>Remarks</label>\r\n            </div>\r\n            \r\n        </div>\r\n        <div class="ItemDetailblock"  *ngFor="let item of goodsPRObject.approvalHierarchy">\r\n            <div class="row">\r\n                \x3c!-- REpeatable Rows--\x3e\r\n                <div class="col-xs-12 col-md-2 resource">\r\n                    <span>{{item?.approverName}}</span>\r\n                </div>\r\n\r\n                <div class="col-xs-12 col-md-2 workType">\r\n                    <span>{{item?.role == \'Project Manager\'?\'Department Head\':item.role}}</span>\r\n                </div>\r\n                <div class="col-xs-12 col-md-2 requiredDate">\r\n                    <span>{{item?.status }}</span>\r\n                </div>\r\n                <div class="col-xs-12 col-md-2 quantity">\r\n\r\n\r\n                    <span *ngIf="item?.status != \'Pending\'">{{item.approvalDate * 1000 | date:\'dd MMM yyyy hh:mm a\'}}</span>\r\n\r\n                </div>\r\n                <div class="col-xs-12 col-md-2 unitRate">\r\n\r\n\r\n                    <span>{{item?.remarks}}</span>\r\n\r\n                </div>\r\n               \r\n                \r\n               \r\n\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n        \x3c!-- Approval Detail block --\x3e\r\n    </div>\r\n\r\n</mat-dialog-content>\r\n<mat-dialog-actions align="end">\r\n    <button class="close-btn org-btn" mat-button mat-dialog-close>Cancel</button>\r\n</mat-dialog-actions>\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>'},function(e,t){e.exports='\x3c!--<h1 mat-dialog-title>\r\n    {{title}}\r\n</h1>--\x3e\r\n\r\n    <div mat-dialog-content>\r\n        <p>{{message}}</p>\r\n    </div>\r\n\r\n    <div mat-dialog-actions style="display: inline-block;width: 100%;text-align: right;">\r\n        <ng-container *ngIf="!myBtnOption">\r\n            <button mat-button (click)="onDismiss()">No</button>\r\n            <button mat-raised-button color="primary" (click)="onConfirm()">Yes</button>\r\n        </ng-container>\r\n        <ng-container *ngIf="myBtnOption">\r\n            <button mat-button (click)="onDismiss()">{{ cancelTxt }}</button>\r\n            <button mat-raised-button color="primary" (click)="onConfirm()">{{ yesTxt }}</button>\r\n        </ng-container>\r\n    </div>'},function(e,t,n){var r=n(1064);e.exports="string"==typeof r?r:r.toString()},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,".emp-info-blk {\r\n    padding: 0px 12px 12px 12px;\r\n    /*font-size: 12px;*/\r\n}\r\n.col-xs-12.col-md-4 label {\r\n    /*font-size: 12px;*/\r\n}\r\n.emp-info-blk .col-xs-12.col-md-3 {\r\n    padding: 0;\r\n}",""])},function(e,t,n){"use strict";var r,i=this&&this.__extends||(r=function(e,t){return(r=Object.setPrototypeOf||{__proto__:[]}instanceof Array&&function(e,t){e.__proto__=t}||function(e,t){for(var n in t)t.hasOwnProperty(n)&&(e[n]=t[n])})(e,t)},function(e,t){function n(){this.constructor=e}r(e,t),e.prototype=null===t?Object.create(t):(n.prototype=t.prototype,new n)}),a=function(){return function(){}}();(function(e){function t(){return null!==e&&e.apply(this,arguments)||this}i(t,e)})(a),function(e){function t(){return null!==e&&e.apply(this,arguments)||this}i(t,e)}(a),function(e){function t(){return null!==e&&e.apply(this,arguments)||t