wordMain">\r\n                    <div class="ChangePassword">\r\n                        <form [formGroup]="changePwdForm" (ngSubmit)="onChangePwdSubmit(changePwdForm)" novalidate>\r\n                            <div class="row">\r\n                                \x3c!--<div class="col-xs-12 col-md-12">\r\n                        <mat-form-field>\r\n                            <input matInput readonly value="User Name"/>\r\n                        </mat-form-field>\r\n                    </div>--\x3e\r\n                                <div class="col-xs-12 col-md-12">\r\n                                    <mat-form-field>\r\n                                        <input type="password" matInput placeholder="Old Password" formControlName="oldPassword" required />\r\n                                    </mat-form-field>\r\n                                </div>\r\n                                <div class="col-xs-12 col-md-12">\r\n                                    <mat-form-field>\r\n                                        <input type="password" matInput placeholder="New Password" [(ngModel)]="newPassword" formControlName="newPassword" minlength="8" maxlength="20" required />\r\n\r\n                                    </mat-form-field>\r\n                                    <div class="password-section" *ngIf="newPassword">\r\n\r\n                                        \x3c!-- Strength Bar --\x3e\r\n                                        <div class="strength-container">\r\n                                            <password-strength-bar [passwordToCheck]="newPassword"\r\n                                                                   [barLabel]="barLabel"\r\n                                                                   (valueChange)="displayScore($event)">\r\n                                            </password-strength-bar>\r\n                                        </div>\r\n\r\n                                        \x3c!-- Rules --\x3e\r\n                                        <div class="password-rules">\r\n                                            <p class="rules-title">Password must contain:</p>\r\n\r\n                                            <ul>\r\n                                                <li>\r\n                                                    <i [ngClass]="hasUpperCase() ? \'fa fa-check-circle valid-icon\' : \'fa fa-times-circle invalid-icon\'"></i>\r\n                                                    <span>At least one uppercase letter</span>\r\n                                                </li>\r\n\r\n                                                <li>\r\n                                                    <i [ngClass]="hasLowerCase() ? \'fa fa-check-circle valid-icon\' : \'fa fa-times-circle invalid-icon\'"></i>\r\n                                                    <span>At least one lowercase letter</span>\r\n                                                </li>\r\n\r\n                                                <li>\r\n                                                    <i [ngClass]="hasNumber() ? \'fa fa-check-circle valid-icon\' : \'fa fa-times-circle invalid-icon\'"></i>\r\n                                                    <span>At least one number</span>\r\n                                                </li>\r\n\r\n                                                <li>\r\n                                                    <i [ngClass]="hasSpecialChar() ? \'fa fa-check-circle valid-icon\' : \'fa fa-times-circle invalid-icon\'"></i>\r\n                                                    <span>At least one special character</span>\r\n                                                </li>\r\n\r\n                                                <li>\r\n                                                    <i [ngClass]="hasMinLength() ? \'fa fa-check-circle valid-icon\' : \'fa fa-times-circle invalid-icon\'"></i>\r\n                                                    <span>Minimum 8 characters</span>\r\n                                                </li>\r\n\r\n                                                <li>\r\n                                                    <i [ngClass]="!hasSequence() ? \'fa fa-check-circle valid-icon\' : \'fa fa-times-circle invalid-icon\'"></i>\r\n                                                    <span>No sequential characters allowed</span>\r\n                                                </li>\r\n                                            </ul>\r\n                                        </div>\r\n\r\n                                    </div>\r\n\r\n                                </div>\r\n                                <div class="col-xs-12 col-md-12">\r\n                                    <mat-form-field>\r\n                                        <input type="password" matInput placeholder="Confirm New Password" [(ngModel)]="confirmNewPassword" formControlName="confirmNewPassword" minlength="8" maxlength="20" required/>\r\n                                        <mat-error *ngIf="!changePwdForm.hasError(\'notEquivalent\')">\r\n                                            Password Mismatch\r\n                                        </mat-error>\r\n\r\n                                    </mat-form-field>\r\n                                </div>\r\n                            </div>\r\n                            <div class="row submit-btn-area">\r\n                                <button mat-button class="org-btn" type="button" (click)="routerHome()">\r\n                                    Cancel\r\n                                </button>\r\n                                <button mat-button type="submit" class="blu-btn" [disabled]="!changePwdForm.valid && !changePwdForm.hasError(\'incorrect\')">Submit</button>\r\n                            </div>\r\n                        </form>\r\n                    </div>\r\n                </div>\r\n                <div class="passwordDesAreaMain">\r\n                    <div class="passwordDesArea">\r\n                        <p><b style="color:#cc0c0c;">NOTE : </b>Password must be minimum 8 charactes, which contains atleast one capital letter, one number, one special chararcter and one small letter</p>\r\n                    </div>\r\n                </div>\r\n                </div>\r\n            </div>\r\n</mat-card>\r\n    <div class="loading-shade"\r\n         *ngIf="isLoadingResults">\r\n        <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n    </div>\r\n</div>\r\n'},function(e,t,n){var r=n(1022);e.exports="string"==typeof r?r:r.toString()},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,".ChangePassword {\r\n    border: 1px solid #b9b9b9;\r\n    padding: 12px;\r\n    /*margin: 0 auto;*/\r\n    width: 58%;\r\n    text-align: center;\r\n    float: right;\r\n}\r\nbutton.org-btn {\r\n    background-color: #f56a07;\r\n    box-shadow: none;\r\n    color: #fff;\r\n    padding: 2px 13px;\r\n    min-width: 22px;\r\n    line-height: 2;\r\n}\r\nbutton.blu-btn {\r\n    background-color: #00b9d7;\r\n    box-shadow: none;\r\n    color: #fff;\r\n    padding: 2px 13px;\r\n    min-width: 22px;\r\n    line-height: 2;\r\n}\r\n.row.submit-btn-area {\r\n    margin: 20px;\r\n}\r\n.passInner {\r\n    display: inline-block;\r\n}\r\n.ChangePasswordMain {\r\n    text-align: right;\r\n    width: 69%;\r\n    float: left;\r\n}\r\n.passwordDesAreaMain {\r\n    display: inline-block;\r\n    width: 20%;\r\n    text-align: justify;\r\n    margin-left: 30px;\r\n}\r\n.passwordDesArea p {\r\n    color: #1f98b5;\r\n    font-size: 11px;\r\n    margin-top: 24%;\r\n}\r\n\r\n.password-section {\r\n    margin-top: 10px;\r\n    padding: 12px;\r\n    border-radius: 6px;\r\n    background: #f9fafc;\r\n    border: 1px solid #e0e0e0;\r\n}\r\n\r\n.strength-container {\r\n    margin-bottom: 10px;\r\n}\r\n\r\n.rules-title {\r\n    font-size: 13px;\r\n    font-weight: 600;\r\n    margin-bottom: 8px;\r\n    color: #333;\r\n}\r\n\r\n