.availed}}</td>\r\n                <td>{{leave.cancelled}}</td>\r\n                <td>{{leave.availableBalance}}</td>\r\n                \x3c!--<ng-container *ngFor="let leaveValue of leave.value;let inx=index;">\r\n        <td *ngIf="inx > 0 && leaveValue.key==\'Available Bal\'">\r\n            {{ leaveValue.value}}\r\n        </td>\r\n    </ng-container>--\x3e\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n    <h4 *ngIf="LeaveBalanceSummary.length === 0 " style="text-align: center;">No records found...</h4>\r\n\r\n    <div class="loading-shade"\r\n         *ngIf="isLoadingResults">\r\n        <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n    </div>\r\n</mat-card>\r\n\r\n'},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,".leave_history {\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n    border: 1px solid #e4e4e4;\r\n}\r\n\r\n    .leave_history td, .leave_history th {\r\n        padding: 8px;\r\n        text-align: center;\r\n        font-size: 13px;\r\n    }\r\n\r\n    .leave_history tr:nth-child(even) {\r\n        background-color: #f2f2f2;\r\n    }\r\n\r\n    .leave_history tr:hover {\r\n        background-color: #e6e6e6;\r\n    }\r\n\r\n    .leave_history th {\r\n        padding-top: 8px;\r\n        padding-bottom: 8px;\r\n        background-color: #0c85b3;\r\n        color: white;\r\n    }\r\n    .leave_history td a {\r\n        cursor: pointer;\r\n    }\r\nbutton.tsViewCloseBtn {\r\n    min-width: 2px;\r\n    float: right;\r\n    line-height: 0;\r\n    padding: 4px;\r\n}\r\n.sub-head-inner-1, .sub-head-inner-2 {\r\n    display: inline-block;\r\n    padding: 12px;\r\n}\r\n\r\nspan.lebelempName, span.empName {\r\n    margin: 3px 7px;\r\n    font-size: 11px;\r\n}\r\n\r\nspan.lebelempName {\r\n    font-weight: 600;\r\n    padding: 5px;\r\n    font-size: 11px;\r\n}",""])},function(e,t){e.exports='\r\n<h4 class="SubHead">Leave Summary Details<button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn"><i class="fa fa-times" aria-hidden="true"></i>&nbsp;</button></h4>\r\n<div class="sub-head-inner">\r\n    <div class="sub-head-inner-1"><span class="lebelempName">Employee No </span>   <span class="empName">{{empId}}</span></div>\r\n    <div class="sub-head-inner-2">  <span  class="lebelempName">Employee Name </span><span class="empName">{{empName}}</span></div>\r\n</div>\r\n<table class="table itemRows-tble">\r\n    <thead>\r\n        <tr>\r\n            <th>Leave type </th>\r\n            <th>From date </th>\r\n            <th>To date</th>\r\n            <th> No of days</th>\r\n            <th>Status</th>\r\n            <th> Remarks</th>\r\n            <th>Applied On</th>\r\n            <th>Approval remarks </th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n\r\n        <tr *ngFor="let leave of LeaveDetails">\r\n            <td>{{leave.leaveName}}</td>\r\n            <td>{{this._timesheetService.getFormattedDate(leave.leaveTransactionList.startDate)}}</td>\r\n            <td>{{this._timesheetService.getFormattedDate(leave.leaveTransactionList.endDate)}}</td>\r\n            <td>{{leave.leaveTransactionList.noOfDays}}\r\n            \n            </td>              \n \x3c!--<td>{{leave.leaveTransactionList.status==1?\'Applied\':leave.leaveTransactionList.status==0?\'Cancelled Before Approval\':leave.leaveTransactionList.status==2?\'Approved\':leave.leaveTransactionList.status==3?\'Cancelled After Approval\':leave.leaveTransactionList.status==4?\'Cancelled Approved Leave\':leave.leaveTransactionList.status==5?\'Cancelled Leave By Manager\':\'\'}}</td>--\x3e\r\n            <td>{{leave.leaveTransactionList.statusValue}}</td>\r\n            <td> {{leave.leaveTransactionList.employeeRemarks}}</td>\r\n            <td>{{this._timesheetService.getFormattedDate(leave.leaveTransactionList.createdOn)}}</td>\r\n            <td>{{leave.leaveTransactionList.approvalRemarks}}</td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>\r\n\r\n'},function(e,t){e.exports='\r\n<h4 class="SubHead">Leave Granted Details<button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn"><i class="fa fa-times" aria-hidden="true"></i>&nbsp;</button></h4>\r\n\r\n<table class="table itemRows-tble">\r\n    <thead>\r\n        <tr>\r\n            <th>Leave type </th>\r\n            <th>From date </th>\r\n            <th>To date</th>\r\n            <th> No of days</th>\r\n            <th>Status</th>\r\n            <th>Created Date</th>\r\n           \r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        <tr *ngFor="let leaveGrant of LeaveGrantedDetails">\r\n            <td>{{leaveGrant.leaveName}}</td>\r\n            <td>{{this._timesheetService.getFormattedDate(leaveGrant.startDate)}}</td>\r\n            <td>{{this._timesheetService.getFormattedDate(leaveGrant.endDate)}}</td>\r\n            <td>{{leaveGrant.noOfDays}}</td>\r\n            <td>{{leaveGrant.status}}</td>\r\n            <td>{{this._timesheetService.getFormattedDate(leaveGrant.createdDate)}}</td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>\r\n\r\n'},function(e,t){e.exports='<style>\r\n    .vPONC ::ng-deep mat-expansion-panel-header {\r\n        background: #c4f3e8;\r\n        height: 33px !important;\r\n    }\r\n    .vPONC label, .vPONC span {\r\n        font-size: 11px;\r\n    }\r\n\r\n</style>\r\n    <mat-card-title>\r\n        <h4 class="SubHead">\r\n            Purchase Order - {{purchaseOrderNonConsultantDetailsById?.purchaseOrderNo}}\r\n            <span class="spgeBack">\r\n                <button mat-icon-button class="pdfBtn" matTooltip="Export to Pdf" [disabled]="!purchaseOrderNonConsultantDetailsById?.isFinalApproved && isPendingPO == \'1\'" (click)="exportPDF(\'pdf\')">\r\n                    <i class="fa fa-file-pdf-o"></i>\r\n                </button>\r\n                <button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn"><i class="fa fa-times" aria-hidden="true"></i>&nbsp;</button>\r\n            </span>\r\n        </h4>\r\n    </mat-card-title>\r\n    <mat-card-content class="vPONC">\r\n        <div class="vendor-block">\r\n            \x3c!--<employee-information *ngIf="RequesterEmployeeUID != 0" [InputEmployeeNumber]="RequesterEmployeeUID"></employee-information>--\x3e\r\n        \r\n            \x3c!--<button (click)="allExpandState = true">Expand All </button>--\x3e\r\n            \x3c!-- Approval information --\x3e\r\n            \x3c!-- Approval information --\x3e\r\n            <mat-expansion-panel [expanded]="allExpandState">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">import_contacts</i></mat-icon> Purchase Order Details\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n\r\n                <div class="row">\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Entity</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{EntityName}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3 viw-stle-1">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO No</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.purchaseOrderNo}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PR No</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{prDetailsObjectPrNumber}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3 viw-stle-1">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.createdOn| date:\'dd MMM yyy\'}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3 viw-stle-1">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Vendor</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{vendorCompanyName}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n                <div class="row">\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Vendor Address</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{vendorAddress}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Location</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poLocation}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Ship To Address</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.shipToAddress}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Required Delivery Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{requiredDeliveryDate | date:\'dd MMM yyy\'}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n                <div class="row">\r\n\r\n                    \x3c!--<div class="row" >\r\n                <div class="col-xs-12 col-md-12" style="padding:0;">\r\n                    <div class="col-xs-12 col-md-2" style="padding:0;">\r\n                        <label>Ship To Address</label>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-10" style="padding:0;">\r\n                        <span>{{purchaseOrderNonConsultantDetailsById?.shipToAddress}}</span>\r\n                    </div>\r\n                </div>\r\n            </div>--\x3e\r\n\r\n                </div>\r\n                <div class="row">\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Start Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poStartDate != null? (poStartDate | date:\'dd MMM yyy\'):\'NA\'}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO End Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poEndDate != null? (poEndDate | date:\'dd MMM yyy\'):\'NA\'}}</span>\r\n                        </div>\r\n                    </div>\r\n                    \x3c!--<div class="col-xs-12 col-md-3">\r\n                <div class="col-xs-12 col-md-4">\r\n                    <label>Payment Term</label>\r\n                </div>\r\n                <div class="col-xs-12 col-md-8">\r\n                    <span>{{paymentTerms}}</span>\r\n                </div>\r\n            </div>--\x3e\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Currency</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poCurrency}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n                <div class="row">\r\n                    <div class="col-xs-12 col-md-3 viw-stle-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Billability</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{prDetailsObject?.billableType}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3 viw-stle-2">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Total Amount</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poCurrency == \'INR\'?(purchaseOrderNonConsultantDetailsById?.totalAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):poCurrency == \'USD\'?(purchaseOrderNonConsultantDetailsById?.totalAmount | currency):purchaseOrderNonConsultantDetailsById?.totalAmount}}</span>\x3c!--attributeElementName--\x3e\r\n\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Employee Name</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.contactPersonName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Vendor Consultant Name</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.vendorConsultantName}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Internal Remarks</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.internalRemarks}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Savings Amout</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poCurrency == \'INR\'?(purchaseOrderNonConsultantDetailsById?.savingsAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):poCurrency == \'USD\'?(purchaseOrderNonConsultantDetailsById?.savingsAmount | currency):purchaseOrderNonConsultantDetailsById?.savingsAmount}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Savings Remarks</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.savingsRemarks}}</span>\x3c!--attributeElementName--\x3e\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <div class="row">\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Payment Terms</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{paymentTerms}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>OtherPayment Term</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.otherPaymentTerms}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Delivery</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.deliveryRemarks}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Taxes</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.taxes}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Reference</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.reference}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Warranty</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.warranty}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Note</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-11">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.notes}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-12">\r\n                        <div class="col-xs-12 col-md-1" style="padding:0;">\r\n                            <label>Remarks</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-10">\r\n                            <span>{{purchaseOrderNonConsultantDetailsById?.poRemarks}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class="prd-item-div">\r\n                    <label class="prd-item-lble">Products List</label>\r\n                </div>\r\n                <table class="itemRows-tble">\r\n                    <tr>\r\n                        <th>PR Number</th>\r\n                        <th>Services</th>\r\n                        <th>Product/Item</th>\r\n                        <th>UOM</th>\r\n                        <th>Quantity</th>\r\n                        <th>Unit Rate</th>\r\n                        <th>Amount</th>\r\n                        <th>Description</th>\r\n                    </tr>\r\n                    <tr *ngFor="let purchaseOrderDetail of purchaseOrderGoodsLineDetails">\r\n                        <td>{{purchaseOrderDetail?.prNumber}}</td>\r\n                        <td>{{purchaseOrderDetail?.poProductName}}</td>\r\n                        <td>{{purchaseOrderDetail?.poServiceName}}</td>\r\n                        <td>{{purchaseOrderDetail?.uom}}</td>\r\n                        <td>{{purchaseOrderDetail?.quantity}}</td>\r\n                        <td>{{poCurrency == \'INR\'?(purchaseOrderDetail?.unitRate.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):poCurrency == \'USD\'?(purchaseOrderDetail?.unitRate | currency):purchaseOrderDetail?.unitRate}}</td>\r\n                        <td>{{poCurrency == \'INR\'?(purchaseOrderDetail?.amount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):poCurrency == \'USD\'?(purchaseOrderDetail?.amount | currency):purchaseOrderDetail?.amount}}</td>\r\n                        <td>{{purchaseOrderDetail?.description}}</td>\r\n                    </tr>\r\n\r\n                </table>\r\n\r\n\r\n                \x3c!--<mat-action-row>\r\n            <button mat-button class="org-btn" (click)="prevStep()">\r\n                Previous\r\n            </button>\r\n            <button mat-button class="blu-btn" (click)="nextStep()">Next</button>\r\n        </mat-action-row>--\x3e\r\n            </mat-expansion-panel>\r\n\r\n            <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">attachment</i></mat-icon>  Attachments\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <div>\r\n\r\n                    <table class="itemRows-tble" *ngIf="purchaseOrderAttachmentLineDeatils.length > 0">\r\n                        <tr><th width="6%">No</th><th width="22%">Document Description</th><th>Attachment</th>\x3c!--<th>Action</th>--\x3e </tr>\r\n                        <tr *ngFor="let purchaseAttachment of purchaseOrderAttachmentLineDeatils; let i=index">\r\n                            <td>{{i+1}}</td>\r\n                            \x3c!--<td> Certificate of Incorporation</td>--\x3e\r\n                            <td>{{purchaseAttachment.documentDescription}} </td>\r\n                            <td><button mat-icon-button class="smlBtn" (click)="downloadPDF(purchaseAttachment.id)"><i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp; {{purchaseAttachment.documentName}}</button></td>\r\n                            \x3c!--<td>\r\n                        <button class="btnRemv">\r\n                            <i class="fa fa-download" aria-hidden="true"></i>\r\n                        </button>\r\n                    </td>--\x3e\r\n                        </tr>\r\n\r\n                    </table>\r\n\r\n                </div>\r\n                <div class="row" *ngIf=" purchaseOrderAttachmentLineDeatils.length == 0">\r\n                    <h4 style="text-align: center;margin: 12px;padding: 6px;"> No Attachment found....</h4>\r\n                </div>\r\n\r\n                <div class="col-xs-12 col-md-4" *ngIf="isClose">\r\n                    <mat-form-field>\r\n                        <textarea matInput placeholder="Reason for closing" [(ngModel)]="closeRemarks"></textarea>\r\n                    </mat-form-field>\r\n                </div>\r\n\r\n              <mat-action-row>\r\n                    \x3c!--<button mat-button class="org-btn" (click)="prevStep()">\r\n                Previous\r\n            </button>--\x3e\r\n                    <button *ngIf="isClose" mat-button class="blu-btn" (click)="ClosedPurchaseOrder()">\r\n                        Submit\r\n                    </button>\r\n                </mat-action-row>\r\n            </mat-expansion-panel>\r\n\r\n            <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">attachment</i></mat-icon>  Annexure Documents\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <div>\r\n                    <table class="itemRows-tble" *ngIf="PurchaseOrderAnnexureLineDeatils.length > 0">\r\n                        <tr>\r\n                            <th width="6%">Sr.No.</th>\r\n                            <th width="22%">Document Description</th>\r\n                            <th>Attachment</th>\r\n                        </tr>\r\n                        <tr *ngFor="let purchaseAnnexure of PurchaseOrderAnnexureLineDeatils; let i=index">\r\n                            <td>{{i+1}}</td>\r\n                            <td>{{purchaseAnnexure.documentDescription}}</td>\r\n                            <td>\r\n                                <button mat-icon-button class="smlBtn" (click)="downloadannexuredoc(purchaseAnnexure.purchaseOrderMasterId,purchaseAnnexure.employeeId)">\r\n                                    <i class="fa fa-floppy-o" aria-hidden="true"></i>&nbsp;  {{purchaseAnnexure.documentName}}\r\n                                </button>\r\n                            </td>\r\n                        </tr>\r\n                    </table>\r\n                </div>\r\n                <div class="row" *ngIf=" PurchaseOrderAnnexureLineDeatils.length == 0">\r\n                    <h4 style="text-align: center;margin: 12px;padding: 6px;">No Attachment found...</h4>\r\n                </div>\r\n            </mat-expansion-panel>\r\n            <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">check_circle_outline</i></mat-icon> Approval information\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <br />\r\n                <table class="itemRows-tble">\r\n                    <tr>\r\n                        <th>Approver name</th>\r\n                        <th>Role</th>\r\n                        <th>Status</th>\r\n                        <th>Approved date</th>\r\n                        <th>Remarks</th>\r\n                    </tr>\r\n                    <tr *ngFor="let element of approvalHeirarchyList;let i=index">\r\n                        <td>{{element.approverName}} </td>\r\n                        <td>{{element.role}}   (Level-{{i+1}})</td>\r\n                        <td>{{element.status}}</td>\r\n                        <td><span *ngIf="element.status != \'Pending\'">{{element.approvalDate * 1000 | date:\'dd MMM yyy hh:mm a\'}}</span></td>\r\n\r\n                        \x3c!--<td>{{element.status==\'Pending\'?"": _timesheetService.getFormattedDate(element.approvedDate)}}</td>--\x3e\r\n                        <td>{{element.remarks}}</td>\r\n                    </tr>\r\n                </table>\r\n                <br />\r\n                \x3c!--<div class="col-md-12" *ngIf="isPendingPO == 0">\r\n            <div class="col-xs-12 col-md-4">\r\n                <mat-form-field>\r\n                    <textarea matInput placeholder="Remarks" [(ngModel)]="txtRemarks" rows="2" cols="5" required></textarea>\r\n                </mat-form-field>\r\n            </div>\r\n\r\n        </div>--\x3e\r\n                \x3c!--<mat-action-row *ngIf="isPendingPO == 0">\r\n            <button mat-button class="status-btn" (click)="UpdatePOStatus(0,\'edit PO\',0)"> <i class="fa fa-undo" aria-hidden="true"></i> &nbsp;Edit PO</button>\r\n\r\n            <button mat-button class="status-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(1,\'redraft with approval\',2)"> <i class="fa fa-undo" aria-hidden="true"></i> &nbsp;Redraft WA</button>\r\n            <button mat-button class="status-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(1,\'redraft without approval\',3)"> <i class="fa fa-undo" aria-hidden="true"></i> &nbsp;Redraft WOA</button>\r\n\r\n            <button mat-button class="reject-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(-1,\'reject\',0)"> <i class="fa fa-times" aria-hidden="true"></i> &nbsp;Reject</button>\r\n            <button mat-button class="approve-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(1,\'approve\',0)"><i class="fa fa-check" aria-hidden="true"></i> &nbsp; Approve</button>\r\n\r\n\r\n\r\n        </mat-action-row>--\x3e\r\n                \x3c!--<mat-action-row>\r\n\r\n            <button mat-button class="blu-btn" (click)="nextStep()">Next</button>\r\n        </mat-action-row>--\x3e\r\n            </mat-expansion-panel>\r\n\r\n\r\n        </div>\r\n    </mat-card-content>\r\n\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>\r\n'},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,".col-xs-12.col-md-3 {\r\n    /*margin: 12px 0;*/\r\n}\r\n\r\n.contractPO-header mat-panel-title .material-icons {\r\n    margin-right: 12px\r\n}\r\n.addressitemRowsBlock, .registrationitemRowsBlock, .bankitemRowsBlock, .insurenceitemRowsBlock {\r\n    border: 1px solid #d3d3d3;\r\n    margin: 8px;\r\n    padding: 8px;\r\n}\r\n\r\n.addbtnArea {\r\n    text-align: right;\r\n    color: #696363;\r\n}\r\n\r\n.delbtn-area {\r\n    text-align: right;\r\n    color: #696363;\r\n}\r\n\r\n.attachmentDetails {\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n}\r\n\r\n    .attachmentDetails td, .attachmentDetails th {\r\n        border: 1px solid #ddd;\r\n        text-align: center;\r\n        /*font-size: 12px;*/\r\n    }\r\n\r\n    .attachmentDetails th {\r\n        padding: 6px;\r\n    }\r\n\r\n    .attachmentDetails tr:nth-child(even) {\r\n        background-color: #f2f2f2;\r\n    }\r\n\r\n    .attachmentDetails tr:hover {\r\n        background-color: #ddd;\r\n    }\r\n\r\n    .attachmentDetails th {\r\n        background-color: #0e7ddc;\r\n        color: white;\r\n    }\r\n\r\nbutton.btnGray.blueHov.mat-raised-button {\r\n    float: right;\r\n    background: #595c5d;\r\n    color: #fff;\r\n    min-width: 2px;\r\n    margin: 12px 0;\r\n    padding: 3px 6px;\r\n    line-height: 1;\r\n}\r\n\r\n.attachmentDetails input[type=file] {\r\n    display: inline-block;\r\n}\r\n\r\n.attachmentLble {\r\n    /*font-size: 12px;*/\r\n    font-weight: 100;\r\n}\r\n\r\n.col-xs-12.reuestItems {\r\n    width: 12%;\r\n}\r\n\r\n    .col-xs-12.reuestItems.Desc {\r\n        width: 9%;\r\n    }\r\n\r\n    .col-xs-12.reuestItems .mat-form-field {\r\n        width: 100%;\r\n    }\r\n\r\n    .col-xs-12.reuestItems.Prefer {\r\n        width: 14%;\r\n    }\r\n\r\n    .col-xs-12.reuestItems.Qty {\r\n        width: 6%;\r\n    }\r\n\r\n    .col-xs-12.reuestItems.UOM {\r\n        width: 7%;\r\n    }\r\n\r\n    .col-xs-12.reuestItems.tenure {\r\n        width: 7%;\r\n    }\r\n\r\n    .col-xs-12.reuestItems.unitrate {\r\n        width: 8%;\r\n    }\r\n\r\n    .col-xs-12.reuestItems.totamt {\r\n        width: 10%;\r\n    }\r\n\r\nh4.count_head {\r\n    color: #e8730f;\r\n    font-weight: bold;\r\n}\r\n\r\n.rowRight .mat-form-field {\r\n    width: 100%;\r\n}\r\n\r\n.rowRight {\r\n    float: right;\r\n    width: 41%;\r\n}\r\n\r\nbutton.btnDel {\r\n    height: 28px;\r\n    line-height: 1;\r\n    color: #6d6b6b;\r\n    width: 28px;\r\n}\r\n.requestitemRowsBlock {\r\n    border: 1px solid #d3d3d3;\r\n    padding: 18px;\r\n}\r\n\r\n.totamt-area {\r\n    margin: 12px 0;\r\n    padding: 12px 5px;\r\n    background-color: #dedede;\r\n    display: inline-block;\r\n    width: 100%;\r\n}\r\n.totamt-area label {\r\n    margin: 0 12px 0px 0px;\r\n    float: right;\r\n    display: inline-block;\r\n}\r\n\r\n.TripTble {\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n    border: 1px solid #ddd;\r\n}\r\n\r\n    .TripTble tr:nth-child(even) {\r\n        background-color: #f2f2f2;\r\n    }\r\n\r\n    .TripTble td, .TripTble th {\r\n        border-top: 1px solid #dcdcdc;\r\n        text-align: center;\r\n        padding: 6px;\r\n        /*font-size: 12px;*/\r\n    }\r\n\r\n    .TripTble th {\r\n        background-color: #0c85b3;\r\n        color: white;\r\n    }\r\n\r\n.attachmentDetails {\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n}\r\n\r\n    .attachmentDetails td, .attachmentDetails th {\r\n        border: 1px solid #ddd;\r\n        text-align: center;\r\n        /*font-size: 12px;*/\r\n        padding: 5px 0;\r\n    }\r\n\r\n    .attachmentDetails th {\r\n        padding: 6px;\r\n    }\r\n\r\n    .attachmentDetails tr:nth-child(even) {\r\n        background-color: #f2f2f2;\r\n    }\r\n\r\n    .attachmentDetails tr:hover {\r\n        background-color: #ddd;\r\n    }\r\n\r\n    .attachmentDetails th {\r\n        background-color: #0e7ddc;\r\n        color: white;\r\n    }\r\n.contractPO-header .row {\r\n    /*font-size: 12px;*/\r\n    margin: 4px 0;\r\n}\r\nspan.expoBtn {\r\n    display: inline-block;\r\n    text-align: right;\r\n    width: 64%;\r\n}\r\nbutton.status-btn {\r\n    background: #ffce91;\r\n}\r\n.prd-item-div {\r\n    background: #e6e6e6;\r\n    padding: 7px;\r\n}\r\nlabel.prd-item-lble {\r\n    margin: 0;\r\n    color: #333;\r\n    font-size: 13px;\r\n}\r\n\r\n.product_listrows {\r\n    border: 1px solid #dedede;\r\n    padding: 5px;\r\n    margin: 2px 0;\r\n}\r\n\r\n.vendor-block .col-xs-12.col-md-4, .vendor-block .col-xs-12.col-md-6 {\r\n    padding: 0;\r\n}\r\nmat-expansion-panel ::ng-deep  .mat-expansion-panel-body {\r\n    /*font-size: 12px;*/\r\n}",""])},function(e,t){e.exports='<mat-card [@routerTransition]>\r\n    <mat-card-title><h4 class="SubHead">Purchase Order List</h4></mat-card-title>\r\n    <mat-card-content>\r\n        <div class="tableListViewHeader">\r\n            <div class="LftPaginationArea">\r\n                <ul class="pagination">\r\n                    <li class="page-item">\r\n                        <button mat-button class="repNav" [disabled]="pageNumber == 1" (click)="previousPage()"\r\n                                aria-label="Previous">\r\n                            <mat-icon>navigate_before</mat-icon>\r\n                        </button>\r\n                    </li>\r\n                    <li>\r\n                        <select class="form-control" style="height:30px;"\r\n                                [(ngModel)]="pageSize" (change)="changePageData($event.target.value)">\r\n                            <option value="200">200</option>\r\n                            <option value="500">500</option>\r\n                            <option value="1000">1000</option>\r\n                        </select>\r\n                    </li>\r\n                    <li class="page-item">\r\n                        <button class="repNav" mat-button (click)="nextPage()" aria-label="Next">\r\n                            <mat-icon>navigate_next</mat-icon>\r\n                        </button>\r\n                    </li>\r\n                    <li class="page-item">\r\n                        <span style="font-weight:500;">Current Page : {{pageNumber}}</span>\r\n                    </li>\r\n\r\n                </ul>\r\n               \r\n            </div>\r\n            <div class="LftPaginationArea">\r\n                <label style="color:#fff; vertical-align: text-bottom;margin-bottom: 10px; "> Total : {{TotalRecords}}</label>\r\n            </div>\r\n            <div class="RitFilterArea">\r\n                \x3c!--<mat-form-field>\r\n        <input matInput (keyup)="search($event.target.value)" placeholder="Filter">\r\n    </mat-form-field>--\x3e\r\n                <mat-form-field matColumnDef="entityClass">\r\n                    <mat-select placeholder="PO Location" (change)="LoadPOBasedOnEntity($event.value)" [(ngModel)]="tenantId">\r\n                        <mat-option value="{{entity.id}}" *ngFor="let entity of EntityList"> {{entity.tenantName}}  </mat-option>\r\n                    </mat-select>\r\n                </mat-form-field>\r\n                <mat-form-field>\r\n                    <mat-select placeholder="Status" (change)="LoadPOBasedOnStatus($event.value)" [(ngModel)]="poStatus">\r\n                        <mat-option [value]="\'NA\'">All</mat-option>\r\n                        <mat-option [value]="\'Draft\'">Draft</mat-option>\r\n                        <mat-option [value]="\'Pending With Level 1\'">Pending With Level 1</mat-option>\r\n                        <mat-option [value]="\'Pending With Level 2\'">Pending With Level 2</mat-option>\r\n                        <mat-option [value]="\'Pending With Level 3\'">Pending With Level 3</mat-option>\r\n                        <mat-option [value]="\'Pending With Level 4\'">Pending With Level 4</mat-option>\r\n\r\n                        <mat-option [value]="\'Approved\'">Approved</mat-option>\r\n                        <mat-option [value]="\'Rejected\'">Rejected</mat-option>\r\n                    </mat-select>\r\n                </mat-form-field>\r\n                <mat-form-field>\r\n                    <input matInput (keyup)="onEnterKeyPress($event)" placeholder="Filter" [(ngModel)]="filterValue">\r\n                </mat-form-field>\r\n                <button mat-icon-button class="searchAction-button" (click)="applyFilter(filterValue)" matTooltip="Search">\r\n                    <i class="fa fa-search" style="color: white;"></i>\r\n                </button>\r\n            </div>\r\n        </div>\r\n        <div class="PR-list-container mat-elevation-z8">\r\n\r\n            <mat-table #table [dataSource]="dataSource" matSort matSortDirection="asc" *ngIf="dataSource?.filteredData.length">\r\n\r\n                <ng-container matColumnDef="poNumber">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> PO Number </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element" matTooltip="View Details">\r\n                        <a (click)="onPODetailClickPopup(element)">{{element.purchaseOrderNumber}}</a>\r\n                    </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="requester">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Requester Name </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.fullname}} </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="poLocation">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header>PO Location </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.poLocationValue}} </mat-cell>\r\n                </ng-container>\r\n                \x3c!-- client Column --\x3e\r\n                <ng-container matColumnDef="vendorCompany">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Supplier </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.vendorCompanyName}} </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="totalAmount">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header class="poAmount">Total Amount </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element" style="text-align:right;flex:0 9%">\r\n                        {{\r\n                     element.poCurrency == \'INR\'?\r\n                    (element.totalPOAmount.toLocaleString(\'en-IN\', { style: \'currency\', currency: \'INR\', maximumFractionDigits: 2})):\r\n                    element.poCurrency == \'USD\'?(element.totalPOAmount | currency):\r\n                    element.poCurrency == \'NPR\'?\r\n                     (element.totalPOAmount.toLocaleString(\'en-NP\', { style: \'currency\', currency: \'NPR\', maximumFractionDigits: 2 })) :\r\n                    element.totalPOAmount\r\n                        }}\r\n                    </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="deliveryDate">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Delivery Date </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.deliveryDate | date:\'dd MMM yyy\'}} </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="poDate">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> PO Date </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.poDate | date:\'dd MMM yyy\'}} </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="poStartDate">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> PO Start Date</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.poStartdate != \'0001-01-01T00:00:00\' ?(element.poStartdate | date:\'dd MMM yyy\'):\'NA\'}} </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- sbu Column --\x3e\r\n                <ng-container matColumnDef="poEndDate">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> PO End Date </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element" style="text-align:center;"> {{element.poEnddate != \'0001-01-01T00:00:00\' ?(element.poEnddate | date:\'dd MMM yyy\'):\'NA\'}} </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="billAddress">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header>Ship To Address</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.billAddress}} </mat-cell>\r\n                </ng-container>\r\n                <ng-container matColumnDef="PRNumber">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header>PR No.</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.purchaseRequestType}} </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="poStatus">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header>Status</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.purchaseOrderStatusValue}} </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="redraftRemarks">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header>Re-Draft Remarks</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.redraftRemarks}} </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="closedRemarks">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header>Closed Remarks</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.poClosedRemarks}} </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="action">\r\n                    <mat-header-cell *matHeaderCellDef> Action </mat-header-cell>\r\n                    <mat-cell *matCellDef="let row">\r\n                        <button style="width:22px;" class="btnIcon" mat-icon-button type="button" matTooltip="View Details" (click)="onPODetailClick(row,\'view\')">\r\n                            <i class="fa fa-share-square-o" aria-hidden="true"></i>\r\n                        </button>\r\n                        <button style="width:22px;" *ngIf="(row.purchaseOrderStatus>0) && !row.isPOClosed" type="button" mat-icon-button class="btnIcon" matTooltip="Close Purchase Order"\r\n                                (click)="onPODetailClick(row,\'close\')">\r\n                            <i class="fa fa-close" aria-hidden="true"></i>\r\n                        </button>\r\n                        <button style="width: 22px;" *ngIf="row.isSignatureSigned" mat-icon-button type="button" matTooltip="Share Email" class="btnIcon" (click)="openPOEmailDialog(row)">\r\n                            <i class="fa fa-envelope" aria-hidden="true"></i>\r\n                        </button>\r\n\r\n                        <button style="width:22px;" *ngIf="row.isSignatureSigned" type="button" mat-icon-button class="btnIcon" matTooltip="view Attachment" (click)="viewFile(row)">\r\n                            <i class="fa fa-check" aria-hidden="true"></i>\r\n                        </button>\r\n                    </mat-cell>\r\n\r\n                </ng-container>\r\n                \x3c!--&& !row.isAmmendmentCreated--\x3e\r\n\r\n                <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                <mat-row *matRowDef="let row; columns: displayedColumns;" (contextmenu)="onRightClick($event, row)"></mat-row>\r\n\r\n                \x3c!--<ng-container matColumnDef="reDraftRemarks">\r\n            <mat-header-cell *matHeaderCellDef mat-sort-header>Re-Draft Remarks </mat-header-cell>\r\n            <mat-cell *matCellDef="let element"> {{element.redraftRemarks}} </mat-cell>\r\n        </ng-container>--\x3e\r\n                \x3c!-- action Column --\x3e\r\n                \x3c!--.purchaseOrderMasterId,element.purchaseRequestType, element.purchaseOrderStatus,element.accountManagerStatus,element.financeManagerStatus--\x3e\r\n                \x3c!--<ng-container matColumnDef="action">\r\n            <mat-header-cell *matHeaderCellDef class="action-colms"> Action </mat-header-cell>\r\n            <mat-cell *matCellDef="let element" class="action-colms">\r\n                <button type="button" mat-icon-button class="btnGray" (click)="onPODetailClick(element)"\r\n                        matTooltip="View">\r\n                    <i class="fa fa-search" aria-hidden="true"></i>\r\n                </button>\r\n\r\n\r\n            </mat-cell>\r\n        </ng-container>--\x3e\r\n                \x3c!--<button *ngIf="element.purchaseRequestType == \'Consultant\' && element.purchaseOrderStatusValue == \'Approved\'" type="button" mat-icon-button class="btnGray" (click)="onUpdatePODetailClick(element.purchaseOrderMasterId,element.purchaseRequestType, element.purchaseOrderStatus)"\r\n                matTooltip="Update Funding">\r\n            <i class="fa fa-edit" aria-hidden="true"></i>\r\n        </button>--\x3e\r\n\r\n            </mat-table>\r\n\r\n            <div *ngIf="contextMenuVisible"\r\n                 [ngStyle]="{ top: contextMenuPosition.y, left: contextMenuPosition.x }"\r\n                 class="custom-context-menu">\r\n                <div (click)="openPOInNewTab()" class="tab-section">\r\n                    View <strong>{{selectedRow?.purchaseOrderNumber}}</strong> in new tab\r\n                </div>\r\n                \x3c!--<mat-divider></mat-divider>\r\n                <div class="tab-section" (click)="viewPODetails()">\r\n                    Open PO in new tab\r\n                </div>--\x3e\r\n            </div>\r\n\r\n            <div *ngIf="dataSource?.filteredData.length === 0  && tenantId">\r\n                <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n            </div>\r\n\r\n            <div *ngIf="!tenantId">\r\n                <h4 style="text-align: center;padding: 12px;margin: 12px;">Please select Entity to load the list !!</h4>\r\n            </div>\r\n\r\n        </div>\r\n    </mat-card-content>\r\n\r\n</mat-card>\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>\r\n'},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,"\r\n.mat-column-vendordescription {\r\n    padding: 12px 14px;\r\n}\r\nbutton.btnGray {\r\n    line-height: 1;\r\n    padding: 2PX;\r\n    height: 27px;\r\n    width: 27px;\r\n}\r\nmat-cell.totlAMt{\r\n    text-align:right;\r\n}\r\n.action-colms {\r\n    flex: 0 0 5%;\r\n}\r\n\r\n.RitFilterArea .mat-form-field{\r\n    width:20%;\r\n}\r\n.RitFilterArea .entityClass {\r\n    width: 30%;\r\n}\r\n\r\n/*.RitFilterArea{\r\n    width:65%;\r\n    position:absolute;\r\n    padding:10px 0;\r\n}*/\r\n.mat-paginator-range-actions {\r\n    min-height: 0px;\r\n}\r\n.LftPaginationArea {\r\n    margin-top: 10px;\r\n}\r\n\r\n    .LftPaginationArea .pagination {\r\n        margin: 4px 0;\r\n    }\r\n\r\n        .LftPaginationArea .pagination > li {\r\n            display: inline;\r\n            float: left;\r\n        }\r\n\r\n        .LftPaginationArea .pagination li.page-item mat-icon {\r\n            color: #fff;\r\n        }\r\n\r\n.RitFilterArea {\r\n    float: right !important;\r\n    width: 65% !important;\r\n    height: 45px;\r\n    margin-right: 20px !important;\r\n    margin-top: 10px !important;\r\n}\r\n.poAmount {\r\n    flex: 0 9%;\r\n}\r\n\r\n/*Dialog CSS*/\r\n\r\n.modules-container {\r\n    padding: 10px;\r\n}\r\n\r\n.close-icon:hover {\r\n    color: red;\r\n}\r\n\r\n.button-container{\r\n    text-align: right;\r\n    margin-top: 15px;\r\n}\r\n\r\n.button-container button{\r\n    font-size: 11px;\r\n}\r\n\r\n/*Dialog CSS*/\r\n\r\n.custom-context-menu {\r\n    position: fixed;\r\n    background: white;\r\n    border: 1px solid #ccc;\r\n    cursor: pointer;\r\n    z-index: 1000;\r\n    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);\r\n    border-radius: 8px;\r\n}\r\n\r\n.tab-section {\r\n    padding: 10px;\r\n    font-size: 12px;\r\n}\r\n\r\n    .tab-section:hover {\r\n        background-color: #f0f0f0;\r\n        border-radius: 8px;\r\n    }",""])},function(e,t){e.exports='<div class="modules-container">\r\n    <mat-card-title class="popup-title">\r\n        <h4 class="SubHead" style="border-bottom-color: black;">\r\n            <span style="color: black; font-size: 16px;">Share Email</span>\r\n            <button class="spgeBack close-icon" [mat-dialog-close] matTooltip="Close" style="background: none; border: none; cursor: pointer; float: right;">\r\n                <i class="fa fa-times-circle fa-lg" aria-hidden="true"></i>\r\n            </button>\r\n        </h4>\r\n    </mat-card-title>\r\n\r\n    <form [formGroup]="poShareEmailForm">\r\n        <div class="row">\r\n            <div class="col-xs-12 col-md-4">\r\n                <mat-form-field appearance="outline">\r\n                    <input matInput placeholder="Vendor" type="text" readonly formControlName="vendorName" [value]="poShareEmailForm.get(\'vendorName\').value"/>\r\n\r\n                </mat-form-field>\r\n            </div>\r\n\r\n            <div class="col-xs-12 col-md-4">\r\n                <mat-form-field appearance="outline">\r\n                    <input matInput placeholder="Vendor Email ID" type="email" formControlName="vendorEmail" required />\r\n                </mat-form-field>\r\n            </div>\r\n\r\n            <div class="col-xs-12 col-md-4">\r\n                \x3c!--<mat-form-field appearance="outline">\r\n                    <input matInput placeholder="PO Signed Copy as PDF" formControlName="poSignedPDF" (click)="downloadAttachmentFile()" />\r\n                </mat-form-field>--\x3e\r\n                <label style="font-size:10px;margin: 0;font-weight: normal;color: #333;">PO Signed Copy as PDF</label>\r\n                <a style="display: inline-block;font-size: 10px; color: #00adff;" (click)="downloadAttachmentFile()">{{ poShareEmailForm.value.poSignedPDF}}</a>\r\n            </div>\r\n        </div>\r\n\r\n        <div class="row">\r\n            <div class="col-xs-12 col-md-12">\r\n                    <label style="font-weight: normal; font-size: 11px;">Mail Body</label>\r\n                    <textarea class="cust-validation" autocomplete="off" formControlName="poShareEmail" style="min-height:90px; width:100%; font-size: 11px;"></textarea>\r\n            </div>\r\n        </div>\r\n    </form>\r\n\r\n    <div class="button-container">\r\n        <button mat-raised-button type="button" class="org-btn" (click)="onNoClick()">\r\n            <i class="fa fa-times" aria-hidden="true" style="padding-right: 4px;"></i>Cancel\r\n        </button>\r\n        <button mat-raised-button type="submit" class="blu-btn" (click)="onShareEmailSubmit(poShareEmailForm)">\r\n            <i class="fa fa-envelope" aria-hidden="true"  style="padding-right: 4px;"></i>Send Email\r\n        </button>\r\n    </div>\r\n</div>'},function(e,t){e.exports='<mat-card [@routerTransition]>\r\n    <mat-card-title>\r\n        <h4 class="SubHead">\r\n            Purchase Order - {{purchaseOrderConsultantDetailsById?.purchaseOrderNo}}\r\n            <span class="spgeBack">\r\n                <a class="pgeBack" (click)="backClick()"><mat-icon><i class="material-icons">arrow_back_ios</i></mat-icon>Back</a>\r\n            </span>\r\n        </h4>\r\n    </mat-card-title>\r\n    <mat-card-content>\r\n        <div class="vendor-block">\r\n            <employee-information *ngIf="RequesterEmployeeUID != 0" [InputEmployeeNumber]="RequesterEmployeeUID"></employee-information>\r\n            \x3c!--<mat-accordion class="contractPO-header">--\x3e\r\n            \x3c!-- Approval information --\x3e\r\n            <mat-expansion-panel [expanded]="allExpandState">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">check_circle_outline</i></mat-icon> Approval information\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n                <br />\r\n                <table class="itemRows-tble">\r\n                    <tr>\r\n                        <th>Approver name</th>\r\n                        <th>Role</th>\r\n                        <th>Status</th>\r\n                        <th>Approved date</th>\r\n                        <th>Remarks</th>\r\n                    </tr>\r\n                    <tr *ngFor="let element of approvalHeirarchyList;let i=index">\r\n                        <td>{{element.approverName}} </td>\r\n                        <td>{{element.role}}   (Level-{{i+1}})</td>\r\n                        <td>{{element.status}}</td>\r\n                        <td><span *ngIf="element.status != \'Pending\'">{{element.approvalDate * 1000 | date:\'dd MMM yyy hh:mm a\'}}</span></td>\r\n                        <td>{{element.remarks}}</td>\r\n                    </tr>\r\n                </table>\r\n                <br />\r\n                <div class="row" *ngIf="isPendingPO == 0">\r\n                    <div class="col-xs-12 col-md-4">\r\n                        <mat-form-field>\r\n                            <textarea matInput placeholder="Remarks" [(ngModel)]="txtRemarks" rows="2" cols="5" required></textarea>\r\n                        </mat-form-field>\r\n                    </div>\r\n\r\n                </div>\r\n                <mat-action-row *ngIf="isPendingPO == 0">\r\n                    <button mat-button class="status-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(2,\'redraft with approval\',2)"> <i class="fa fa-undo" aria-hidden="true"></i> &nbsp;Redraft</button>\r\n                    <button mat-button class="reject-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(-1,\'reject\',0)"> <i class="fa fa-undo" aria-hidden="true"></i> &nbsp;Reject</button>\r\n\r\n                    <button mat-button class="approve-btn" [disabled]="(txtRemarks==null||txtRemarks==\'\')" (click)="UpdatePOStatus(1,\'approve\',0)"><i class="fa fa-send-o" aria-hidden="true"></i> &nbsp; Approve</button>\r\n                </mat-action-row>\r\n                \x3c!--<mat-action-row>\r\n\r\n            <button mat-button class="blu-btn" (click)="nextStep()">Next</button>\r\n        </mat-action-row>--\x3e\r\n            </mat-expansion-panel>\r\n            \x3c!-- Approval information --\x3e\r\n            <mat-expansion-panel [expanded]="allExpandState" (opened)="panelOpenState = true">\r\n                <mat-expansion-panel-header>\r\n                    <mat-panel-title>\r\n                        <mat-icon><i class="material-icons">import_contacts</i></mat-icon>  Contract PO  Details\r\n                    </mat-panel-title>\r\n                </mat-expansion-panel-header>\r\n\r\n                <div class="row">\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Entity</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{EntityName}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Purchase Requests</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span style="color: #5691da;cursor: pointer;" (click)="openPRDetailsDialog(prNumber)">{{prNumber}}</span>\r\n                            \x3c!--<span>{{prNumber}}</span>--\x3e\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Vendor</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{vendorCompanyName}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Vendor Address</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{vendorAddress}}</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class="row">\r\n\r\n\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>Required Delivery Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{requiredDeliveryDate | date:\'dd MMM yyy\'}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Currency</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poCurrency}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Start Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poStartDate | date:\'dd MMM yyy\'}}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO End Date</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poEndDate | date:\'dd MMM yyy\'}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n\r\n                </div>\r\n\r\n                <div class="row">\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <div class="col-xs-12 col-md-4">\r\n                            <label>PO Location</label>\r\n                        </div>\r\n                        <div class="col-xs-12 col-md-8">\r\n                            <span>{{poLocation}}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <