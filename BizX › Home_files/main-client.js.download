arch" style="color: white;"></i>\r\n                    </button>\r\n                </div>\r\n            </div>\r\n            <div class="recutritment-container mat-elevation-z8">\r\n                <mat-table [dataSource]="dataSource" matSort class="approvalLists">\r\n\r\n                    \x3c!-- RM Name Column ---\x3e\r\n                    <ng-container matColumnDef="RinNo">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> RIN No. </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element">{{element.rinNo}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- Year Column --\x3e\r\n                    <ng-container matColumnDef="BRREQNO">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> BR REQ No. </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.brReqId}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- Monmat-header-cell Column --\x3e\r\n                    <ng-container matColumnDef="CandidateID">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Candidate ID </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.candidateMasterId}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- Client Column --\x3e\r\n                    <ng-container matColumnDef="CandidateName">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Candidate Full Name </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- Project Column --\x3e\r\n                    <ng-container matColumnDef="CandidateEmailID">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Candidate Email ID </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.emailId}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- DOJ Column --\x3e\r\n                    <ng-container matColumnDef="doj">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Date of Joining </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.dateOfJoing}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- RM No. Column --\x3e\r\n                    <ng-container matColumnDef="rmNo">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Reporting Manager Name.</mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.rmName}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- Job Code Column --\x3e\r\n                    <ng-container matColumnDef="jobCode">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header>Job Code</mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.jobCode}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- BU Column --\x3e\r\n                    <ng-container matColumnDef="bu">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Business Unit </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.bu}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- Project Column --\x3e\r\n                    <ng-container matColumnDef="project">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Project </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.project}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- Action Column --\x3e\r\n            