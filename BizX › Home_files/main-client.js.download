 color: #fff;\r\n    }\r\n\r\n    .LftapplyLeavePaginator ::ng-deep .mat-paginator-decrement, .LftapplyLeavePaginator ::ng-deep .mat-paginator-increment {\r\n        border-top: 2px solid #fff;\r\n        border-right: 2px solid #fff;\r\n    }\r\n\r\n::ng-deep .LftapplyLeavePaginator .mat-select-arrow {\r\n    color: #fff;\r\n}\r\n\r\n::ng-deep .LftapplyLeavePaginator .mat-form-field-underline {\r\n    background-color: #fff;\r\n}\r\n\r\n::ng-deep .mat-paginator .mat-paginator-range-actions {\r\n    min-height: 40px;\r\n}\r\n.infiEmpDoc .col-md-3.doc-name {\r\n    width: 23%;\r\n}\r\n    .infiEmpDoc .col-md-3.doc-name mat-form-field {\r\n        width: 85%;\r\n    }\r\n.infiEmpDoc .col-xs-4.col-md-2.add-btn-div {\r\n    padding: 1.5% 0;\r\n}\r\n.infiEmpDoc.addItem-list{\r\n    padding:0;\r\n}\r\n.addresssize {\r\n    width: 210px\r\n}\r\n\r\n.mat-column-RinNo{\r\n    flex:0 0 85px;\r\n}\r\n\r\n.mat-column-CandisateMasterId {\r\n    flex: 0 0 125px;\r\n}\r\n\r\n.mat-column-DocumentType {\r\n    flex: 0 0 145px;\r\n}\r\n\r\n.mat-column-Action {\r\n    flex: 0 0 85px;\r\n}\r\ntd.actin-td ,th.actin-td {\r\n    padding: 3px;\r\n}\r\nbutton.tble-cls {\r\n    width: 25px;\r\n    height: 25px;\r\n    line-height: 25px !important;\r\n}\r\nth.actin-td {\r\n    width: 65px;\r\n}\r\ndiv.pipBLock mat-form-field {\r\n    width:100%;\r\n}\r\n\r\n.hidden-file-input {\r\n    display: none;\r\n}\r\n\r\n.file-list {\r\n    list-style: none;\r\n    padding: 0;\r\n    margin-top: 10px;\r\n    width: 49%;\r\n}\r\n\r\n.remove-btn {\r\n    background: transparent;\r\n    border: none;\r\n    color: #d32f2f;\r\n    font-size: 13px;\r\n    cursor: pointer;\r\n    margin-left: 10px;\r\n}\r\n\r\n.download-btn {\r\n    background: transparent;\r\n    border: none;\r\n    font-size: 13px;\r\n    cursor: pointer;\r\n}\r\n\r\n.remove-btn:hover {\r\n    color: #b71c1c;\r\n}\r\n\r\n\r\n.leave-radio-label{\r\n    display: block;\r\n}\r\n\r\n.leave-radio-group{\r\n    display: inline-flex;\r\n    gap: 20px;\r\n}\r\n\r\nbutton.tsViewCloseBtn {\r\n    min-width: 2px;\r\n    float: right;\r\n    line-height: 0;\r\n    padding: 4px;\r\n}\r\n\r\n.upload-container{\r\n    font-size: 11px;\r\n}\r\n\r\n.file-row {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    margin-bottom: 6px;\r\n}\r\n\r\n.file-name {\r\n    flex: 1;\r\n    overflow: hidden;\r\n    text-overflow: ellipsis;\r\n    white-space: nowrap;\r\n    background-color: #e8e8e8;\r\n    padding: 3px;\r\n    border-radius: 4px;\r\n}\r\n\r\n.file-actions button {\r\n    margin-left: 6px;\r\n}\r\n\r\n.dialogBtn{\r\n    font-size: 11px;\r\n}",""])},function(e,t){e.exports='\r\n<div class="upload-container">\r\n    <h4 class="SubHead">\r\n        Upload Documents\r\n        <button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn"><i class="fa fa-times" aria-hidden="true"></i>&nbsp;</button>\r\n    </h4>\r\n\r\n    <div class="row" *ngIf="USLeaveDetailsForm">\r\n        <div class="col-xs-12 col-md-9" style="margin-top: 15px;" [formGroup]="USLeaveDetailsForm">\r\n            <label>Upload Documents</label>\r\n            \x3c!-- hidden input --\x3e\r\n            <input type="file"\r\n                   multiple\r\n                   (change)="onFileSelected($event)"\r\n                   #fileInput\r\n                   class="hidden-file-input" />\r\n            \x3c!-- custom button --\x3e\r\n            <button mat-raised-button style="display: block; font-size: 11px;" color="primary" type="button" (click)="fileInput.click()">\r\n                Choose Files\r\n            </button>\r\n            <mat-hint>Each file must be equal to or less than 4 MB in size. You can upload up to 4 files.</mat-hint>\r\n            <div *ngIf="isLoadingResults" class="spinner-wrapper">\r\n                <mat-spinner diameter="30"></mat-spinner>\r\n            </div>\r\n            <div class="file-list" *ngIf="allFiles.length > 0">\r\n                <div class="file-row" *ngFor="let file of allFiles; let i = index">\r\n                    \x3c!--<span class="file-name" title="{{file.name}}">{{ formatFileName(file.name) }}</span>--\x3e\r\n                    <span class="file-name" title="{{ file.name }}">\r\n                        {{ formatFileName(file.name) }}\r\n                    </span>\r\n\r\n                    <div class="file-actions">\r\n                        \x3c!--<button type="button" class="download-btn" (click)="downloadFile(file)" matTooltip="Download Document">\r\n                    <i class="fa fa-download" aria-hidden="true"></i>\r\n                </button>--\x3e\r\n                        <button type="button"\r\n                                class="download-btn"\r\n                                (click)="file.isNew ? downloadFile(file.file) : downloadBase64File(file.name, file.base64)"\r\n                                matTooltip="Download Document">\r\n                            <i class="fa fa-download" aria-hidden="true"></i>\r\n                        </button>\r\n                        <button type="button" class="remove-btn" (click)="removeFile(i)" matTooltip="Delete Document">\r\n                            <i class="fa fa-trash-o" aria-hidden="true"></i>\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=" col-xs-12 col-md-3 btn-groups center-align" style="margin-top:35px;">\r\n            <button mat-button class="bluBtn blu-btn dialogBtn" type="submit" (click)="submitAttachments()">\r\n                <i class="fa fa-send-o" aria-hidden="true"></i> &nbsp;Submit\r\n            </button>\r\n        </div>\r\n    </div>\r\n</div>'},function(e,t){e.exports='<mat-card [@routerTransition]>\r\n    <div class="loading-shade"\r\n         *ngIf="isLoadingResults">\r\n        <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n    </div>\r\n    <mat-card-title><h4 class="SubHead">Employee List</h4></mat-card-title>\r\n    <mat-card-content>\r\n        <div class="tableListViewHeader">\r\n            <div class="LftPaginationArea">\r\n                \x3c!--<mat-paginator [pageSizeOptions]="[25, 50, 100, 150]" [pageSize]="25" [length]="100" (page)="pageEvent = handlePage($event)"></mat-paginator>--\x3e\r\n                <ul class="pagination">\r\n                    <li class="page-item">\r\n                        <button mat-button class="repNav" [disabled]="pageNumber == 1" (click)="previousPage()"\r\n                                aria-label="Previous">\r\n                            <mat-icon>navigate_before</mat-icon>\r\n                        </button>\r\n                    </li>\r\n                    <li>\r\n                        <select class="form-control" style="height:30px;"\r\n                                [(ngModel)]="pageSize" (change)="changePageData($event.target.value)">\r\n                            <option value="100">100</option>\r\n                            <option value="150">150</option>\r\n                            <option value="200">200</option>\r\n                            <option value="500">500</option>\r\n                        </select>\r\n                    </li>\r\n                    <li class="page-item">\r\n                        <button class="repNav" mat-button (click)="nextPage()" aria-label="Next">\r\n                            <mat-icon>navigate_next</mat-icon>\r\n                        </button>\r\n                    </li>\r\n                    <li class="page-item">\r\n                        <span style="font-weight:500;">Current Page : - {{pageNumber}}</span>\r\n                    </li>\r\n                </ul>\r\n            </div>\r\n            <div class="RitFilterArea">\r\n                <mat-form-field>\r\n                    <mat-select placeholder="Select Status" (change)="loadEmployeeListData(tenantId,employeeStatus)"\r\n                                [(ngModel)]="employeeStatus">\r\n                        <mat-option value="active">Active</mat-option>\r\n                        <mat-option value="terminated">In-Active</mat-option>\r\n                        \x3c!--<mat-option value="All">All</mat-option>--\x3e\r\n                    </mat-select>\r\n                </mat-form-field>\r\n\r\n                <mat-form-field>\r\n                    <input matInput (keyup)="applyFilter($event.target.value)" [(ngModel)]="searchKey" placeholder="type min 3 charactors to filter">\r\n                </mat-form-field>\r\n\r\n                <mat-form-field>\r\n                    <mat-select placeholder="Select Entity" (change)="changeTenant($event.value,employeeStatus)"\r\n                                [(ngModel)]="tenantId">\r\n                        <mat-option value="{{tn.id}}" *ngFor="let tn of activeTenants"> {{tn.tenantName}}  </mat-option>\r\n                    </mat-select>\r\n                </mat-form-field>\r\n                <button mat-icon-button class="smlBtn" matTooltip="Upload Employee HR data" *ngIf="isAccess"\r\n                        (click)="UploadExcelHRList()">\r\n                    <i class="fa fa-file-excel-o"></i>\r\n                </button>\r\n\r\n            </div>\r\n        </div>\r\n        <div class="vendor-list-container mat-elevation-z8">\r\n\r\n\r\n            <mat-table #table [dataSource]="dataSource" matSort *ngIf="IsTenantSelected">\r\n\r\n                \x3c!-- employeeNo Column --\x3e\r\n                <ng-container matColumnDef="employeeNo">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Id </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.EmployeeNo}} </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- fullName Column --\x3e\r\n                <ng-container matColumnDef="fullName">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Name </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.FullName}} </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- reportingManager Column --\x3e\r\n                <ng-container matColumnDef="reportingManager">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Reporting Manager </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.ReportingManagerName}} </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- bu Column --\x3e\r\n                <ng-container matColumnDef="buName">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Business Unit </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.BUName}} </mat-cell>\r\n                </ng-container>\r\n\r\n\r\n                <ng-container matColumnDef="doj">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Date Of Join</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.DateOfJoining}} </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- client Column --\x3e\r\n                <ng-container matColumnDef="immigrationStatus">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Immigration Status</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.ImmigrationStatus}} </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- action Column --\x3e\r\n                <ng-container matColumnDef="action">\r\n                    <mat-header-cell *matHeaderCellDef class="action-colm"> Action </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element" class="action-colm">\r\n                        <button type="button" mat-icon-button class="btnGray" matTooltip="View" (click)="UpdateImmigrationStatus(element)"><i class="fa fa-search" aria-hidden="true"></i></button>\r\n                    </mat-cell>\r\n                </ng-container>\r\n\r\n                <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                <mat-row class="sclick" *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n            </mat-table>\r\n\r\n            <div *ngIf="dataSource.data.length === 0 && IsTenantSelected">\r\n                <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n            </div>\r\n            <div *ngIf="!IsTenantSelected">\r\n                <h4 style="text-align: center;padding: 12px;margin: 12px;">\r\n                    <ng-container *ngIf="tenantId > 0">Please wait, while we are loading the data for already selected entity !!</ng-container>\r\n                    <ng-container *ngIf="tenantId == 0">Please select Entity to load the list !!</ng-container>\r\n                </h4>\r\n            </div>\r\n\r\n        </div>\r\n    </mat-card-content>\r\n</mat-card>\r\n'},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,"\r\n\r\n.mat-column-vendordescription {\r\n    padding: 12px 14px;\r\n}\r\n\r\n.LftPaginationArea {\r\n    margin-top: 10px;\r\n}\r\n\r\n    .LftPaginationArea .pagination {\r\n        margin: 4px 0;\r\n    }\r\n\r\n        .LftPaginationArea .pagination > li {\r\n            display: inline;\r\n            float: left;\r\n        }\r\n\r\n        .LftPaginationArea .pagination li.page-item mat-icon {\r\n            color: #fff;\r\n        }\r\n\r\n.RitFilterArea {\r\n    float: right !important;\r\n    width: 47% !important;\r\n    margin-right: 20px !important;\r\n    margin-top: 10px !important;\r\n}\r\n\r\n.imgStatus {\r\n    width: 37%;\r\n}\r\n\r\n.tsViewCloseBtn {\r\n    float: right;\r\n    background: #d3d3d3;\r\n    min-width: 21px;\r\n    padding: 4px;\r\n    line-height: 1;\r\n}\r\n\r\nbutton.btnIcon.tsViewCloseBtn.mat-button {\r\n    background: #62a19a;\r\n    margin: 2px 0;\r\n    color: #fff;\r\n}\r\n\r\nbutton.upld-btn.mat-button {\r\n    background: #189588;\r\n    color: #fff;\r\n}\r\n\r\n.col-xs-12.col-md-12.ation-btn {\r\n    text-align: right;\r\n    margin: 12px 0;\r\n}\r\n\r\nbutton.btnIcon.cncle-btn.mat-button {\r\n    background: #4b7672;\r\n    color: #fff;\r\n}\r\n\r\n.upld-tile {\r\n    border-bottom: 1px solid;\r\n    padding: 6px;\r\n    color: #4b7672;\r\n}\r\n.normalpadding {\r\n    padding: 10px 0;\r\n   font-size:11px;\r\n}\r\n.imgStatusBtn {\r\n    padding: 6px;\r\n    min-width: 72px;\r\n    line-height: 12px;\r\n}",""])},function(e,t){e.exports='<style>\r\n    .tableListViewHeader .mat-paginator {\r\n        display: inline;\r\n    }\r\n\r\n    .btnIcon.tsViewCloseBtn {\r\n        min-width: 2px;\r\n        float: right;\r\n        line-height: 0;\r\n        padding: 4px;\r\n    }\r\n</style>\r\n\r\n<h4 class="SubHead">Immigration Status<button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn"><i class="fa fa-times" aria-hidden="true"></i>&nbsp;</button></h4>\r\n\r\n\r\n<div class="row">\r\n    <div class="col-xs-12 col-md-3 normalpadding">\r\n        <div class="col-xs-12 col-md-6">\r\n            <label>Employee No</label>\r\n        </div>\r\n        <div class="col-xs-12 col-md-5">\r\n            <span>{{EmployeeNo}}</span>\r\n        </div>\r\n    </div>\r\n    <div class="col-xs-12 col-md-4 normalpadding">\r\n        <div class="col-xs-12 col-md-5">\r\n            <label>Employee Name</label>\r\n        </div>\r\n        <div class="col-xs-12 col-md-7">\r\n            <span>{{EmployeeName}}</span>\r\n        </div>\r\n    </div>\r\n    <div class="col-xs-12 col-md-5">\r\n        <mat-form-field class="imgStatus">\r\n            <mat-select placeholder="Immigration Status" [(ngModel)]="Immigration">\r\n                <mat-option *ngFor="let fil of ImmigrationStatusLists" [value]="fil">{{fil}}</mat-option>\r\n            </mat-select>\r\n        </mat-form-field>\r\n\r\n        <button mat-button class="org-btn imgStatusBtn" (click)="UpdateImmigrationStatus(EmpIdentityForm)">Submit</button>\r\n    </div>\r\n\r\n\r\n</div>\r\n\r\n\r\n<mat-card-content>\r\n    \r\n\r\n    <div class="tableListViewHeader">\r\n        <div class="LftPaginationArea">\r\n            \x3c!--<mat-paginator [pageSizeOptions]="[25, 50, 100, 150]" [pageSize]="25" [length]="100" (page)="pageEvent = handlePage($event)"></mat-paginator>--\x3e\r\n            <ul class="pagination">\r\n                <li class="page-item">\r\n                    <button mat-button class="repNav" [disabled]="pageNumber == 1" (click)="previousPage()"\r\n                            aria-label="Previous">\r\n                        <mat-icon>navigate_before</mat-icon>\r\n                    </button>\r\n                </li>\r\n                <li>\r\n                    <select class="form-control" style="height:30px;"\r\n                            [(ngModel)]="pageSize" (change)="changePageData($event.target.value)">\r\n                        <option value="10">10</option>\r\n                        <option value="25">25</option>\r\n                        <option value="50">50</option>\r\n                        <option value="100">100</option>\r\n                    </select>\r\n                </li>\r\n                <li class="page-item">\r\n                    <button class="repNav" mat-button (click)="nextPage()" aria-label="Next">\r\n                        <mat-icon>navigate_next</mat-icon>\r\n                    </button>\r\n                </li>\r\n                <li class="page-item">\r\n                    <span style="font-weight:500;">Current Page : - {{pageNumber}}</span>\r\n                </li>\r\n            </ul>\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <div class="project-list mat-elevation-z8">\r\n        <mat-table #table [dataSource]="dataSource" matSort matSortDisableClear matSortDirection="asc" *ngIf="dataSource?.filteredData.length">\r\n\r\n            \x3c!-- empid Column --\x3e\r\n            <ng-container matColumnDef="employeeNo">\r\n                <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Id </mat-header-cell>\r\n                <mat-cell *matCellDef="let element">\r\n                    <a (click)="employeeDetails(element.uid)">{{element.EmployeeNo}}</a>\r\n                </mat-cell>\r\n            </ng-container>\r\n\r\n            \x3c!-- empname Column --\x3e\r\n            <ng-container matColumnDef="empname">\r\n                <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Name </mat-header-cell>\r\n                <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n            </ng-container>\r\n\r\n            \x3c!-- projectname Column --\x3e\r\n            <ng-container matColumnDef="ImmigrationStatus">\r\n                <mat-header-cell *matHeaderCellDef mat-sort-header> Immigration Status</mat-header-cell>\r\n                <mat-cell *matCellDef="let element"> {{element.ImmigrationStatus}} </mat-cell>\r\n            </ng-container>\r\n\r\n            <ng-container matColumnDef="ModifiedBy">\r\n                <mat-header-cell *matHeaderCellDef mat-sort-header> Modified By</mat-header-cell>\r\n                <mat-cell *matCellDef="let element"> {{element.ModifiedBy}} </mat-cell>\r\n            </ng-container>\r\n            <ng-container matColumnDef="ModifiedOn">\r\n                <mat-header-cell *matHeaderCellDef mat-sort-header> Modified On</mat-header-cell>\r\n                <mat-cell *matCellDef="let element"> {{element.ModifiedOn}} </mat-cell>\r\n            </ng-container>\r\n\r\n            \x3c!-- track Column --\x3e\r\n\r\n\r\n            <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n            <mat-row *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n        </mat-table>\r\n        <div *ngIf="!dataSource?.filteredData.length">\r\n            <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No  Data Found...</h4>\r\n        </div>\r\n    </div>\r\n</mat-card-content>\r\n\r\n\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>'},function(e,t){e.exports='<style>\r\n    .tableListViewHeader .mat-paginator {\r\n        display: inline;\r\n    }\r\n    .btnIcon.tsViewCloseBtn {\r\n        min-width: 2px;\r\n        float: right;\r\n        line-height: 0;\r\n        padding: 4px;\r\n    }\r\n</style>\r\n    <mat-card-title><h4 class="SubHead">{{name}} Reportee Details<button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn" ><i class="fa fa-times" aria-hidden="true"></i>&nbsp;</button></h4></mat-card-title>\r\n    <mat-card-content>\r\n        <div class="tableListViewHeader">\r\n            <div class="LftPaginationArea">\r\n                \x3c!--<mat-paginator [pageSizeOptions]="[10, 25, 50, 100]"></mat-paginator>--\x3e\r\n                <ul class="pagination form-inline">\r\n                    <li class="page-item" style="text-align:center;">\r\n                        <button mat-button class="repNav" [disabled]="PageNumber == 1" (click)="previousPage()"\r\n                                aria-label="Previous" style="vertical-align: middle">\r\n                            <mat-icon style="vertical-align: middle">navigate_before</mat-icon>\r\n                        </button>\r\n                    </li>\r\n                    <li class="page-item" style="text-align:center;">\r\n                        <select class="form-control" style="height:29px; vertical-align:middle;"\r\n                                [(ngModel)]="PageSize" (change)="changePageData($event.target.value)">\r\n                            <option value="10">10</option>\r\n                            <option value="25">25</option>\r\n                            <option value="50">50</option>\r\n                            <option value="100">100</option>\r\n                        </select>\r\n                    </li>\r\n                    <li class="page-item" style="text-align:center;">\r\n                        <button class="repNav" mat-button (click)="nextPage()" aria-label="Next" style="vertical-align: middle">\r\n                            <mat-icon style="vertical-align: middle">navigate_next</mat-icon>\r\n                        </button>\r\n                    </li>\r\n                    <li class="page-item" style="text-align:center;">\r\n                        <span style="float:revert;border-bottom-left-radius:5px;border-bottom-right-radius:5px;border-top-left-radius:5px;border-top-right-radius:5px;height:29px; vertical-align:middle;">Current Page: {{PageNumber}}</span>\r\n                    </li>\r\n                </ul>\r\n            </div>\r\n            <div class="RitFilterArea">\r\n                <mat-form-field>\r\n                    <input matInput (keyup)="applyFilter($event.target.value)" placeholder="Filter">\r\n                </mat-form-field>\r\n\r\n            </div>\r\n        </div>\r\n        \r\n        <div class="project-list mat-elevation-z8">\r\n            <mat-table #table [dataSource]="dataSource" matSort matSortDisableClear matSortDirection="asc" *ngIf="dataSource?.filteredData.length">\r\n\r\n                \x3c!-- empid Column --\x3e\r\n                <ng-container matColumnDef="employeeNo">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Id </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element">\r\n                        <a (click)="employeeDetails(element.uid)">{{element.employeeNo}}</a>\r\n                    </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- empname Column --\x3e\r\n                <ng-container matColumnDef="empname">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Name </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- projectname Column --\x3e\r\n                <ng-container matColumnDef="projectname">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Project Name</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.projectName}} </mat-cell>\r\n                </ng-container>\r\n\r\n                <ng-container matColumnDef="employeeType">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Type</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.employeeType}} </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- track Column --\x3e\r\n                <ng-container matColumnDef="allocationStartDate">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header>Allocation Start Date </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.allocationStartDate}} </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- subtrack Column --\x3e\r\n                <ng-container matColumnDef="allocationEndDate">\r\n                    <mat-header-cell *matHeaderCellDef mat-sort-header> Allocation End Date</mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.allocationEndDate}} </mat-cell>\r\n                </ng-container>\r\n\r\n                \x3c!-- billing_type Column --\x3e\r\n                <ng-container matColumnDef="billingType">\r\n                    <mat-header-cell *matHeaderCellDef> Billing Type </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element"> {{element.billableType}} </mat-cell>\r\n                </ng-container>\r\n                \x3c!-- action Column --\x3e\r\n\r\n                <ng-container matColumnDef="action">\r\n                    <mat-header-cell *matHeaderCellDef> Action </mat-header-cell>\r\n                    <mat-cell *matCellDef="let element">\r\n\r\n                        <button class="btnIcon" mat-icon-button type="button" matTooltip="View Reportee deatils" *ngIf="(element.isManager==1)" (click)="employeeReporteedeatils(element.uid,element.id,element.fullName)">\r\n                            <i class="fa fa-user-circle" aria-hidden="true"></i>\r\n                        </button>\r\n\r\n                    </mat-cell>\r\n                </ng-container>\r\n\r\n                <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                <mat-row *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n            </mat-table>\r\n            <div *ngIf="!dataSource?.filteredData.length">\r\n                <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Reportee\'s Data Found...</h4>\r\n            </div>\r\n        </div>\r\n    </mat-card-content>\r\n\r\n\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>'},function(e,t){e.exports='<mat-card [@routerTransition]>\r\n    <mat-card-title><h4 class="SubHead">My Team Project Dashboard</h4></mat-card-title>\r\n    <mat-card-content>\r\n        <div class="tableListViewHeader">\r\n            <div class="LftPaginationArea" style="display:inline-flex;">\r\n                \x3c!--<mat-paginator [pageSizeOptions]="[10, 25, 50, 100]"></mat-paginator>--\x3e\r\n                <ul class="pagination form-inline">\r\n                    <li class="page-item" style="text-align:center;">\r\n                        <button mat-button class="repNav" [disabled]="PageNumber == 1" (click)="previousPage()"\r\n                                aria-label="Previous" style="vertical-align: middle">\r\n                            <mat-icon style="vertical-align: middle">navigate_before</mat-icon>\r\n                        </button>\r\n                    </li>\r\n                    <li class="page-item" style="text-align:center;">\r\n                        <select class="form-control" style="height:29px; vertical-align:middle;"\r\n                                [(ngModel)]="PageSize" (change)="changePageData($event.target.value)">\r\n                            <option value="100">100</option>\r\n                            <option value="250">250</option>\r\n                            <option value="500">500</option>\r\n                            <option value="1000">1000</option>\r\n                        </select>\r\n                    </li>\r\n                    <li class="page-item" style="text-align:center;">\r\n                        <button class="repNav" mat-button (click)="nextPage()" aria-label="Next" style="vertical-align: middle">\r\n                            <mat-icon style="vertical-align: middle">navigate_next</mat-icon>\r\n                        </button>\r\n                    </li>\r\n                    <li class="page-item" style="text-align:center;">\r\n                        <span style="border-bottom-left-radius:5px;border-bottom-right-radius:5px;border-top-left-radius:5px;border-top-right-radius:5px;height:29px; vertical-align:middle;">Current Page: {{PageNumber}}</span>\r\n                    </li>                    \r\n                </ul>                \r\n                  <label style="color:#fff; align-content:center; margin-left:10px;" *ngIf="TotalReportees != 0"> Total Reportees : {{TotalReportees}}</label>\r\n            </div>\r\n\r\n            <div class="RitFilterArea">\r\n                <mat-form-field>\r\n                    <input matInput (keyup)="onEnterKeyPress($event)" [(ngModel)]="FilterString" placeholder="Filter">\r\n                </mat-form-field>\r\n                <button mat-icon-button class="searchAction-button" (click)="applyFilter(FilterString)" matTooltip="Search">\r\n                    <i class="fa fa-search" style="color: white;"></i>\r\n                </button>\r\n                <button mat-icon-button class="smlBtn" matTooltip="Export to excel"\r\n                        (click)="Excel()" *ngIf="dataSource.data.length!==0">\r\n                    <i class="fa fa-file-excel-o"></i>\r\n                </button>\r\n                \x3c!--<button mat-button class="btnBulkDshPge" matTooltip="Bulk Movement" *ngIf="dataSource.data.length==0"\r\n            (click)="TeamBulkMovement()">\r\n        <i class="fa fa-check" aria-hidden="true"></i> Bulk Movement\r\n    </button>--\x3e\r\n\r\n            </div>\r\n        </div>\r\n        <div class="project-list mat-elevation-z8">\r\n            <form [formGroup]="teamDetailForm">\r\n                <mat-table #table [dataSource]="dataSource" matSort matSortDisableClear matSortDirection="asc" *ngIf="dataSource?.filteredData.length">\r\n                    \x3c!--Check box--\x3e\r\n\r\n                    \x3c!--<ng-container matColumnDef="select">\r\n                        <mat-header-cell showCoulmn showInput="!none" *matHeaderCellDef class="cbHeaderColm">\r\n                            <mat-checkbox (change)="$event ? masterToggle() : null"\r\n                                          [checked]="selection.hasValue() && isEntirePageSelected()"\r\n                                          [indeterminate]="selection.hasValue() && !isEntirePageSelected()"\r\n                                          [aria-label]="checkboxLabel()">\r\n                            </mat-checkbox>\r\n                        </mat-header-cell>\r\n                        <mat-cell showCoulmn showInput="\'!none" *matCellDef="let row" class="cbBdyColm">\r\n                            <mat-checkbox (click)="$event.stopPropagation()"\r\n                                          (change)="$event ? selection.toggle(row) : null"\r\n                                          [checked]="selection.isSelected(row)">\r\n                            </mat-checkbox>\r\n                        </mat-cell>\r\n                    </ng-container>--\x3e\r\n\r\n                    \x3c!-- empid Column --\x3e\r\n                    <ng-container matColumnDef="employeeNo">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Id </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element">\r\n                            <a (click)="employeeDetails(element.uid,element.entityDisplayName)">{{element.employeeNo}}</a>\r\n                        </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- empname Column --\x3e\r\n                    <ng-container matColumnDef="fullName">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Name </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.fullName}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- projectname Column --\x3e\r\n                    <ng-container matColumnDef="projectName">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Project Name</mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.projectName}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    <ng-container matColumnDef="employeeType">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Employee Type</mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.employeeType}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- track Column --\x3e\r\n                    <ng-container matColumnDef="allocationStartDate">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header>Allocation Start Date </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.allocationStartDate}} </mat-cell>\r\n                    </ng-container>\r\n\r\n                    \x3c!-- subtrack Column --\x3e\r\n                    <ng-container matColumnDef="allocationEndDate">\r\n                        <mat-header-cell *matHeaderCellDef mat-sort-header> Allocation End Date</mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.allocationEndDate}} </mat-cell>\r\n                    </ng-container>\r\n                    \x3c!--<ng-container matColumnDef="role">\r\n        <mat-header-cell *matHeaderCellDef> Role </mat-header-cell>\r\n        <mat-cell *matCellDef="let element"> {{element.role==null?\'Development\':element.role}} </mat-cell>\r\n    </ng-container>--\x3e\r\n                    \x3c!-- billing_type Column --\x3e\r\n                    <ng-container matColumnDef="billing_type">\r\n                        <mat-header-cell *matHeaderCellDef> Billing Type </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element"> {{element.billableType}} </mat-cell>\r\n                    </ng-container>\r\n                    \x3c!-- action Column --\x3e\r\n                    <ng-container matColumnDef="action">\r\n                        <mat-header-cell *matHeaderCellDef> Action </mat-header-cell>\r\n                        <mat-cell *matCellDef="let element">\r\n                            <button class="btnIcon" mat-icon-button type="button" matTooltip="Movement" (click)="employeeMovement(element.uid,element.id,element.employeeMovementMasterId)">\r\n                                <i class="fa fa-share-square-o" aria-hidden="true"></i>\r\n                            </button>\r\n                            <button class="btnIcon" mat-icon-button type="button" matTooltip="Allocation" (click)="projectAllocation(element.uid,element.id)">\r\n                                <i class="fa fa-check-square-o" aria-hidden="true"></i>\r\n                            </button>\r\n                            <button class="btnIcon" mat-icon-button type="button" matTooltip="Absconding" *ngIf="(element.entityShortname == \'IN\')" (click)="abscondingInitiation(element)">\r\n                                <i class="fa fa-user-times" aria-hidden="true"></i>\r\n                            </button>\r\n\r\n                            <button class="btnIcon" mat-icon-button type="button" matTooltip="View Reportee details" *ngIf="(element.isManager==1)" (click)="employeeReporteedeatils(element.uid,element.id,element.fullName)">\r\n                                <i class="fa fa-user-circle" aria-hidden="true"></i>\r\n                            </button>\r\n                            \x3c!--<button class="btnIcon" mat-icon-button type="button" matTooltip="WorK Model" *ngIf="(element.entityShortname == \'IN\')" (click)="OnWFHinputclick(element.uid)">\r\n                                <i class="fa fa-home" aria-hidden="true"></i>\r\n                            </button>--\x3e\r\n                            <button class="btnIcon" mat-icon-button type="button" matTooltip="Corp Pool Movement" *ngIf="(element.entityShortname == \'IN\')" (click)="CorpPoolInitiation(element)">\r\n                                <i class="fa fa-users" aria-hidden="true"></i>\r\n                            </button>\r\n                        </mat-cell>\r\n                    </ng-container>\r\n\r\n                    <mat-header-row *matHeaderRowDef="displayedColumns"></mat-header-row>\r\n                    <mat-row *matRowDef="let row; columns: displayedColumns;"></mat-row>\r\n                </mat-table>\r\n                <div *ngIf="!dataSource?.filteredData.length">\r\n                    <h4 style="text-align: center;margin: 12px;padding: 12px;display: inline-block;width: 98%;">No Data Found...</h4>\r\n                </div>\r\n            </form>\r\n        </div>\r\n    </mat-card-content>\r\n\r\n</mat-card>\r\n<div class="loading-shade"\r\n     *ngIf="isLoadingResults">\r\n    <mat-spinner *ngIf="isLoadingResults"></mat-spinner>\r\n</div>'},function(e,t,n){var r=n(1095);e.exports="string"==typeof r?r:r.toString()},function(e,t,n){(e.exports=n(10)(void 0)).push([e.i,"\r\n.mat-column-vendordescription {\r\n    padding: 12px 14px;\r\n}\r\n/*.project-list mat-row.mat-row {\r\n    padding: 15px;\r\n    margin: 8px;\r\n    border: 1px solid #cac6c6;\r\n}\r\n.pro*/ject-list .mat-table {\r\n    display: inline-block;\r\n    width: 100%;\r\n}\r\nbutton.btnIcon {\r\n    line-height: 1;\r\n    padding: 0;\r\n    height: 20px;\r\n    width: 23px;\r\n}\r\n.cbBdyColm {\r\n    flex: 0 0 48px;\r\n}\r\n\r\n.cbHeaderColm {\r\n    flex: 0 0 48px;\r\n}",""])},function(e,t){e.exports='<style>\r\n    .row.srDetailsArea .col-sm-12.col-md-3 {\r\n        width: 20%;\r\n        font-size: 11px;\r\n        padding: 0;\r\n    }\r\n\r\n    .close-btn {\r\n        padding: 4px;\r\n        height: 32px;\r\n        line-height: 1;\r\n        font-size: 11px;\r\n    }\r\n    h2.dialoghead {\r\n        color: #e85b09;\r\n    }\r\n</style>\r\n<h2 mat-dialog-title class="dialoghead">Employee Movement - New Client/Department Information</h2>\r\n<form [formGroup]="employeeMovementForm" autocomplete="off">\r\n    <mat-dialog-content class="mat-typography">\r\n        <div class="allocationDetails">\r\n            <div class="row">\r\n                <div class="col-xs-12 col-md-3">\r\n                    <mat-form-field>\r\n                        <mat-select placeholder="Movement Type" formControlName="movementtype" #h (change)="movementChnage(h.value)" required>\r\n                            <mat-option *ngFor="let c of movementType" [value]="c.value">{{ c.key }}</mat-option>\r\n                        </mat-select>\r\n                    </mat-form-field>\r\n                </div>\r\n                <div class="col-xs-12 col-md-3">\r\n                    <ng-container *ngIf="selectedValue==0">\r\n                        <mat-form-field>\r\n                            <input matInput placeholder="Client/Department" [readonly]="true" />\r\n                        </mat-form-field>\r\n                    </ng-container>\r\n                    <ng-container *ngIf="selectedValue==1">\r\n                        <mat-form-field>\r\n                            <mat-select placeholder="Client/Department" required formControlName="clientdepartment" #t (change)="clientChange(t.value)">\r\n                                <mat-option *ngFor="let c of clientList" [value]="c.id">\r\n                                    {{c.clientName}}\r\n                                </mat-option>\r\n                            </mat-select>\r\n                        </mat-form-field>\r\n                    </ng-container>\r\n                    <ng-container *ngIf="selectedValue==2">\r\n                        <mat-form-field>\r\n                            <input matInput placeholder="Client/Department" [readonly]="true" formControlName="clientdepartment" [ngModel]="ClientList.ClientName" (ngModelChange)="onChange($event)" required />\r\n                        </mat-form-field>\r\n                    </ng-container>\r\n                </div>\r\n                <div class="col-xs-12 col-md-3">\r\n                    <mat-form-field>\r\n                        <mat-select placeholder="New Project" formControlName="newproject" required #p (change)="projectChange(p.value)">\r\n                            <mat-option *ngFor="let c of projectList" [value]="c.id">\r\n                                {{c.projectName}}\r\n                            </mat-option>\r\n                        </mat-select>\r\n                    </mat-form-field>\r\n                </div>\r\n                <div class="col-xs-12 col-md-3">\r\n                    <mat-form-field>\r\n                        <input matInput placeholder="Reporting Manager" type="text" class="validate filter-input" formControlName="reportingmanager" [readonly]="editpageflag" [(ngModel)]="reportingmanager" (keyup)="filter(reportingmanager,1)" required>\r\n                        <button mat-button *ngIf="reportingmanager" matSuffix mat-icon-button aria-label="Clear" (click)="remove(1)">\r\n                            <mat-icon>close</mat-icon>\r\n                        </button>\r\n                    </mat-form-field>\r\n                    <div class="suggestions" *ngIf="filteredList1.length > 0">\r\n                        <ul>\r\n                            <li *ngFor="let item of filteredList1">\r\n                                <a (click)="select(item,1);">{{item.fullName}}-{{item.employeeNo}}</a>\r\n                            </li>\r\n                        </ul>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class="row">\r\n                <div class="col-xs-12 col-md-3">\r\n                    <mat-form-field>\r\n                        <input matInput placeholder="BU" readonly formControlName="bu">\r\n                    </mat-form-field>\r\n                </div>\r\n                <div class="col-xs-12 col-md-3">\r\n                    <mat-form-field>\r\n                        <input matInput placeholder="SBU" readonly formControlName="sbu">\r\n                    </mat-form-field>\r\n                </div>\r\n                <div class="col-xs-12 col-md-3">\r\n                    <mat-form-field>\r\n                        <input matInput [matDatepicker]="rdate" placeholder="Release Date" formControlName="rdate" required readonly>\x3c!--[min]="minDate"--\x3e\r\n                        <mat-datepicker-toggle matSuffix [for]="rdate"></mat-datepicker-toggle>\r\n                        <mat-datepicker #rdate></mat-datepicker>\r\n                    </mat-form-field>\r\n                </div>\r\n                <div class="col-xs-12 col-md-3">\r\n                    <mat-form-field>\r\n                        <input matInput placeholder="Requirement" formControlName="requirement">\r\n                    </mat-form-field>\r\n                </div>\r\n            </div>\r\n            \r\n        </div>\r\n    </mat-dialog-content>\r\n    <mat-dialog-actions align="end">\r\n        <button mat-button mat-dialog-close class="blu-btn" (click)="cancel()">Cancel</button>\r\n        <button mat-button class="org-btn" (click)="insertMovement(employeeMovementForm)">Submit</button>\r\n    </mat-dialog-actions>\r\n</form>\r\n'},function(e,t){e.exports='<style>\r\n    .tableListViewHeader .mat-paginator {\r\n        display: inline;\r\n    }\r\n    .btnIcon.tsViewCloseBtn {\r\n        min-width: 2px;\r\n        float: right;\r\n        line-height: 0;\r\n        padding: 4px;\r\n    }\r\n    .quli-list {\r\n        border: 1px solid #26c6da;\r\n        padding: 9px;\r\n        margin: 8px;\r\n    }\r\n    .rej-btn {\r\n        background: #ef5350;\r\n        color: #fff;\r\n    }\r\n    .inner-head {\r\n        background: #0c9aa9;\r\n        color: #ffffff;\r\n        padding: 8px;\r\n        font-size: 12px;\r\n    }\r\n</style>\r\n    <mat-card-title><h4 class="SubHead"><strong>Work Model Details</strong><button mat-button [mat-dialog-close]="true" class="btnIcon tsViewCloseBtn" ><i class="fa fa-times" aria-hidden="true"></i>&nbsp;</button></h4></mat-card-title>\r\n    <div>\r\n        <div class="WorkFromHomeRequest-block">\r\n\r\n            <form [formGroup]="WorkFromHomeRequestForm">\r\n                <div class="row">\r\n                    <div class="col-xs-12 col-md-3">\r\n                        <mat-form-field>\r\n                            <mat-select placeholder="Work Model" formControlName="workModelType"\r\n                                        [(required)]="WorkFromHomeRequestForm.get(\'workModelType\').errors !== null\r\n                                            && WorkFromHomeRequestForm.get(\'workModelType\').errors.required">\r\n                                <mat-option value="WFO">WFO</mat-option>\r\n                                <mat-option value="WFH">WFH</mat-option>\r